<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Bảng màu mặc định. AppThemeManager sẽ cập nhật các resource này khi chạy. -->
    <Color x:Key="PrimaryColor">#6D28D9</Color>
    <Color x:Key="PrimaryDarkColor">#5B21B6</Color>
    <Color x:Key="PrimarySoftColor">#EDE9FE</Color>
    <Color x:Key="PrimaryBorderColor">#C4B5FD</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>

    <Color x:Key="PageBackgroundColor">#F4F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F8FAFC</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>

    <Color x:Key="TextPrimaryColor">#1E293B</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="BorderColor">#D8E2EF</Color>
    <Color x:Key="DividerColor">#E2E8F0</Color>

    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="SuccessSoftColor">#F0FDF4</Color>
    <Color x:Key="SuccessBorderColor">#BBF7D0</Color>

    <Color x:Key="WarningColor">#C2410C</Color>
    <Color x:Key="WarningSoftColor">#FFF7ED</Color>
    <Color x:Key="WarningBorderColor">#FDBA74</Color>

    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="DangerSoftColor">#FEF2F2</Color>
    <Color x:Key="DangerBorderColor">#FCA5A5</Color>

    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="InfoSoftColor">#EFF6FF</Color>
    <Color x:Key="InfoBorderColor">#BFDBFE</Color>

    <Color x:Key="ShellBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ShellForegroundColor">#6D28D9</Color>
    <Color x:Key="ShellUnselectedColor">#64748B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#5B21B6" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E2EF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#BBF7D0" />

    <SolidColorBrush x:Key="WarningBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDBA74" />

    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FCA5A5" />

    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#BFDBFE" />

    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ShellForegroundBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="ShellUnselectedBrush" Color="#64748B" />

    <!-- Các key cũ được giữ lại để không phá style hoặc control chưa di chuyển. -->
    <Color x:Key="Primary">#6D28D9</Color>
    <Color x:Key="PrimaryDark">#5B21B6</Color>
    <Color x:Key="PrimaryDarkText">#1E293B</Color>
    <Color x:Key="Secondary">#EDE9FE</Color>
    <Color x:Key="SecondaryDarkText">#64748B</Color>
    <Color x:Key="Tertiary">#5B21B6</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#6D28D9</Color>
    <Color x:Key="MidnightBlue">#1E293B</Color>
    <Color x:Key="OffBlack">#0B1120</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="SecondaryBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="#5B21B6" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BlackBrush" Color="#000000" />
    <SolidColorBrush x:Key="Gray100Brush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="Gray200Brush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Gray300Brush" Color="#ACACAC" />
    <SolidColorBrush x:Key="Gray400Brush" Color="#919191" />
    <SolidColorBrush x:Key="Gray500Brush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Gray600Brush" Color="#404040" />
    <SolidColorBrush x:Key="Gray900Brush" Color="#212121" />
    <SolidColorBrush x:Key="Gray950Brush" Color="#141414" />

    <Style x:Key="ThemeCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="{OnPlatform Android=12, WinUI=14, Default=14}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{OnPlatform Android=12, WinUI=14, Default=14}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HardwareSectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="HardwareInfoNameStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HardwareInfoValueStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="HardwareDescriptionStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="HardwareDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="BackgroundColor" Value="{DynamicResource DividerColor}" />
    </Style>

    <Style x:Key="HardwareSectionStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <Style x:Key="ThemePrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
        <Setter Property="CornerRadius" Value="{OnPlatform Android=20, WinUI=10, Default=10}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style x:Key="ThemeSecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAltColor}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="{OnPlatform Android=20, WinUI=10, Default=10}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
</ResourceDictionary>
