    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackgroundColor}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ShellBackgroundColor}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ShellUnselectedColor}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ShellBackgroundColor}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ShellUnselectedColor}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource ShellBackgroundColor}" />
        <Setter Property="BarTextColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="IconColor" Value="{DynamicResource ShellForegroundColor}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource ShellBackgroundColor}" />
        <Setter Property="BarTextColor" Value="{DynamicResource ShellForegroundColor}" />
        <Setter Property="UnselectedTabColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="SelectedTabColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>



    <!-- Compact Android-style settings menu -->
    <Style x:Key="ThemeMenuRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="MinimumHeightRequest" Value="62" />
    </Style>

    <Style x:Key="ThemeMenuIconStyle" TargetType="Label">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="ThemeMenuTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
    </Style>

    <Style x:Key="ThemeMenuSummaryStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="ThemeMenuChevronStyle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
    </Style>

    <Style x:Key="AccentSwatchButtonStyle" TargetType="Button">
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumWidthRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
</ResourceDictionary>
