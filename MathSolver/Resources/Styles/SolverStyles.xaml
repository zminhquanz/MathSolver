<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls">

    <!-- Shared spacing and visual hierarchy for every tab in Giải toán. -->
    <Style x:Key="SolverContentStyle" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{DynamicResource Density.PagePadding}" />
        <Setter Property="Spacing" Value="{DynamicResource Density.Spacing}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="MaximumWidthRequest" Value="1320" />
        <Setter Property="WidthRequest" Value="{Binding Source={RelativeSource AncestorType={x:Type ScrollView}}, Path=Width, x:DataType='ScrollView'}" />
    </Style>

    <!-- Hero titles sit directly on the page backdrop; reading cards own their surfaces. -->
    <Style x:Key="SolverFixedHeaderStyle" TargetType="VerticalStackLayout">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="controls:SolverHeader.IsEnabled" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource Density.HeaderPadding}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="MaximumWidthRequest" Value="1320" />
        <Setter Property="WidthRequest" Value="{Binding Source={RelativeSource AncestorType={x:Type Grid}}, Path=Width, x:DataType='Grid'}" />
    </Style>

    <Style x:Key="SolverCompactHeaderTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{OnPlatform Android=18, Default=20}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="SolverActionBarStyle" TargetType="Border">
        <Setter Property="Padding" Value="{DynamicResource Density.ActionPadding}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="MaximumWidthRequest" Value="1320" />
        <Setter Property="WidthRequest" Value="{Binding Source={RelativeSource AncestorType={x:Type Grid}}, Path=Width, x:DataType='Grid'}" />
    </Style>

    <Style x:Key="SolverActionButtonsStyle" TargetType="Grid">
        <Setter Property="controls:AdaptiveColumns.MinimumColumnWidth" Value="140" />
        <Setter Property="controls:AdaptiveColumns.MaximumColumns" Value="2" />
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <Style x:Key="SolverFooterActionButtonsStyle" TargetType="Grid">
        <Setter Property="controls:SolverFooterActions.IsEnabled" Value="True" />
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="RowSpacing" Value="8" />
    </Style>

    <Style x:Key="SolverScrollableContentStyle" TargetType="VerticalStackLayout" BasedOn="{StaticResource SolverContentStyle}">
        <Setter Property="Padding" Value="{DynamicResource Density.ScrollPadding}" />
    </Style>

    <!-- Diagrams and plots get more room than ordinary reading/input pages. -->
    <Style x:Key="SolverWideContentStyle" TargetType="VerticalStackLayout" BasedOn="{StaticResource SolverContentStyle}">
        <Setter Property="MaximumWidthRequest" Value="1440" />
    </Style>

    <Style x:Key="SolverHeroStyle" TargetType="VerticalStackLayout">
        <Setter Property="Margin" Value="{OnPlatform Android='0,2,0,2', WinUI='0,4,0,4', Default='0,4,0,4'}" />
        <Setter Property="Spacing" Value="{OnPlatform Android=2, WinUI=3, Default=3}" />
    </Style>

    <Style x:Key="SolverHeroSymbolStyle" TargetType="Label">
        <Setter Property="controls:SolverHeader.Role" Value="Symbol" />
        <Setter Property="FontSize" Value="{OnPlatform Android=25, WinUI=30, Default=30}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource ContentAccentTextColor}" />
    </Style>

    <Style x:Key="SolverHeroTitleStyle" TargetType="Label">
        <Setter Property="controls:SolverHeader.Role" Value="Title" />
        <Setter Property="FontSize" Value="{OnPlatform Android=24, WinUI=30, Default=30}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
    </Style>

    <Style x:Key="SolverHeroSubtitleStyle" TargetType="Label">
        <Setter Property="controls:SolverHeader.Role" Value="Description" />
        <Setter Property="FontSize" Value="{OnPlatform Android=14, WinUI=17, Default=17}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextSecondaryColor}" />
    </Style>

    <Style x:Key="SolverCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{DynamicResource Density.CardPadding}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceColor}" />
        <Setter Property="Stroke" Value="{DynamicResource WallpaperBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{OnPlatform Android=14, WinUI=16, Default=16}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#33000000" Offset="0,2" Radius="8" Opacity="{OnPlatform Android=0.10, WinUI=0.08, Default=0.08}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SolverSectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{OnPlatform Android=16, WinUI=17, Default=17}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
    </Style>

    <Style x:Key="SolverChoiceButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource Density.ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Density.ButtonPadding}" />
        <Setter Property="CornerRadius" Value="{OnPlatform Android=20, WinUI=12, Default=12}" />
        <Setter Property="FontSize" Value="{OnPlatform Android=15, WinUI=16, Default=16}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Android Material button text sits a touch high with the app font.
         Apply a tiny content-only vertical correction specifically to the
         Integer/Decimal segmented controls; other SolverChoice buttons are
         intentionally left unchanged. -->
    <Style x:Key="SolverNumberTypeButtonStyle" TargetType="Button" BasedOn="{StaticResource SolverChoiceButtonStyle}">
        <Setter Property="Padding" Value="{DynamicResource Density.NumberTypePadding}" />
    </Style>

    <Style x:Key="SolverOperationButtonStyle" TargetType="Button" BasedOn="{StaticResource SolverChoiceButtonStyle}">
        <Setter Property="FontSize" Value="{OnPlatform Android=22, WinUI=24, Default=24}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceAltColor}" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
    </Style>

    <Style x:Key="SolverInputBorderStyle" TargetType="Border">
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource Density.ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Density.InputPadding}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperInputBackgroundColor}" />
        <Setter Property="Stroke" Value="{DynamicResource WallpaperBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SolverPrimaryActionStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource Density.ControlHeight}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="{OnPlatform Android=15, WinUI=16, Default=16}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <Style x:Key="SolverSecondaryActionStyle" TargetType="Button" BasedOn="{StaticResource SolverPrimaryActionStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceAltColor}" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
    </Style>

    <!-- Tinted actions remain distinguishable from pale wallpaper and cards. -->
    <Style x:Key="SolverOutlinedActionStyle" TargetType="Button" BasedOn="{StaticResource SolverPrimaryActionStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource PrimaryBorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryBorderColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Native color feedback animates the current palette without
                         replacing DynamicResource or selected/answer colors. -->
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoftColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource BorderColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
                            <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SolverSubTabButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource Density.ControlHeight}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="Padding" Value="{OnPlatform Android='7,8', WinUI='8,8', Default='8,8'}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceAltColor}" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource WallpaperBorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Android-only visual style for Material/DevCheck-like sub tabs. -->
    <Style x:Key="AndroidNativeSubTabButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource Density.ControlHeight}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.1" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource WallpaperTextSecondaryColor}" />
    </Style>
</ResourceDictionary>
