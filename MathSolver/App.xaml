<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MathSolver"
             x:Class="MathSolver.App">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                Giá trị mặc định cho Styles.xaml.
                AppFontManager sẽ thay resource này theo lựa chọn đã lưu.
            -->
            <x:String x:Key="AppFontFamily">OpenSansRegular</x:String>
            <x:String x:Key="AppFontDisplayName">Open Sans</x:String>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
