<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MathSolver.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MathSolver.Views"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="{DynamicResource ShellBackgroundColor}"
    Shell.ForegroundColor="{DynamicResource ShellForegroundColor}"
    Shell.TitleColor="{DynamicResource TextPrimaryColor}"
    Shell.UnselectedColor="{DynamicResource ShellUnselectedColor}"
    Title="Math Solver">

    <!--
        Thanh tiêu đề được chia thành hai vùng:
        - Tên ứng dụng bên trái.
        - TitleActionButtons bên phải để có thể thêm nhiều nút về sau.
    -->
    <Shell.TitleView>
        <Grid
            x:Name="ShellTitleRoot"
            Padding="{OnPlatform Android='4,0,2,0', WinUI='8,0,4,0', Default='8,0,4,0'}"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <BoxView
                x:Name="ShellTitleScrim"
                Grid.ColumnSpan="2"
                Margin="-40,-18,-40,-18"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="#66000000"
                InputTransparent="True"
                IsVisible="False"
                ZIndex="10" />

            <HorizontalStackLayout
                Grid.Column="0"
                ZIndex="20"
                Spacing="{OnPlatform Android=6, WinUI=8, Default=8}"
                HorizontalOptions="Start"
                VerticalOptions="Center">

                <Image
                    x:Name="AppBrandLogo"
                    AutomationId="AppBrandLogo"
                    Source="{AppThemeBinding Light=mathsolver_logo_small.png, Dark=mathsolver_logo_small_light.png}"
                    WidthRequest="{OnPlatform Android=22, WinUI=26, Default=26}"
                    HeightRequest="{OnPlatform Android=22, WinUI=26, Default=26}"
                    Aspect="AspectFit"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Biểu tượng Math Solver" />

                <Label
                    Text="Math Solver"
                    FontSize="{OnPlatform Android=18, WinUI=20, Default=20}"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center"
                    VerticalOptions="Center"
                    TextColor="{DynamicResource ShellForegroundColor}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout
                x:Name="TitleActionButtons"
                ZIndex="20"
                Grid.Column="1"
                Spacing="4"
                HorizontalOptions="End"
                VerticalOptions="Center">

                <Grid
                    x:Name="SettingsButtonHost"
                    WidthRequest="48"
                    HeightRequest="48"
                    VerticalOptions="Center">

                    <!-- Transparent hit target; the vector gear is rendered separately. -->
                    <ImageButton
                        x:Name="SettingsButton"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0"
                        BorderWidth="1"
                        CornerRadius="24"
                        SemanticProperties.Description="Mở cài đặt giao diện"
                        ToolTipProperties.Text="Cài đặt giao diện"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        BackgroundColor="Transparent"
                        Clicked="OnSettingsClicked" />

                    <controls:ThemedSvgPathIcon
                        x:Name="SettingsButtonIcon"
                        Data="{x:Static controls:SettingsDestinationIconPaths.Settings}"
                        WidthRequest="22"
                        Scale="0.833333"
                        HeightRequest="22"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <TabBar
        x:Name="MainTabBar"
        Shell.TabBarBackgroundColor="{DynamicResource ShellBackgroundColor}"
        Shell.TabBarForegroundColor="{DynamicResource ShellForegroundColor}"
        Shell.TabBarTitleColor="{DynamicResource ShellForegroundColor}"
        Shell.TabBarUnselectedColor="{DynamicResource ShellUnselectedColor}">

        <ShellContent
            x:Name="CalculationShellContent"
            Title="Giải toán"
            Route="CalculationPage"
            Icon="calculate.png"
            ContentTemplate="{DataTemplate views:CalculationPage}" />

        <ShellContent
            x:Name="MathPuzzleShellContent"
            Title="Toán đố"
            Route="MathPuzzlePage"
            Icon="quiz.png"
            ContentTemplate="{DataTemplate views:MathPuzzlePage}" />

        <ShellContent
            x:Name="FormulaShellContent"
            Title="Công thức"
            Route="FormulaPage"
            Icon="function.png"
            ContentTemplate="{DataTemplate views:FormulaPage}" />

        <ShellContent
            x:Name="MultiplicationShellContent"
            Title="Cửu chương"
            Route="MultiplicationTablePage"
            Icon="grid_on.png"
            ContentTemplate="{DataTemplate views:MultiplicationTablePage}" />
    </TabBar>
</Shell>
