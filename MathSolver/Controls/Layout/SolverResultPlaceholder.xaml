<?xml version="1.0" encoding="utf-8" ?>
<Border
    x:Class="MathSolver.Controls.SolverResultPlaceholder"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    Style="{StaticResource SolverCardStyle}">
    <VerticalStackLayout Spacing="8">
        <Label Text="{localization:Translate Solver.Results.Title}"
               Style="{StaticResource SolverSectionTitleStyle}"
               SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{localization:Translate Solver.Results.Empty}"
               FontSize="15" LineBreakMode="WordWrap"
               TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
    </VerticalStackLayout>
</Border>
