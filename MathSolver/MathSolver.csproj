<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../tools/msbuild/PdfSharpCore.props" />
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.30.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.30.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
  </ItemGroup>

  <!-- Rebuilt from LLamaSharp 0.30.0's exact llama.cpp revision with 16 KiB
       ELF/RELRO alignment. Upstream Android package binaries are 4 KiB-only.
       Keep both CPU ABIs and the optional KleidiAI variant synchronized. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="Platforms\Android\Native\llama\arm64-v8a\*.so" Abi="arm64-v8a" Condition="'$(RuntimeIdentifier)' != 'android-x64'" />
    <AndroidNativeLibrary Include="Platforms\Android\Native\llama\x86_64\*.so" Abi="x86_64" Condition="'$(RuntimeIdentifier)' != 'android-arm64'" />
    <MauiAsset Include="Platforms\Android\Native\llama\arm64-v8a\LICENSE*.txt" LogicalName="ThirdParty/AndroidCpu/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseLicensedIcons)' != 'false' and Exists('Resources/Fonts/Icons8Actions.ttf') and Exists('Services/Appearance/Icons8LicensedPaths.g.cs')">
    <Icons8AssetsEnabled>true</Icons8AssetsEnabled>
    <DefineConstants>$(DefineConstants);ICONS8_LICENSED_ASSETS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Note for MacCatalyst:
    The default runtime is maccatalyst-x64, except in Release config, in which case the default runtime is maccatalyst-x64;maccatalyst-arm64.
    When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
    The Mac App Store will not accept apps with only maccatalyst-arm64. -->

    <OutputType>Exe</OutputType>
    <RootNamespace>MathSolver</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationId>com.quanvu.mathsolver</ApplicationId>
    <ApplicationDisplayVersion>0.2.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <!-- Material 3 / Material You is enabled only for Android.
       Windows remains on the existing WinUI rendering and styles. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <UseMaterial3>true</UseMaterial3>
    <!-- Local Debug/Release device builds use the SDK development key.
         Supply AndroidKeyStore=true and signing properties for distribution. -->
    <AndroidKeyStore Condition="'$(AndroidKeyStore)' == ''">false</AndroidKeyStore>
    <AndroidApkSignerAdditionalArguments>--v2-signing-enabled true</AndroidApkSignerAdditionalArguments>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MATHSOLVER_ANDROID_RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Keep Mono JIT on Android Debug. SIMD execution is separately disabled
       by CalculationAccelerationManager; CPU capabilities remain detectable. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Debug'">
    <UseMonoRuntime>true</UseMonoRuntime>
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- SVG sources; MAUI generates platform PNG/ICO assets at build time. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Images\mathsolver_logo_light.svg" Color="#2563EB">
      <ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">0.65</ForegroundScale>
      <ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">0.9</ForegroundScale>
    </MauiIcon>
    <MauiSplashScreen Include="Resources\Splash\mathsolver_splash.svg" BaseSize="128,128" Color="#2563EB" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\ai_guide_stationery.png" BaseSize="192,128" Resize="True" />
    <MauiImage Update="Resources\Images\review_empty_tray.png;Resources\Images\pdf_blank_sheet.png;Resources\Images\excel_template_sheet.png;Resources\Images\excel_fill_sheet.png;Resources\Images\excel_review_sheet.png" BaseSize="180,120" Resize="True" />
    <MauiImage Update="Resources\Images\excel_motion_sheet.png;Resources\Images\excel_motion_pencil.png" BaseSize="180,120" Resize="True" />
    <MauiFont Include="Resources\Fonts\*" />
    <EmbeddedResource Include="Resources\Fonts\OpenSans-Regular.ttf" LogicalName="QuizPdf.Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\OpenSans-SemiBold.ttf" LogicalName="QuizPdf.Bold.ttf" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\QuizContent\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Icons8AssetsEnabled)' != 'true'">
    <MauiFont Remove="Resources\Fonts\Icons8Actions.ttf" />
    <Compile Remove="Services\Appearance\Icons8LicensedPaths.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Remove="Resources\Raw\**" />
    <Compile Remove="Resources\Raw\**" />
    <EmbeddedResource Remove="Resources\Raw\**" />
    <MauiCss Remove="Resources\Raw\**" />
    <MauiXaml Remove="Resources\Raw\**" />
    <None Remove="Resources\Raw\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Raw\QuizContent\*.json" LogicalName="QuizContent.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Formulas\FormulaPage.xaml.cs">
      <DependentUpon>FormulaPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Formulas\MeasurementFormulaView.xaml.cs">
      <DependentUpon>MeasurementFormulaView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Quizzes\MathPuzzlePage.xaml.cs">
      <DependentUpon>MathPuzzlePage.xaml</DependentUpon>
    </Compile>
  <Compile Update="Views\Calculators\PowerRootView.xaml.cs">
      <DependentUpon>PowerRootView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\Calculators\AverageView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Calculators\PowerRootView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Calculators\FindXView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Formulas\FormulaPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Formulas\MeasurementFormulaView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Calculators\FractionView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Formulas\MultiplicationTablePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Quizzes\MathPuzzlePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  <MauiXaml Update="Views\Settings\SettingsMenuPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Startup\SplashPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>
</Project>
