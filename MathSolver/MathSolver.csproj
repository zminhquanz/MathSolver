<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../tools/msbuild/PdfSharpCore.props" />
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <!-- Reference Windows packages directly: the cross-platform metapackages also copy
         Linux native backends into Windows output through their NuGet .props files. -->
    <PackageReference Include="LLamaSharp.Backend.Cuda12.Windows" Version="0.30.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.30.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="12.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
  </ItemGroup>

  <!-- Rebuilt from LLamaSharp 0.30.0's exact llama.cpp revision with 16 KiB
       ELF/RELRO alignment. Upstream Android package binaries are 4 KiB-only.
       Keep both CPU ABIs and the optional KleidiAI variant synchronized. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidNativeLibrary Include="Platforms\Android\Native\llama\arm64-v8a\*.so" Abi="arm64-v8a" Condition="'$(RuntimeIdentifier)' != 'android-x64'" />
    <AndroidNativeLibrary Include="Platforms\Android\Native\llama\x86_64\*.so" Abi="x86_64" Condition="'$(RuntimeIdentifier)' != 'android-arm64'" />
    <MauiAsset Include="Platforms\Android\Native\llama\arm64-v8a\LICENSE*.txt" LogicalName="ThirdParty/AndroidCpu/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseLicensedIcons)' != 'false' and Exists('Resources/Fonts/Icons8Actions.ttf') and Exists('Services/Appearance/Icons8LicensedPaths.g.cs')">
    <Icons8AssetsEnabled>true</Icons8AssetsEnabled>
    <DefineConstants>$(DefineConstants);ICONS8_LICENSED_ASSETS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

    <!-- Note for MacCatalyst:
    The default runtime is maccatalyst-x64, except in Release config, in which case the default runtime is maccatalyst-x64;maccatalyst-arm64.
    When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
    The Mac App Store will not accept apps with only maccatalyst-arm64. -->

    <OutputType>Exe</OutputType>
    <RootNamespace>MathSolver</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationId>com.quanvu.mathsolver</ApplicationId>
    <ApplicationDisplayVersion>0.2.1</ApplicationDisplayVersion>
    <PackageVersion>$(ApplicationDisplayVersion)</PackageVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <!-- Material 3 / Material You is enabled only for Android.
       Windows remains on the existing WinUI rendering and styles. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <UseMaterial3>true</UseMaterial3>
    <MauiAndroidSystemBarsUseMauiChrome>true</MauiAndroidSystemBarsUseMauiChrome>
    <!-- Local Debug/Release device builds use the SDK development key.
         Supply AndroidKeyStore=true and signing properties for distribution. -->
    <AndroidKeyStore Condition="'$(AndroidKeyStore)' == ''">false</AndroidKeyStore>
    <AndroidApkSignerAdditionalArguments>--v2-signing-enabled true</AndroidApkSignerAdditionalArguments>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MATHSOLVER_ANDROID_RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- .NET 11 Android requires CoreCLR in both Debug and Release.
       App-level SIMD preferences remain controlled independently. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <UseMonoRuntime>false</UseMonoRuntime>
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- SVG sources; MAUI generates platform PNG/ICO assets at build time. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Images\mathsolver_logo_light.svg" Color="#2563EB">
      <ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">0.65</ForegroundScale>
      <ForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">0.9</ForegroundScale>
    </MauiIcon>
    <MauiSplashScreen Include="Resources\Splash\mathsolver_splash.svg" BaseSize="128,128" Color="#2563EB" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\ai_guide_stationery.png" BaseSize="192,128" Resize="True" />
    <MauiImage Update="Resources\Images\quiz_story_*.png" BaseSize="240,160" Resize="True" />
    <MauiImage Update="Resources\Images\review_empty_tray.png;Resources\Images\pdf_blank_sheet.png;Resources\Images\excel_template_sheet.png;Resources\Images\excel_fill_sheet.png;Resources\Images\excel_review_sheet.png" BaseSize="180,120" Resize="True" />
    <MauiImage Update="Resources\Images\excel_motion_sheet.png;Resources\Images\excel_motion_pencil.png" BaseSize="180,120" Resize="True" />
    <MauiFont Include="Resources\Fonts\*" />
    <EmbeddedResource Include="Resources\Fonts\OpenSans-Regular.ttf" LogicalName="QuizPdf.Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\OpenSans-SemiBold.ttf" LogicalName="QuizPdf.Bold.ttf" />
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\QuizContent\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- WinUI Release loads artwork from a single optimized archive. Shell
       navigation icons and OS-owned app/splash assets remain native resources. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MATHSOLVER_WINDOWS_ARTWORK_PACK</DefineConstants>
    <!-- Retain English/Vietnamese managed satellite assemblies on Windows Release.
         Windows App SDK native resources are handled by its own packaging targets. -->
    <SatelliteResourceLanguages>en;en-US;vi;vi-VN</SatelliteResourceLanguages>
    <WindowsArtworkPackPath>$(MSBuildProjectDirectory)\obj\artwork\$(Configuration)\$(TargetFramework)\mathsolver-artwork.pack</WindowsArtworkPackPath>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">
    <WindowsArtworkSource Include="Resources\Images\*.png;Resources\Images\*.svg" />
    <MauiImage Remove="Resources\Images\*.png;Resources\Images\*.svg" />
    <!-- WinUI Shell icons use native resource URIs, bypassing the packed
         FileImageSource service used by ordinary MAUI Image controls. -->
    <MauiImage Include="Resources\Images\calculate.svg;Resources\Images\quiz.svg;Resources\Images\function.svg;Resources\Images\grid_on.svg" />
    <Content Include="$(WindowsArtworkPackPath)" Link="mathsolver-artwork.pack" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Android Release retains only native Shell and PopupMenu drawables. SVG
       sources still pass through MAUI Resizetizer for high-quality PNG aliases
       inside the archive; remaining generated rasters are pruned before AAPT. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MATHSOLVER_ANDROID_ARTWORK_PACK</DefineConstants>
    <AndroidArtworkPackPath>$(MSBuildProjectDirectory)\obj\artwork\$(Configuration)\$(TargetFramework)\mathsolver-artwork.pack</AndroidArtworkPackPath>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <AndroidArtworkSource Include="Resources\Images\*.png;Resources\Images\*.svg" />
    <MauiImage Remove="Resources\Images\*.png" />
    <MauiAsset Include="$(AndroidArtworkPackPath)" LogicalName="mathsolver-artwork.pack" />
  </ItemGroup>
  <PropertyGroup>
    <_ArtworkPackSourceList>$(MSBuildProjectDirectory)\obj\artwork\$(Configuration)\$(TargetFramework)\sources.txt</_ArtworkPackSourceList>
  </PropertyGroup>
  <Target Name="TrackArtworkPackSources">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ArtworkPackSourceList)'))" />
    <!-- A moved or removed file can predate the existing pack. Track membership as well as timestamps. -->
    <WriteLinesToFile File="$(_ArtworkPackSourceList)" Lines="@(WindowsArtworkSource);@(AndroidArtworkSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="PackAndroidArtwork" AfterTargets="_ResizetizeInjectPlatformItems" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'" DependsOnTargets="TrackArtworkPackSources" Inputs="@(AndroidArtworkSource);$(_ArtworkPackSourceList);$(_ResizetizerStampFile);$(MSBuildProjectDirectory)\..\tools\artwork\pack-windows-artwork.ps1" Outputs="$(AndroidArtworkPackPath)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\artwork\pack-windows-artwork.ps1&quot; -SourceDirectory &quot;$(MSBuildProjectDirectory)\Resources\Images&quot; -OutputFile &quot;$(AndroidArtworkPackPath)&quot; -AndroidSvgRasterDirectory &quot;$(_MauiIntermediateImagesFullPath)drawable-xxxhdpi&quot;" />
  </Target>
  <Target Name="PruneAndroidArtwork" AfterTargets="PackAndroidArtwork" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\artwork\prune-android-artwork.ps1&quot; -SourceDirectory &quot;$(MSBuildProjectDirectory)\Resources\Images&quot; -ResizetizerDirectory &quot;$(_MauiIntermediateImagesFullPath).&quot;" />
  </Target>
  <!-- Windows App SDK self-contained mode adds every WinUI .mui culture as a
       loose file. Use its supported exclusion item before it creates output
       items, retaining all en-* and vi-* resources and every native DLL. -->
  <Target Name="RestrictWindowsAppSdkReleaseMuiCultures" BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents" DependsOnTargets="GetWindowsAppSDKNativePlatform" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">
    <ItemGroup>
      <_WindowsAppSdkMui Include="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\**\*.mui" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(_WindowsAppSdkMui)" Condition="!$([System.String]::Copy('%(_WindowsAppSdkMui.RecursiveDir)').ToLowerInvariant().StartsWith('en-')) and !$([System.String]::Copy('%(_WindowsAppSdkMui.RecursiveDir)').ToLowerInvariant().StartsWith('vi-'))" />
    </ItemGroup>
  </Target>
  <Target Name="PackWindowsArtwork" BeforeTargets="GetCopyToOutputDirectoryItems;_GetCopyToPublishDirectoryItems" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'" DependsOnTargets="TrackArtworkPackSources" Inputs="@(WindowsArtworkSource);$(_ArtworkPackSourceList);$(MSBuildProjectDirectory)\..\tools\artwork\pack-windows-artwork.ps1" Outputs="$(WindowsArtworkPackPath)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\artwork\pack-windows-artwork.ps1&quot; -SourceDirectory &quot;$(MSBuildProjectDirectory)\Resources\Images&quot; -OutputFile &quot;$(WindowsArtworkPackPath)&quot;" />
  </Target>
  <Target Name="PruneOldWindowsArtworkCopies" AfterTargets="Build" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">
    <!-- $(TargetDir) ends in a slash; appending '.' avoids a trailing backslash
         escaping the closing quote in powershell.exe's Windows argument parsing. -->
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\artwork\prune-windows-artwork.ps1&quot; -SourceDirectory &quot;$(MSBuildProjectDirectory)\Resources\Images&quot; -OutputDirectory &quot;$(TargetDir).&quot;" />
  </Target>
  <ItemGroup Condition="'$(Icons8AssetsEnabled)' != 'true'">
    <MauiFont Remove="Resources\Fonts\Icons8Actions.ttf" />
    <Compile Remove="Services\Appearance\Icons8LicensedPaths.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Remove="Resources\Raw\**" />
    <Compile Remove="Resources\Raw\**" />
    <EmbeddedResource Remove="Resources\Raw\**" />
    <MauiCss Remove="Resources\Raw\**" />
    <MauiXaml Remove="Resources\Raw\**" />
    <None Remove="Resources\Raw\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Raw\QuizContent\*.json" LogicalName="QuizContent.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Formulas\FormulaPage.xaml.cs">
      <DependentUpon>FormulaPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Formulas\MeasurementFormulaView.xaml.cs">
      <DependentUpon>MeasurementFormulaView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Quizzes\MathPuzzlePage.xaml.cs">
      <DependentUpon>MathPuzzlePage.xaml</DependentUpon>
    </Compile>
  <Compile Update="Views\Calculators\PowerRootView.xaml.cs">
      <DependentUpon>PowerRootView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\Calculators\AverageView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Calculators\PowerRootView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Calculators\FindXView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Formulas\FormulaPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Formulas\MeasurementFormulaView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Calculators\FractionView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Formulas\MultiplicationTablePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Quizzes\MathPuzzlePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  <MauiXaml Update="Views\Settings\SettingsMenuPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\Startup\SplashPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>
