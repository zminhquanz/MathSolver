<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android app theme used after the native splash screen.
         Inherit from MAUI's Material 3 application theme rather than directly
         from the raw Google Material theme. MAUI's theme adds the control
         TextAppearance/style attributes required by the Material 3 handlers
         while still ultimately inheriting from Theme.Material3.DayNight. -->
    <style name="MathSolver.MainTheme" parent="Maui.Material3.Theme.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="windowActionModeOverlay">true</item>

        <!-- Android-only compact Material slider. MAUI Material3 currently uses
             the newer expressive slider metrics, whose thick track/tall thumb
             are visually oversized inside Math Solver's compact cards. Keep
             the native Material control and 48dp interaction area, but render
             the visual track/thumb with the classic compact proportions. -->
        <item name="sliderStyle">@style/MathSolver.Widget.Material3.Slider.Compact</item>
    </style>

    <style name="MathSolver.Widget.Material3.Slider.Compact" parent="Widget.Material3.Slider.Legacy">
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">10dp</item>
        <item name="haloRadius">18dp</item>
    </style>

    <!-- Preserve MAUI's native splash implementation. MainActivity switches
         to MathSolver.MainTheme in OnCreate before MAUI inflates controls.
         Do not declare postSplashScreenTheme here: it is not available in the
         Android resource set used by this MAUI build and causes AAPT2260. -->
    <style name="MathSolver.SplashTheme" parent="Maui.SplashTheme" />

    <!-- Android-only popup themes.  The compact Settings PopupMenu is created
         with one of these contexts so it follows the effective app Light/Dark
         mode instead of inheriting a stale light framework popup theme. -->
    <style name="MathSolverPopupMenuLight" parent="Theme.Material3.Light">
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Material3.PopupMenu.ListPopupWindow</item>
    </style>

    <style name="MathSolverPopupMenuDark" parent="Theme.Material3.Dark">
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Material3.PopupMenu.ListPopupWindow</item>
    </style>
</resources>
