                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Đặt lại" Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label Text="Khôi phục cài đặt mặc định" Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnResetTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <!-- Advanced -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
