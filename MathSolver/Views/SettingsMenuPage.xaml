<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MathSolver.Views.SettingsMenuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    HorizontalOptions="Fill"
    VerticalOptions="Fill"
    BackgroundColor="Transparent">

    <Grid x:Name="OverlayRoot">
        <BoxView
            x:Name="OverlayScrim"
            BackgroundColor="#66000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOutsideTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!--
            Chỉ bật khi SettingsMenuPage được gắn ở cấp Window trên Windows.
            Nút này nằm trên scrim và trùng vị trí nút Settings thật ở Shell,
            nên người dùng vẫn thấy/có thể bấm lại nút Settings để đóng menu.
        -->
        <Grid
            x:Name="OverlaySettingsButton"
            WidthRequest="42"
            HeightRequest="42"
            Margin="0"
            HorizontalOptions="End"
            VerticalOptions="Start"
            IsVisible="False"
            ZIndex="3">

            <ImageButton
                WidthRequest="42"
                HeightRequest="42"
                Padding="0"
                BorderWidth="1"
                CornerRadius="24"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="Transparent"
                SemanticProperties.Description="Đóng cài đặt giao diện"
                Clicked="OnOverlaySettingsButtonClicked" />

            <controls:ThemedSvgPathIcon
                Data="M433-80q-27 0-46.5-18T363-142l-9-66q-13-5-24.5-12T307-235l-62 26q-25 11-50 2t-39-32l-47-82q-14-23-8-49t27-43l53-40q-1-7-1-13.5v-27q0-6.5 1-13.5l-53-40q-21-17-27-43t8-49l47-82q14-23 39-32t50 2l62 26q11-8 23-15t24-12l9-66q4-26 23.5-44t46.5-18h94q27 0 46.5 18t23.5 44l9 66q13 5 24.5 12t22.5 15l62-26q25-11 50-2t39 32l47 82q14 23 8 49t-27 43l-53 40q1 7 1 13.5v27q0 6.5-2 13.5l53 40q21 17 27 43t-8 49l-48 82q-14 23-39 32t-50-2l-60-26q-11 8-23 15t-24 12l-9 66q-4 26-23.5 44T527-80h-94Zm7-80h79l14-106q31-8 57.5-23.5T639-327l99 41 39-68-86-65q5-14 7-29.5t2-31.5q0-16-2-31.5t-7-29.5l86-65-39-68-99 42q-22-23-48.5-38.5T533-694l-13-106h-79l-14 106q-31 8-57.5 23.5T321-633l-99-41-39 68 86 64q-5 15-7 30t-2 32q0 16 2 31t7 30l-86 65 39 68 99-42q22 23 48.5 38.5T427-266l13 106Zm42-180q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Zm-2-140Z"
                WidthRequest="22"
                Scale="0.833333"
                HeightRequest="22"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Grid>

        <Border
            x:Name="MenuPanel"
            Margin="0,6,8,12"
            ZIndex="2"
            Padding="0"
            WidthRequest="390"
            MaximumHeightRequest="760"
            HorizontalOptions="End"
            VerticalOptions="Start"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource BorderBrush}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow
                    Brush="#66000000"
                    Offset="0,8"
                    Radius="22"
                    Opacity="0.42" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*">
                <Grid
                    Grid.Row="0"
                    Padding="18,14"
                    ColumnDefinitions="*,Auto"
                    BackgroundColor="{DynamicResource SurfaceAltColor}">

                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label
                            Text="Cài đặt"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            Text="Tùy chỉnh nhanh Math Solver"
                            FontSize="12"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="×"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        CornerRadius="20"
                        FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        Clicked="OnCloseClicked" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="10,8,10,12" Spacing="4">

                        <!-- Theme -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="◐" Style="{StaticResource ThemeMenuIconStyle}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Chủ đề" Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label x:Name="ThemeSummaryLabel" Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">

                                    <Label
                                        x:Name="ThemeChevronLabel"
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ThemeOptionsBorder"
                            IsVisible="False"
                            AnchorY="0"
                            Margin="54,0,4,4"
                            Padding="8"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button x:Name="SystemThemeButton" Grid.Column="0" Text="Hệ thống" Clicked="OnSystemThemeClicked" />
                                <Button x:Name="LightThemeButton" Grid.Column="1" Text="Sáng" Clicked="OnLightThemeClicked" />
                                <Button x:Name="DarkThemeButton" Grid.Column="2" Text="Tối" Clicked="OnDarkThemeClicked" />
                            </Grid>
                        </Border>

                        <!-- Accent color -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="●" Style="{StaticResource ThemeMenuIconStyle}" TextColor="{DynamicResource PrimaryColor}" FontSize="30"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Màu chủ đề" Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label x:Name="AccentSummaryLabel" Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">

                                    <Label
                                        x:Name="AccentChevronLabel"
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAccentRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="AccentOptionsBorder"
                            IsVisible="False"
                            AnchorY="0"
                            Margin="54,0,4,4"
                            Padding="10"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center" HeightRequest="50">
                                    <Button Text="" CommandParameter="#6D28D9" BackgroundColor="#6D28D9" Style="{StaticResource AccentSwatchButtonStyle}" Clicked="OnPresetColorClicked" />
                                    <Button Text="" CommandParameter="#2563EB" BackgroundColor="#2563EB" Style="{StaticResource AccentSwatchButtonStyle}" Clicked="OnPresetColorClicked" />
                                    <Button Text="" CommandParameter="#0891B2" BackgroundColor="#0891B2" Style="{StaticResource AccentSwatchButtonStyle}" Clicked="OnPresetColorClicked" />
                                    <Button Text="" CommandParameter="#16A34A" BackgroundColor="#16A34A" Style="{StaticResource AccentSwatchButtonStyle}" Clicked="OnPresetColorClicked" />
                                    <Button Text="" CommandParameter="#EA580C" BackgroundColor="#EA580C" Style="{StaticResource AccentSwatchButtonStyle}" Clicked="OnPresetColorClicked" />
                                    <Button Text="" CommandParameter="#DB2777" BackgroundColor="#DB2777" Style="{StaticResource AccentSwatchButtonStyle}" Clicked="OnPresetColorClicked" />
                                </FlexLayout>

                                <Button
                                    Text="Tùy chỉnh màu…"
                                    BackgroundColor="Transparent"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    Clicked="OnAdvancedColorClicked" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Font -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <controls:ThemedSvgPathIcon
                                    Grid.Column="0"
                                    Data="M384-362h192l35 97q4 11 14 18t22 7q20 0 32.5-16.5T684-293L532-695q-5-11-15-18t-22-7h-30q-12 0-22 7t-15 18L276-293q-8 19 4 36t32 17q13 0 22.5-7t14.5-19l35-96Zm24-70 70-198h4l70 198H408ZM160-80q-33 0-56.5-23.5T80-160v-640q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v640q0 33-23.5 56.5T800-80H160Zm0-80h640v-640H160v640Zm0-640v640-640Z"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    Scale="0.833333"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Phông chữ" Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label x:Name="FontSummaryLabel" Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">

                                    <Label
                                        x:Name="FontChevronLabel"
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFontRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="FontOptionsBorder"
                            IsVisible="False"
                            AnchorY="0"
                            Margin="54,0,4,4"
                            Padding="8"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout x:Name="FontOptionsLayout" Spacing="4" />
                        </Border>

                        <!-- Language -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <controls:ThemedSvgPathIcon
                                    Grid.Column="0"
                                    Data="M325-111.5q-73-31.5-127.5-86t-86-127.5Q80-398 80-480.5t31.5-155q31.5-72.5 86-127t127.5-86Q398-880 480.5-880t155 31.5q72.5 31.5 127 86t86 127Q880-563 880-480.5T848.5-325q-31.5 73-86 127.5t-127 86Q563-80 480.5-80T325-111.5ZM480-162q26-36 45-75t31-83H404q12 44 31 83t45 75Zm-104-16q-18-33-31.5-68.5T322-320H204q29 50 72.5 87t99.5 55Zm208 0q56-18 99.5-55t72.5-87H638q-9 38-22.5 73.5T584-178ZM170-400h136q-3-20-4.5-39.5T300-480q0-21 1.5-40.5T306-560H170q-5 20-7.5 39.5T160-480q0 21 2.5 40.5T170-400Zm216 0h188q3-20 4.5-39.5T580-480q0-21-1.5-40.5T574-560H386q-3 20-4.5 39.5T380-480q0 21 1.5 40.5T386-400Zm268 0h136q5-20 7.5-39.5T800-480q0-21-2.5-40.5T790-560H654q3 20 4.5 39.5T660-480q0 21-1.5 40.5T654-400Zm-16-240h118q-29-50-72.5-87T584-782q18 33 31.5 68.5T638-640Zm-234 0h152q-12-44-31-83t-45-75q-26 36-45 75t-31 83Zm-200 0h118q9-38 22.5-73.5T376-782q-56 18-99.5 55T204-640Z"
                                    HeightRequest="24"
                                    WidthRequest="24"
                                    Scale="0.833333"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Ngôn ngữ" Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label x:Name="LanguageSummaryLabel" Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">

                                    <Label
                                        x:Name="LanguageChevronLabel"
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="LanguageOptionsBorder"
                            IsVisible="False"
                            AnchorY="0"
                            Margin="54,0,4,4"
                            Padding="8"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button x:Name="EnglishLanguageButton" Grid.Column="0" Text="Tiếng Anh" Clicked="OnEnglishClicked" />
                                <Button x:Name="VietnameseLanguageButton" Grid.Column="1" Text="Tiếng Việt" Clicked="OnVietnameseClicked" />
                            </Grid>
                        </Border>

                        <!-- Result number display -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    Text="123"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="{localization:Translate Settings.NumberDisplay.Title}"
                                        Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label
                                        x:Name="NumberDisplaySummaryLabel"
                                        Style="{StaticResource ThemeMenuSummaryStyle}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Switch
                                    x:Name="FullNumberDisplaySwitch"
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    Toggled="OnFullNumberDisplayToggled" />
                            </Grid>
                        </Border>

                        <!-- Hardware and performance -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <controls:ThemedSvgPathIcon
                                    Grid.Column="0"
                                    Data="M680-160q-17 0-28.5-11.5T640-200v-200q0-17 11.5-28.5T680-440h80q17 0 28.5 11.5T800-400v200q0 17-11.5 28.5T760-160h-80Zm-240 0q-17 0-28.5-11.5T400-200v-560q0-17 11.5-28.5T440-800h80q17 0 28.5 11.5T560-760v560q0 17-11.5 28.5T520-160h-80Zm-240 0q-17 0-28.5-11.5T160-200v-360q0-17 11.5-28.5T200-600h80q17 0 28.5 11.5T320-560v360q0 17-11.5 28.5T280-160h-80Z"
                                    WidthRequest="24"
                                    Scale="0.666667"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="1"
                                    VerticalOptions="Center">
                                    <Label
                                        Text="Thông tin phần cứng"
                                        Style="{StaticResource ThemeMenuTitleStyle}" />
                                    <Label
                                        Text="Phần cứng và hiệu năng tính toán"
                                        Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">
                                    <Label
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHardwarePerformanceTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <controls:ThemedSvgPathIcon
                                    Grid.Column="0"
                                    Data="M508.5-291.5Q520-303 520-320v-160q0-17-11.5-28.5T480-520q-17 0-28.5 11.5T440-480v160q0 17 11.5 28.5T480-280q17 0 28.5-11.5Zm0-320Q520-623 520-640t-11.5-28.5Q497-680 480-680t-28.5 11.5Q440-657 440-640t11.5 28.5Q463-600 480-600t28.5-11.5ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"
                                    WidthRequest="24"
                                    Scale="0.833333"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="1"
                                    VerticalOptions="Center">

                                    <Label
                                        x:Name="AboutMenuTitleLabel"
                                        Text="Giới thiệu"
                                        Style="{StaticResource ThemeMenuTitleStyle}" />

                                    <Label
                                        x:Name="AboutMenuSummaryLabel"
                                        Text="Thông tin ứng dụng, tác giả và phiên bản"
                                        Style="{StaticResource ThemeMenuSummaryStyle}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">
                                    <Label
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <!-- Developer mode -->
                        <Border Style="{StaticResource ThemeMenuRowStyle}">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Label
                                    Grid.Column="0"
                                    Text="&lt;/&gt;"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="1"
                                    VerticalOptions="Center">

                                    <Label
                                        x:Name="DeveloperModeTitleLabel"
                                        Text="Chế độ nhà phát triển"
                                        Style="{StaticResource ThemeMenuTitleStyle}" />

                                    <Label
                                        x:Name="DeveloperModeSummaryLabel"
                                        Text="Hiện công cụ chẩn đoán và log kỹ thuật"
                                        Style="{StaticResource ThemeMenuSummaryStyle}" />

                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="2"
                                    Style="{StaticResource ThemeMenuChevronContainerStyle}">

                                    <Label
                                        Text="›"
                                        Style="{StaticResource ThemeMenuChevronStyle}"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Border>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDeveloperModeTapped" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </Border>

                        <BoxView Margin="12,6" HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                        <!-- Reset -->
