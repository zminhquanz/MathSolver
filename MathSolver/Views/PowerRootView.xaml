<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.PowerRootView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            Style="{StaticResource SolverContentStyle}">

            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="aⁿ ⁿ√a"
                    Style="{StaticResource SolverHeroSymbolStyle}" />

                <Label
                    Text="{localization:Translate PowerRoot.Title}"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    Text="{localization:Translate PowerRoot.Subtitle}"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <Border
                Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="{localization:Translate PowerRoot.ChooseMode}"
                        Style="{StaticResource SolverSectionTitleStyle}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="PowerModeButton"
                            Grid.Column="0"
                            Text="{localization:Translate PowerRoot.PowerMode}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource OnPrimaryColor}"
                            Clicked="OnPowerModeClicked" />

                        <Button
                            x:Name="RootModeButton"
                            Grid.Column="1"
                            Text="{localization:Translate PowerRoot.RootMode}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnRootModeClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <VerticalStackLayout
                x:Name="PowerContent"
                Spacing="14">

                <Border
                    Padding="14"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="{localization:Translate PowerRoot.InputTitle}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="6">

                                <Label
                                    Text="{localization:Translate PowerRoot.BaseLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="BaseEntry"
                                        Placeholder="Ví dụ : 1,000,000,000,000,000,000"
                                        Keyboard="Numeric"
                                        FontSize="18"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        TextChanged="OnInputTextChanged"
                                        Unfocused="OnIntegerEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="6">

                                <Label
                                    Text="{localization:Translate PowerRoot.ExponentLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="ExponentEntry"
                                        Placeholder="{localization:Translate PowerRoot.ExponentPlaceholder}"
                                        Keyboard="Numeric"
                                        FontSize="18"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        TextChanged="OnInputTextChanged"
                                        Unfocused="OnIntegerEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Grid>

                        <Border
                            x:Name="ErrorBorder"
                            IsVisible="False"
                            Padding="12,10"
                            BackgroundColor="{DynamicResource DangerSoftColor}"
                            Stroke="{DynamicResource DangerBorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <Label
                                    Text="⚠"
                                    FontSize="22"
                                    TextColor="{DynamicResource DangerColor}" />

                                <Label
                                    x:Name="ErrorLabel"
                                    Grid.Column="1"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource DangerColor}" />

                            </Grid>

                        </Border>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Button
                                x:Name="CalculateButton"
                                Grid.Column="0"
                                Text="{localization:Translate Actions.Calculate}"
                                Style="{StaticResource SolverPrimaryActionStyle}"
                                Clicked="OnCalculateClicked" />

                            <Button
                                x:Name="ClearButton"
                                Grid.Column="1"
                                Text="{localization:Translate Actions.Clear}"
                                Style="{StaticResource SolverSecondaryActionStyle}"
                                BackgroundColor="{DynamicResource DividerColor}"
                                Clicked="OnClearClicked" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <Border
                    x:Name="ProgressBorder"
                    IsVisible="False"
                    Padding="16"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <ActivityIndicator
                                x:Name="CalculationActivityIndicator"
                                Grid.Column="0"
                                WidthRequest="24"
                                HeightRequest="24"
                                VerticalOptions="Center"
                                IsRunning="False"
                                IsVisible="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ProgressTitleLabel"
                                Grid.Column="1"
                                VerticalTextAlignment="Center"
                                FontSize="18"
                                FontAttributes="Bold"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </Grid>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <ProgressBar
                                x:Name="CalculationProgressBar"
                                Grid.Column="0"
                                HeightRequest="10"
                                Progress="0"
                                ProgressColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ProgressPercentLabel"
                                Grid.Column="1"
                                Text="0%"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                        </Grid>

                        <Label
                            x:Name="ProgressStepsLabel"
                            FontSize="15"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Button
                            x:Name="StopButton"
                            Text="{localization:Translate PowerRoot.Stop}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource DangerColor}"
                            TextColor="White"
                            Clicked="OnStopClicked" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    x:Name="ResultBorder"
                    IsVisible="False"
                    Padding="16"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="{localization:Translate PowerRoot.ResultTitle}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                                x:Name="ResultExpressionLabel"
                                FontSize="32"
                                FontAttributes="Bold"
                                LineBreakMode="WordWrap"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                        </Border>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Grid
                                x:Name="CopyResultButtonContainer"
                                Grid.Column="0"
                                HeightRequest="48">

                                <Button
                                    x:Name="CopyResultButton"
                                    Text="{localization:Translate PowerRoot.CopyCompact}"
                                    CornerRadius="12"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    TextColor="Transparent"
                                    Clicked="OnCopyResultClicked" />

                                <HorizontalStackLayout
                                    InputTransparent="True"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="8">

                                    <Image
                                        Source="content_copy.png"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Aspect="AspectFit">

                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior
                                                x:Name="CopyResultIconTintBehavior" />
                                        </Image.Behaviors>

                                    </Image>

                                    <Label
                                        Text="{Binding Text, Source={x:Reference CopyResultButton}}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Grid>

                            <Button
                                x:Name="ExportTextButton"
                                Grid.Column="1"
                                IsVisible="False"
                                Text="{localization:Translate PowerRoot.ExportTxt}"
                                HeightRequest="48"
                                CornerRadius="12"
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                ImageSource="file_export.png"
                                Clicked="OnExportTextClicked" />

                        </Grid>

                        <Border
                            x:Name="ExportStatusBorder"
                            IsVisible="False"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <ActivityIndicator
                                    x:Name="ExportActivityIndicator"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    IsRunning="False"
                                    IsVisible="False"
                                    Color="{DynamicResource PrimaryColor}" />

                                <Label
                                    x:Name="ExportStatusLabel"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalTextAlignment="Center"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <ProgressBar
                                    x:Name="ExportProgressBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HeightRequest="6"
                                    Progress="0"
                                    ProgressColor="{DynamicResource PrimaryColor}" />

                            </Grid>

                        </Border>

                        <Button
                            x:Name="DiagnosticsToggleButton"
                            IsVisible="False"
                            Text="{localization:Translate PowerRoot.ShowDetails}"
                            HorizontalOptions="End"
                            HeightRequest="34"
                            Padding="12,4"
                            CornerRadius="9"
                            FontSize="12"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextSecondaryColor}"
                            Clicked="OnDiagnosticsToggleClicked" />

                        <Border
                            x:Name="LargeResultInfoBorder"
                            IsVisible="False"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                                x:Name="LargeResultInfoLabel"
                                FontSize="15"
                                LineHeight="1.25"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </Border>

                        <Label
                            Text="{localization:Translate PowerRoot.SolutionTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="SolutionLabel"
                            FontSize="16"
                            LineHeight="1.3"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="RootContent"
                IsVisible="False"
                Spacing="14">

                <Border Style="{StaticResource SolverCardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="{localization:Translate PowerRoot.RootInputTitle}"
                            Style="{StaticResource SolverSectionTitleStyle}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="6">

                                <Label
                                    Text="{localization:Translate PowerRoot.RadicandLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="RootRadicandEntry"
                                        Placeholder="{localization:Translate PowerRoot.RadicandPlaceholder}"
                                        Keyboard="Numeric"
                                        FontSize="18"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Focused="OnRootRadicandFocused"
                                        TextChanged="OnRootInputTextChanged"
                                        Unfocused="OnRootRadicandUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="6">

                                <Label
                                    Text="{localization:Translate PowerRoot.DegreeLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="RootDegreeEntry"
                                        Placeholder="{localization:Translate PowerRoot.DegreePlaceholder}"
                                        Keyboard="Numeric"
                                        FontSize="18"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        TextChanged="OnRootInputTextChanged"
                                        Unfocused="OnRootDegreeUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Grid>

                        <Border
                            x:Name="RootErrorBorder"
                            IsVisible="False"
                            Padding="12,10"
                            BackgroundColor="{DynamicResource DangerSoftColor}"
                            Stroke="{DynamicResource DangerBorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <Label
                                    Text="⚠"
                                    FontSize="22"
                                    TextColor="{DynamicResource DangerColor}" />

                                <Label
                                    x:Name="RootErrorLabel"
                                    Grid.Column="1"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource DangerColor}" />

                            </Grid>

                        </Border>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Button
                                x:Name="RootCalculateButton"
                                Grid.Column="0"
                                Text="{localization:Translate Actions.Calculate}"
                                Style="{StaticResource SolverPrimaryActionStyle}"
                                Clicked="OnRootCalculateClicked" />

                            <Button
                                x:Name="RootClearButton"
                                Grid.Column="1"
                                Text="{localization:Translate Actions.Clear}"
                                Style="{StaticResource SolverSecondaryActionStyle}"
                                Clicked="OnRootClearClicked" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <Border
                    x:Name="RootResultBorder"
                    IsVisible="False"
                    Padding="16"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="{localization:Translate PowerRoot.RootResultTitle}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <!--
                                    Trình bày dấu căn theo đúng quy ước sách giáo khoa:
                                    căn bậc hai không có chỉ số; bậc 3–255 đặt
                                    chỉ số nhỏ ở góc trên bên trái của dấu căn.
                                    Biểu thức, dấu bằng và kết quả nằm cùng dòng.
                                -->
                                <ScrollView
                                    Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never"
                                    HorizontalOptions="Center">

                                    <HorizontalStackLayout
                                        Spacing="6"
                                        VerticalOptions="Center">

                                        <controls:TextbookRadicalExpressionView
                                            x:Name="RootResultExpressionView"
                                            FontSize="32"
                                            DegreeFontSize="18"
                                            FontAttributes="Bold"
                                            LineColor="{DynamicResource PrimaryColor}"
                                            TextColor="{DynamicResource PrimaryColor}"
                                            HorizontalOptions="Center" />

                                        <Label
                                            Text="="
                                            FontSize="32"
                                            FontAttributes="Bold"
                                            VerticalTextAlignment="Center"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            x:Name="RootResultValueLabel"
                                            FontSize="32"
                                            FontAttributes="Bold"
                                            VerticalTextAlignment="Center"
                                            LineBreakMode="NoWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                    </HorizontalStackLayout>

                                </ScrollView>

                                <Label
                                    x:Name="RootResultKindLabel"
                                    FontSize="13"
                                    FontAttributes="Italic"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                            </VerticalStackLayout>

                        </Border>

                        <Button
                            x:Name="RootCopyResultButton"
                            Text="{localization:Translate PowerRoot.RootCopyResult}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource DividerColor}"
                            Clicked="OnRootCopyResultClicked" />

                        <Label
                            Text="{localization:Translate PowerRoot.SolutionTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <VerticalStackLayout
                            x:Name="RootSolutionStack"
                            Spacing="13" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- Lưu ý khi sử dụng -->
            <Border
                Padding="16"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="⚠"
                        FontSize="26"
                        VerticalOptions="Start"
                        TextColor="{DynamicResource WarningColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Lưu ý khi sử dụng"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                            FontSize="16"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                            FontSize="16"
                            FontAttributes="Italic"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>

    </ScrollView>

</base:LocalizedSolverView>
