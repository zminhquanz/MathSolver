<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MathSolver.Views.PowerRootView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            Padding="20,16"
            Spacing="14"
            HorizontalOptions="Fill">

            <VerticalStackLayout
                Margin="0,4,0,6"
                Spacing="2">

                <Label
                    Text="aⁿ  ⁿ√a"
                    FontSize="40"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource PrimaryColor}" />

                <Label
                    Text="{localization:Translate PowerRoot.Title}"
                    FontSize="27"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="{localization:Translate PowerRoot.Subtitle}"
                    FontSize="17"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextSecondaryColor}" />

            </VerticalStackLayout>

            <Border
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="{localization:Translate PowerRoot.ChooseMode}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="PowerModeButton"
                            Grid.Column="0"
                            Text="{localization:Translate PowerRoot.PowerMode}"
                            HeightRequest="50"
                            Padding="8,0"
                            CornerRadius="12"
                            FontSize="17"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource OnPrimaryColor}"
                            Clicked="OnPowerModeClicked" />

                        <Button
                            x:Name="RootModeButton"
                            Grid.Column="1"
                            Text="{localization:Translate PowerRoot.RootMode}"
                            HeightRequest="50"
                            Padding="8,0"
                            CornerRadius="12"
                            FontSize="17"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnRootModeClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <VerticalStackLayout
                x:Name="PowerContent"
                Spacing="14">

                <Border
                    Padding="14"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="{localization:Translate PowerRoot.InputTitle}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="6">

                                <Label
                                    Text="{localization:Translate PowerRoot.BaseLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="BaseEntry"
                                        Placeholder="Ví dụ : 1,000,000,000,000,000,000"
                                        Keyboard="Numeric"
                                        FontSize="18"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        TextChanged="OnInputTextChanged"
                                        Unfocused="OnIntegerEntryUnfocused" />

                                </Border>

                                <Label
                                    Text="{localization:Translate PowerRoot.BaseHint}"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="6">

                                <Label
                                    Text="{localization:Translate PowerRoot.ExponentLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="ExponentEntry"
                                        Placeholder="Ví dụ 1,000,000"
                                        Keyboard="Numeric"
                                        FontSize="18"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        TextChanged="OnInputTextChanged"
                                        Unfocused="OnIntegerEntryUnfocused" />

                                </Border>

                                <Label
                                    Text="{localization:Translate PowerRoot.ExponentHint}"
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                            </VerticalStackLayout>

                        </Grid>

                        <Border
                            x:Name="ErrorBorder"
                            IsVisible="False"
                            Padding="12,10"
                            BackgroundColor="{DynamicResource DangerSoftColor}"
                            Stroke="{DynamicResource DangerBorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <Label
                                    Text="⚠"
                                    FontSize="22"
                                    TextColor="{DynamicResource DangerColor}" />

                                <Label
                                    x:Name="ErrorLabel"
                                    Grid.Column="1"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource DangerColor}" />

                            </Grid>

                        </Border>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Button
                                x:Name="CalculateButton"
                                Grid.Column="0"
                                Text="{localization:Translate Actions.Calculate}"
                                HeightRequest="50"
                                CornerRadius="12"
                                FontSize="17"
                                FontAttributes="Bold"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                Clicked="OnCalculateClicked" />

                            <Button
                                x:Name="ClearButton"
                                Grid.Column="1"
                                Text="{localization:Translate Actions.Clear}"
                                HeightRequest="50"
                                CornerRadius="12"
                                FontSize="17"
                                FontAttributes="Bold"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnClearClicked" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <Border
                    x:Name="ProgressBorder"
                    IsVisible="False"
                    Padding="16"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label
                            x:Name="ProgressTitleLabel"
                            FontSize="18"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <ProgressBar
                                x:Name="CalculationProgressBar"
                                Grid.Column="0"
                                HeightRequest="10"
                                Progress="0"
                                ProgressColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ProgressPercentLabel"
                                Grid.Column="1"
                                Text="0%"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                        </Grid>

                        <Label
                            x:Name="ProgressStepsLabel"
                            FontSize="15"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Button
                            x:Name="StopButton"
                            Text="{localization:Translate PowerRoot.Stop}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource DangerColor}"
                            TextColor="White"
                            Clicked="OnStopClicked" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    x:Name="ResultBorder"
                    IsVisible="False"
                    Padding="16"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource SuccessBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="{localization:Translate PowerRoot.ResultTitle}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource SuccessSoftColor}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    x:Name="ResultExpressionLabel"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource SuccessColor}" />

                                <Editor
                                    x:Name="ResultPreviewEditor"
                                    IsReadOnly="True"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="64"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    BackgroundColor="Transparent" />

                                <Label
                                    x:Name="ResultCompactHintLabel"
                                    IsVisible="False"
                                    Text="{localization:Translate PowerRoot.CompactHint}"
                                    FontSize="13"
                                    FontAttributes="Italic"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                            </VerticalStackLayout>

                        </Border>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Button
                                x:Name="CopyResultButton"
                                Grid.Column="0"
                                Text="{localization:Translate PowerRoot.CopyCompact}"
                                HeightRequest="48"
                                CornerRadius="12"
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnCopyResultClicked" />

                            <Button
                                x:Name="ExportTextButton"
                                Grid.Column="1"
                                IsVisible="False"
                                Text="{localization:Translate PowerRoot.ExportTxt}"
                                HeightRequest="48"
                                CornerRadius="12"
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                Clicked="OnExportTextClicked" />

                        </Grid>

                        <Border
                            x:Name="ExportStatusBorder"
                            IsVisible="False"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <ActivityIndicator
                                    x:Name="ExportActivityIndicator"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    WidthRequest="22"
                                    HeightRequest="22"
                                    IsRunning="False"
                                    IsVisible="False"
                                    Color="{DynamicResource PrimaryColor}" />

                                <Label
                                    x:Name="ExportStatusLabel"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalTextAlignment="Center"
                                    FontSize="14"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <ProgressBar
                                    x:Name="ExportProgressBar"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HeightRequest="6"
                                    Progress="0"
                                    ProgressColor="{DynamicResource PrimaryColor}" />

                            </Grid>

                        </Border>

                        <Border
                            x:Name="LargeResultInfoBorder"
                            IsVisible="False"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Label
                                x:Name="LargeResultInfoLabel"
                                FontSize="15"
                                LineHeight="1.25"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </Border>

                        <Label
                            Text="{localization:Translate PowerRoot.SolutionTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="SolutionLabel"
                            FontSize="16"
                            LineHeight="1.3"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <Border
                x:Name="RootComingSoonBorder"
                IsVisible="False"
                Padding="20"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="ⁿ√a"
                        FontSize="42"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource WarningColor}" />

                    <Label
                        Text="{localization:Translate PowerRoot.RootComingSoon}"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource WarningColor}" />

                </VerticalStackLayout>

            </Border>

            <!-- Lưu ý khi sử dụng -->
            <Border
                Padding="16"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="⚠"
                        FontSize="26"
                        VerticalOptions="Start"
                        TextColor="{DynamicResource WarningColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Lưu ý khi sử dụng"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                            FontSize="16"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                            FontSize="16"
                            FontAttributes="Italic"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentView>
