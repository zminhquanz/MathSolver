<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.AverageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            Style="{StaticResource SolverContentStyle}">

            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="x̄ = ∑x ÷ n"
                    Style="{StaticResource SolverHeroSymbolStyle}" />

                <Label
                    Text="{localization:Translate Average.Title}"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    Text="{localization:Translate Average.Subtitle}"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <Border
                Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="{localization:Translate Average.InputTitle}"
                        Style="{StaticResource SolverSectionTitleStyle}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="IntegerTypeButton"
                            Grid.Column="0"
                            Text="{localization:Translate Numbers.Integer}"
                            Style="{StaticResource SolverNumberTypeButtonStyle}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource OnPrimaryColor}"
                            Clicked="OnIntegerTypeClicked" />

                        <Button
                            x:Name="DecimalTypeButton"
                            Grid.Column="1"
                            Text="{localization:Translate Numbers.Decimal}"
                            Style="{StaticResource SolverNumberTypeButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnDecimalTypeClicked" />

                    </Grid>

                    <Label
                        Text="{localization:Translate Average.InputHelp}"
                        FontSize="15"
                        LineHeight="1.2"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <Border
                        Padding="12,8"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Editor
                            x:Name="ValuesEditor"
                            Placeholder="{localization:Translate Average.InputPlaceholder}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="132"
                            FontSize="18"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            PlaceholderColor="{DynamicResource TextSecondaryColor}"
                            BackgroundColor="Transparent"
                            TextChanged="OnValuesTextChanged" />

                    </Border>

                    <Label
                        Text="{localization:Translate Average.SeparatorsHint}"
                        FontSize="14"
                        FontAttributes="Italic"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <Border
                        x:Name="ErrorBorder"
                        IsVisible="False"
                        Padding="12,10"
                        BackgroundColor="{DynamicResource DangerSoftColor}"
                        Stroke="{DynamicResource DangerBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <Label
                                Text="❌"
                                FontSize="22"
                                TextColor="{DynamicResource DangerColor}" />

                            <Label
                                x:Name="ErrorLabel"
                                Grid.Column="1"
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource DangerColor}" />

                        </Grid>

                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="{localization:Translate Actions.Calculate}"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            Grid.Column="1"
                            Text="{localization:Translate Actions.Clear}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource DividerColor}"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="16"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="{localization:Translate Average.ResultTitle}"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="AverageResultLabel"
                            FontSize="32"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />

                    </Border>

                    <Grid HeightRequest="48">

                        <Button
                            x:Name="AverageCopyResultButton"
                            Text="{localization:Translate PowerRoot.CopyResult}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource DividerColor}"
                            TextColor="Transparent"
                            Clicked="OnAverageCopyResultClicked" />

                        <HorizontalStackLayout
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">

                            <controls:ThemedCopyIcon
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="{Binding Text, Source={x:Reference AverageCopyResultButton}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="{localization:Translate Average.CountLabel}"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                <Label
                                    x:Name="CountValueLabel"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="{localization:Translate Average.SumLabel}"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                <Label
                                    x:Name="SumValueLabel"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{DynamicResource DividerColor}" />

                    <Label
                        Text="{localization:Translate Average.SolutionTitle}"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <VerticalStackLayout Spacing="10">

                        <Label
                            x:Name="NumbersStepLabel"
                            FontSize="16"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="CountStepLabel"
                            FontSize="16"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="SumStepLabel"
                            FontSize="16"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="AverageStepLabel"
                            FontSize="17"
                            FontAttributes="Bold"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource PrimaryColor}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>
</VerticalStackLayout>

    </ScrollView>

</base:LocalizedSolverView>
