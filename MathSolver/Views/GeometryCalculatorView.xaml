<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.GeometryCalculatorView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Style="{StaticResource SolverContentStyle}">

            <!-- Tiêu đề -->
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="□  △  ○"
                    Style="{StaticResource SolverHeroSymbolStyle}"
                    FontAttributes="Bold"
                    />

                <Label
                    Text="HÌNH HỌC"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    Text="Tính chu vi, diện tích, diện tích bề mặt và thể tích"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <!--
                Desktop/laptop/tablet lớn: bộ điều khiển nằm bên trái,
                công thức và hình minh họa nằm bên phải.
                Tablet nhỏ/điện thoại: tự chuyển thành một cột.
            -->
            <Grid
                x:Name="GeometryMainResponsiveGrid"
                RowDefinitions="Auto"
                ColumnDefinitions="5*,7*"
                RowSpacing="14"
                ColumnSpacing="14"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                SizeChanged="OnGeometryMainResponsiveGridSizeChanged">

                <VerticalStackLayout
                    x:Name="GeometryControlColumn"
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="14"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">

                    <!-- 1. Phân loại hình học -->
                    <Border
                        Style="{StaticResource SolverCardStyle}">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="1. Chọn loại hình học"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="PlaneGeometryButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Geometry.Plane}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    Clicked="OnPlaneGeometryClicked" />

                                <Button
                                    x:Name="SolidGeometryButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Geometry.Solid}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    Clicked="OnSolidGeometryClicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. Chọn hình -->
                    <Border
                        Padding="16"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="2. Chọn hình"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                Text="Chọn một hình để xem công thức và nhập dữ liệu."
                                FontSize="16"
                                TextColor="{DynamicResource TextSecondaryColor}" />
                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid
                                    HeightRequest="46"
                                    ColumnDefinitions="*,44">

                                    <!--
                                    Picker phủ toàn bộ chiều rộng để người dùng có thể
                                    bấm cả vùng mũi tên. Picker dùng handler chuẩn của .NET MAUI trên từng nền tảng.
                                    -->
                                    <Picker
                                        x:Name="GeometryShapePicker"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="12,0,0,0"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TitleColor="{DynamicResource TextSecondaryColor}"
                                        BackgroundColor="Transparent"
                                        ItemsSource="{Binding GeometryItems}"
                                        SelectedIndexChanged="OnGeometryShapeSelected"
                                        ItemDisplayBinding="{Binding Path=Name}" />

                                    <!-- Vạch phân cách nhẹ cho vùng nút xổ xuống. -->
                                    <BoxView
                                        Grid.Column="1"
                                        WidthRequest="1"
                                        Margin="0,9,0,9"
                                        HorizontalOptions="Start"
                                        BackgroundColor="{DynamicResource DividerColor}"
                                        InputTransparent="True" />

                                    <!-- Nút xổ xuống dạng pill giống phần Cài đặt giao diện. -->
                                    <Border
                                        Grid.Column="1"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        Margin="6"
                                        Padding="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                                        Stroke="{DynamicResource PrimaryBorderBrush}"
                                        StrokeThickness="1"
                                        InputTransparent="True">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="▾"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Kiểu số -->
                    <Border Style="{StaticResource SolverCardStyle}">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="3. Chọn kiểu số"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="IntegerNumberButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Numbers.Integer}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    Clicked="OnIntegerNumberClicked" />

                                <Button
                                    x:Name="DecimalNumberButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Numbers.Decimal}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    Clicked="OnDecimalNumberClicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Công thức kế thừa trực tiếp từ GeometryFormulaItem -->
                <Border
                    x:Name="FormulaPreviewBorder"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="12"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="8">

                        <Label
                            Grid.Row="0"
                            Text="Công thức và hình minh họa"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <!--
                            Bố cục này được đổi bằng code-behind:
                            - Màn hình rộng: hình minh họa bên trái, công thức bên phải.
                            - Màn hình hẹp: hai phần xếp dọc.
                        -->
                        <Grid
                            x:Name="FormulaPreviewContentGrid"
                            Grid.Row="1"
                            RowDefinitions="*"
                            ColumnDefinitions="5*,4*"
                            RowSpacing="8"
                            ColumnSpacing="10"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">

                            <Grid
                                x:Name="FormulaDiagramPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                RowDefinitions="Auto,*"
                                RowSpacing="6"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">

                                <Label
                                    Grid.Row="0"
                                    Text="{Binding SelectedGeometry.Name}"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{DynamicResource PrimaryColor}" />

                                <GraphicsView
                                    x:Name="GeometryDiagramView"
                                    Grid.Row="1"
                                    MinimumHeightRequest="170"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    SizeChanged="OnGeometryDiagramViewSizeChanged"
                                    BackgroundColor="Transparent" />

                            </Grid>

                            <Grid
                                x:Name="FormulaTextPanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                RowDefinitions="*,Auto,*"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">

                                <!--
                                    Công thức và chú thích tạo thành một cụm duy nhất,
                                    nằm giữa theo chiều dọc. Nội dung vẫn xếp lần lượt
                                    từ trên xuống như card ở tab Công thức > Hình học.
                                -->
                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Spacing="9"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center">

                                    <VerticalStackLayout
                                        Spacing="7"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Start"
                                        BindableLayout.ItemsSource="{Binding SelectedGeometry.Formulas}">

                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>

                                                <Border
                                                    Margin="0,2"
                                                    Padding="10,6"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Start"
                                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                    Stroke="{DynamicResource BorderBrush}"
                                                    StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding .}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        LineHeight="1.05"
                                                        LineBreakMode="WordWrap"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                                </Border>

                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                    <Border
                                        Padding="10,8"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Start"
                                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                                        Stroke="{DynamicResource PrimaryBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout
                                            Spacing="4"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            BindableLayout.ItemsSource="{Binding SelectedGeometry.Symbols}">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>

                                                    <Label
                                                        Text="{Binding .}"
                                                        FontSize="14"
                                                        FontAttributes="Italic"
                                                        LineHeight="1.05"
                                                        LineBreakMode="WordWrap"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>

                                        </VerticalStackLayout>

                                    </Border>

                                    <Border
                                        Padding="11,9"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Start"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource BorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="6">

                                            <Label
                                                Text="Tính chất chung"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{DynamicResource TextPrimaryColor}" />

                                            <VerticalStackLayout
                                                Spacing="5"
                                                BindableLayout.ItemsSource="{Binding SelectedGeometry.Properties}">

                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>

                                                        <Label
                                                            Text="{Binding ., StringFormat='• {0}'}"
                                                            FontSize="14"
                                                            LineHeight="1.15"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextSecondaryColor}" />

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>

                                            </VerticalStackLayout>

                                        </VerticalStackLayout>

                                    </Border>

                                </VerticalStackLayout>

                            </Grid>

                        </Grid>

                    </Grid>
                </Border>

            </Grid>

            <!-- 4. Kích thước -->
            <Border
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="4. Nhập kích thước"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Label
                        Text="Tất cả kích thước phải lớn hơn 0."
                        FontSize="15"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <FlexLayout
                        x:Name="GeometryInputFlexLayout"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Start"
                        AlignContent="Start"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start"
                        SizeChanged="OnGeometryInputFlexLayoutSizeChanged"
                        BindableLayout.ItemsSource="{Binding InputFields}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Margin="0,5"
                                    WidthRequest="260"
                                    MinimumHeightRequest="116"
                                    FlexLayout.Shrink="0"
                                    Padding="12"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="7">

                                        <Label
                                            Text="{Binding Label}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Border
                                            HeightRequest="48"
                                            Padding="10,0"
                                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                                            Stroke="{DynamicResource PrimaryBorderBrush}"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>

                                            <Entry
                                                Text="{Binding Text, Mode=TwoWay}"
                                                Placeholder="{Binding Placeholder}"
                                                PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                                Keyboard="Numeric"
                                                FontSize="18"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill"
                                                VerticalTextAlignment="Center"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource TextPrimaryColor}"
                                                ClearButtonVisibility="WhileEditing"
                                                Focused="OnGeometryEntryFocused"
                                                Unfocused="OnGeometryEntryUnfocused"
                                                TextChanged="OnGeometryEntryTextChanged" />

                                        </Border>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                    <!--
                        Hàng thao tác luôn chiếm toàn bộ bề rộng hữu dụng của
                        khung nhập và chia đều 50:50, độc lập với số cột dữ kiện.
                        FlexLayout phía trên tự tăng/giảm chiều cao theo số ô nên
                        hàng nút luôn được đẩy xuống ngay sau hàng dữ kiện cuối.
                    -->
                    <Grid
                        x:Name="GeometryActionGrid"
                        Margin="0,16,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="CalculateGeometryButton"
                            Grid.Column="0"
                            Text="{localization:Translate Actions.Calculate}"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            x:Name="ClearGeometryButton"
                            Grid.Column="1"
                            Text="{localization:Translate Actions.Clear}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource DividerColor}"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Lỗi -->
            <Border
                x:Name="ErrorBorder"
                IsVisible="False"
                Padding="12"
                BackgroundColor="{DynamicResource DangerSoftColor}"
                Stroke="{DynamicResource DangerBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="❌"
                        FontSize="20"
                        TextColor="{DynamicResource DangerColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                        <Label
                            Text="Dữ liệu không hợp lệ"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource DangerColor}" />

                        <Label
                            x:Name="ErrorLabel"
                            FontSize="16"
                            LineHeight="1.3"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource DangerColor}" />

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Kết quả -->
            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Kết quả"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Label
                        x:Name="ResultShapeLabel"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <VerticalStackLayout
                        Spacing="8"
                        BindableLayout.ItemsSource="{Binding Results}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Padding="12"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        ColumnDefinitions="*,Auto"
                                        RowSpacing="5"
                                        ColumnSpacing="12">

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding Value}"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="End"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding Formula}"
                                            FontSize="15"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextSecondaryColor}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <Grid HeightRequest="48">

                        <Button
                            x:Name="GeometryCopyResultButton"
                            Text="{localization:Translate PowerRoot.CopyResult}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource DividerColor}"
                            TextColor="Transparent"
                            Clicked="OnGeometryCopyResultClicked" />

                        <HorizontalStackLayout
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">

                            <controls:ThemedCopyIcon
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="{Binding Text, Source={x:Reference GeometryCopyResultButton}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                    <Border
                        Padding="11"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Cách tính"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="CalculationExplanationLabel"
                                FontSize="16"
                                LineHeight="1.35"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Lưu ý khi sử dụng -->
            <Border
    Padding="16"
    BackgroundColor="{DynamicResource WarningSoftColor}"
    Stroke="{DynamicResource WarningBorderBrush}"
    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
        ColumnDefinitions="Auto,*"
        ColumnSpacing="12">

                    <Label
            Grid.Column="0"
            Text="⚠"
            FontSize="26"
            VerticalOptions="Start"
            TextColor="{DynamicResource WarningColor}" />

                    <VerticalStackLayout
            Grid.Column="1"
            Spacing="6">

                        <Label
                Text="Lưu ý khi sử dụng"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{DynamicResource WarningColor}" />

                        <Label
                Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                FontSize="16"
                LineHeight="1.25"
                TextColor="{DynamicResource WarningColor}" />

                        <Label
                Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                FontSize="16"
                FontAttributes="Italic"
                LineHeight="1.25"
                TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</base:LocalizedSolverView>
