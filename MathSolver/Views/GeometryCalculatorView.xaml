<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.GeometryCalculatorView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">



    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Style="{StaticResource SolverContentStyle}">

            <!-- Tiêu đề -->
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="□  △  ○"
                    Style="{StaticResource SolverHeroSymbolStyle}"
                    FontAttributes="Bold"
                    />

                <Label
                    Text="HÌNH HỌC"
                    Style="{StaticResource SolverHeroTitleStyle}"
                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                <Label
                    Text="Tính chu vi, diện tích, diện tích bề mặt và thể tích"
                    Style="{StaticResource SolverHeroSubtitleStyle}"
                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

            </VerticalStackLayout>

            <!--
                Desktop/laptop/tablet lớn: bộ điều khiển nằm bên trái,
                công thức và hình minh họa nằm bên phải.
                Tablet nhỏ/điện thoại: tự chuyển thành một cột.
            -->
            <Grid
                x:Name="GeometryMainResponsiveGrid"
                RowDefinitions="Auto"
                ColumnDefinitions="5*,7*"
                RowSpacing="14"
                ColumnSpacing="14"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                SizeChanged="OnGeometryMainResponsiveGridSizeChanged">

                <VerticalStackLayout
                    x:Name="GeometryControlColumn"
                    Grid.Row="0"
                    Grid.Column="0"
                    Spacing="14"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">

                    <!-- 1. Phân loại hình học -->
                    <Border
                        Style="{StaticResource SolverCardStyle}">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="1. Chọn loại hình học"
                                Style="{StaticResource SolverSectionTitleStyle}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="*,*"
                                RowSpacing="{OnPlatform Android=10, WinUI=0, Default=0}"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="PlaneGeometryButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="{OnPlatform Android=2, WinUI=1, Default=1}"
                                    HorizontalOptions="Fill"
                                    Text="{localization:Translate Geometry.Plane}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    Clicked="OnPlaneGeometryClicked" />

                                <Button
                                    x:Name="SolidGeometryButton"
                                    Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                    Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                    Grid.ColumnSpan="{OnPlatform Android=2, WinUI=1, Default=1}"
                                    HorizontalOptions="Fill"
                                    Text="{localization:Translate Geometry.Solid}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    Clicked="OnSolidGeometryClicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. Chọn hình -->
                    <Border
                        x:Name="ShapeSelectorBorder"
                        Padding="16"
                        BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="2. Chọn hình"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Label
                                Text="Chọn một hình để xem công thức và nhập dữ liệu."
                                FontSize="16"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="GeometryShapePicker"
                                        HeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='12,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        TitleColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        ItemsSource="{Binding GeometryItems}"
                                        SelectedIndexChanged="OnGeometryShapeSelected"
                                        ItemDisplayBinding="{Binding Path=Name}" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource WallpaperTextPrimaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Kiểu số -->
                    <Border x:Name="NumberTypeBorder" Style="{StaticResource SolverCardStyle}">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="3. Chọn kiểu số"
                                Style="{StaticResource SolverSectionTitleStyle}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="IntegerNumberButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Numbers.Integer}"
                                    Style="{StaticResource SolverNumberTypeButtonStyle}"
                                    Clicked="OnIntegerNumberClicked" />

                                <Button
                                    x:Name="DecimalNumberButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Numbers.Decimal}"
                                    Style="{StaticResource SolverNumberTypeButtonStyle}"
                                    Clicked="OnDecimalNumberClicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Công thức kế thừa trực tiếp từ GeometryFormulaItem -->
                <Border
                    x:Name="FormulaPreviewBorder"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="12"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                    Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="8">

                        <Label
                            Grid.Row="0"
                            Text="Công thức và hình minh họa"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        <!--
                            Bố cục này được đổi bằng code-behind:
                            - Màn hình rộng: hình minh họa bên trái, công thức bên phải.
                            - Màn hình hẹp: hai phần xếp dọc.
                        -->
                        <Grid
                            x:Name="FormulaPreviewContentGrid"
                            Grid.Row="1"
                            RowDefinitions="*"
                            ColumnDefinitions="5*,4*"
                            RowSpacing="8"
                            ColumnSpacing="10"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">

                            <Grid
                                x:Name="FormulaDiagramPanel"
                                Grid.Row="0"
                                Grid.Column="0"
                                RowDefinitions="Auto,*"
                                RowSpacing="6"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">

                                <Label
                                    Grid.Row="0"
                                    Text="{Binding SelectedGeometry.Name}"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <GraphicsView
                                    x:Name="GeometryDiagramView"
                                    Grid.Row="1"
                                    MinimumHeightRequest="170"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    SizeChanged="OnGeometryDiagramViewSizeChanged"
                                    BackgroundColor="Transparent" />

                            </Grid>

                            <Grid
                                x:Name="FormulaTextPanel"
                                Grid.Row="0"
                                Grid.Column="1"
                                RowDefinitions="*,Auto,*"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">

                                <!--
                                    Công thức và chú thích tạo thành một cụm duy nhất,
                                    nằm giữa theo chiều dọc. Nội dung vẫn xếp lần lượt
                                    từ trên xuống như card ở tab Công thức > Hình học.
                                -->
                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Spacing="9"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center">

                                    <VerticalStackLayout
                                        Spacing="7"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Start"
                                        BindableLayout.ItemsSource="{Binding SelectedGeometry.Formulas}">

                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>

                                                <Border
                                                    Margin="0,2"
                                                    Padding="10,6"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Start"
                                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                                    StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding .}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        LineHeight="1.05"
                                                        LineBreakMode="WordWrap"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                </Border>

                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                    <Border
                                        Padding="10,8"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Start"
                                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout
                                            Spacing="4"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            BindableLayout.ItemsSource="{Binding SelectedGeometry.Symbols}">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>

                                                    <Label
                                                        Text="{Binding .}"
                                                        FontSize="14"
                                                        FontAttributes="Italic"
                                                        LineHeight="1.05"
                                                        LineBreakMode="WordWrap"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>

                                        </VerticalStackLayout>

                                    </Border>

                                    <Border
                                        Padding="11,9"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Start"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="6">

                                            <Label
                                                Text="Tính chất chung"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                            <VerticalStackLayout
                                                Spacing="5"
                                                BindableLayout.ItemsSource="{Binding SelectedGeometry.Properties}">

                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>

                                                        <Label
                                                            Text="{Binding ., StringFormat='• {0}'}"
                                                            FontSize="14"
                                                            LineHeight="1.15"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>

                                            </VerticalStackLayout>

                                        </VerticalStackLayout>

                                    </Border>

                                </VerticalStackLayout>

                            </Grid>

                        </Grid>

                    </Grid>
                </Border>

            </Grid>

            <!-- 4. Kích thước -->
            <Border
                x:Name="InputFieldsBorder"
                Padding="14"
                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                Stroke="{DynamicResource WallpaperBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="4. Nhập kích thước"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                    <Label
                        Text="Tất cả kích thước phải lớn hơn 0."
                        FontSize="15"
                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                    <FlexLayout
                        x:Name="GeometryInputFlexLayout"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Start"
                        AlignContent="Start"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start"
                        SizeChanged="OnGeometryInputFlexLayoutSizeChanged"
                        BindableLayout.ItemsSource="{Binding InputFields}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Margin="0,5"
                                    WidthRequest="260"
                                    MinimumHeightRequest="116"
                                    FlexLayout.Shrink="0"
                                    Padding="12"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="7">

                                        <Label
                                            Text="{Binding Label}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                        <Border
                                            HeightRequest="48"
                                            Padding="10,0"
                                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                            Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>

                                            <Entry
                                                Text="{Binding Text, Mode=TwoWay}"
                                                Placeholder="{Binding Placeholder}"
                                                PlaceholderColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                Keyboard="Numeric"
                                                FontSize="18"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill"
                                                VerticalTextAlignment="Center"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                ClearButtonVisibility="WhileEditing"
                                                Focused="OnGeometryEntryFocused"
                                                Unfocused="OnGeometryEntryUnfocused"
                                                TextChanged="OnGeometryEntryTextChanged" />

                                        </Border>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                    <!--
                        Hàng thao tác luôn chiếm toàn bộ bề rộng hữu dụng của
                        khung nhập và chia đều 50:50, độc lập với số cột dữ kiện.
                        FlexLayout phía trên tự tăng/giảm chiều cao theo số ô nên
                        hàng nút luôn được đẩy xuống ngay sau hàng dữ kiện cuối.
                    -->
                    <Grid
                        x:Name="GeometryActionGrid"
                        Margin="0,16,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="CalculateGeometryButton"
                            Grid.Column="0"
                            Text="{localization:Translate Actions.Calculate}"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            x:Name="ClearGeometryButton"
                            Grid.Column="1"
                            Text="{localization:Translate Actions.Clear}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                            BorderColor="{DynamicResource WallpaperBorderColor}"
                            BorderWidth="1"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Lỗi -->
            <Border
                x:Name="ErrorBorder"
                IsVisible="False"
                Padding="12"
                BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                Stroke="{DynamicResource DangerBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="❌"
                        FontSize="20"
                        TextColor="{DynamicResource DangerColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                        <Label
                            Text="Dữ liệu không hợp lệ"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource DangerColor}" />

                        <Label
                            x:Name="ErrorLabel"
                            FontSize="16"
                            LineHeight="1.3"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource DangerColor}" />

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Kết quả -->
            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Kết quả"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Label
                        x:Name="ResultShapeLabel"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                    <VerticalStackLayout
                        Spacing="8"
                        BindableLayout.ItemsSource="{Binding Results}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Padding="12"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Grid
                                        RowDefinitions="Auto,Auto"
                                        ColumnDefinitions="*,Auto"
                                        RowSpacing="5"
                                        ColumnSpacing="12">

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{Binding Title}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding Value}"
                                            FontSize="19"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="End"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding Formula}"
                                            FontSize="15"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <Grid HeightRequest="48">

                        <Button
                            x:Name="GeometryCopyResultButton"
                            Text="{localization:Translate PowerRoot.CopyResult}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource WallpaperDividerColor}"
                            TextColor="Transparent"
                            Clicked="OnGeometryCopyResultClicked" />

                        <HorizontalStackLayout
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">

                            <controls:ThemedCopyIcon
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="{Binding Text, Source={x:Reference GeometryCopyResultButton}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                    <Border
                        Padding="11"
                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Cách tính"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="CalculationExplanationLabel"
                                FontSize="16"
                                LineHeight="1.35"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>
            </Border>
</VerticalStackLayout>
    </ScrollView>
</base:LocalizedSolverView>
