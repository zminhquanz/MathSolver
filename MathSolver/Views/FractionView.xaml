<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.FractionView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:models="clr-namespace:MathSolver.Models"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <!-- FractionView tự quản lý vùng cuộn.
         Không bọc thêm ScrollView tại CalculationPage. -->
    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <VerticalStackLayout
            x:Name="FractionContent"
            Style="{StaticResource SolverContentStyle}">

            <!-- Tiêu đề đồng bộ với tab Cơ bản -->
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="½  + − × ÷"
                    Style="{StaticResource SolverHeroSymbolStyle}" />

                <Label
                    x:Name="FractionPageTitle"
                    Text="PHÉP TÍNH PHÂN SỐ"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    x:Name="FractionPageSubtitle"
                    Text="Cộng • Trừ • Nhân • Chia • Quy đồng"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <!-- 1. Chọn phép tính -->
            <Border
                Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="1. Chọn phép tính"
                        Style="{StaticResource SolverSectionTitleStyle}" />

                    <Grid
                        x:Name="OperationButtonsGrid"
                        ColumnDefinitions="*,*,*,*,1.35*"
                        RowDefinitions="Auto"
                        ColumnSpacing="8"
                        RowSpacing="8">

                        <Button
                            x:Name="AddButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="+"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnAddClicked" />

                        <Button
                            x:Name="SubtractButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="−"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnSubtractClicked" />

                        <Button
                            x:Name="MultiplyButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            Text="×"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnMultiplyClicked" />

                        <Button
                            x:Name="DivideButton"
                            Grid.Row="0"
                            Grid.Column="3"
                            Text="÷"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnDivideClicked" />

                        <Button
                            x:Name="CommonDenominatorButton"
                            Grid.Row="0"
                            Grid.Column="4"
                            Text="Quy đồng"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Padding="10,0"
                            CornerRadius="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnCommonDenominatorClicked" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- 2. Nhập hai phân số -->
            <Border
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="2. Nhập các phân số"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />


                    <Grid
                        x:Name="FractionInputGrid"
                        ColumnDefinitions="*,64,*"
                        RowDefinitions="Auto"
                        ColumnSpacing="12"
                        RowSpacing="10">

                        <!-- Phân số thứ nhất -->
                        <Border
                            x:Name="FirstFractionCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Phân số thứ nhất"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    HeightRequest="46"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="FirstNumeratorEntry"
                                        PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                        Placeholder="Tử số"
                                        Keyboard="Numeric"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}" 
                                        TextChanged="OnNumberEntryTextChanged" />
                                </Border>

                                <BoxView
                                    HeightRequest="2"
                                    Margin="8,1"
                                    BackgroundColor="{DynamicResource PrimaryColor}" />

                                <Border
                                    HeightRequest="46"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="FirstDenominatorEntry"
                                        PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                        Placeholder="Mẫu số"
                                        Keyboard="Numeric"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}" 
                                        TextChanged="OnNumberEntryTextChanged" />
                                </Border>

                            </VerticalStackLayout>
                        </Border>

                        <!-- Dấu phép tính -->
                        <Label
                            x:Name="OperatorLabel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="+"
                            FontSize="32"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />

                        <!-- Phân số thứ hai -->
                        <Border
                            x:Name="SecondFractionCard"
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Phân số thứ hai"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border
                                    HeightRequest="46"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="SecondNumeratorEntry"
                                        Placeholder="Tử số"
                                        PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                        Keyboard="Numeric"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}" 
                                        TextChanged="OnNumberEntryTextChanged" />
                                </Border>

                                <BoxView
                                    HeightRequest="2"
                                    Margin="8,1"
                                    BackgroundColor="{DynamicResource PrimaryColor}" />

                                <Border
                                    HeightRequest="46"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="SecondDenominatorEntry"
                                        PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                        Placeholder="Mẫu số"
                                        Keyboard="Numeric"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}" 
                                        TextChanged="OnNumberEntryTextChanged" />
                                </Border>

                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <Grid
                        x:Name="ActionButtonsGrid"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto"
                        ColumnSpacing="10"
                        RowSpacing="8">

                        <Button
                            x:Name="CalculateButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Tính toán"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            x:Name="ClearButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Xóa"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource DividerColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Thông báo lỗi, tách riêng giống CalculationPage -->
            <Border
                x:Name="ErrorBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource DangerSoftColor}"
                Stroke="{DynamicResource DangerBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                
                <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
                    
                    <Label
                    Grid.Column="0"
                    Text="!"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource DangerColor}" />

                    <Label
                    Grid.Column="1"
                    x:Name="ErrorLabel"
                    FontSize="17"
                    TextColor="{DynamicResource DangerColor}"
                    LineBreakMode="WordWrap" />
                    
                </Grid>
            </Border>

            <!-- 3. Kết quả -->
            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="3. Kết quả"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <controls:FractionExpressionView
                        x:Name="FullExpressionMathView"
                        MathFontSize="23"
                        MathColor="{DynamicResource PrimaryColor}"
                        HorizontalOptions="Center" />

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{DynamicResource DividerColor}" />

                    <Label
                        Text="Đáp số"
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <controls:FractionExpressionView
                        x:Name="AnswerMathView"
                        MathFontSize="32"
                        MathColor="{DynamicResource TextPrimaryColor}"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="FractionCopyResultButton"
                        Text="{localization:Translate PowerRoot.CopyResult}"
                        HeightRequest="48"
                        CornerRadius="12"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="{DynamicResource DividerColor}"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        Clicked="OnFractionCopyResultClicked" />

                    <!-- Lời giải chi tiết -->
                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="Lời giải"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Source={x:Reference Root}, Path=SolutionSteps}"
                                Spacing="10">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FractionSolutionStep">

                                        <Border
                                            Padding="12"
                                            BackgroundColor="{DynamicResource SurfaceColor}"
                                            Stroke="{DynamicResource BorderBrush}"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="8">

                                                <Label
                                                    Text="{Binding Title}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource PrimaryColor}" />

                                                <Label
                                                    Text="{Binding Description}"
                                                    FontSize="16"
                                                    LineHeight="1.25"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource TextPrimaryColor}">

                                                    <Label.Triggers>
                                                        <DataTrigger
                                                            TargetType="Label"
                                                            Binding="{Binding Description}"
                                                            Value="">
                                                            <Setter
                                                                Property="IsVisible"
                                                                Value="False" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <VerticalStackLayout
                                                    BindableLayout.ItemsSource="{Binding MathLines}"
                                                    Spacing="8">

                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <controls:FractionExpressionView
                                                                Expression="{Binding .}"
                                                                MathFontSize="19"
                                                                MathColor="{DynamicResource TextPrimaryColor}"
                                                                HorizontalOptions="Start" />
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>

                                            </VerticalStackLayout>
                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Lưu ý khi sử dụng -->
            <Border
                Padding="16"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="⚠"
                        FontSize="26"
                        VerticalOptions="Start"
                        TextColor="{DynamicResource WarningColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Lưu ý khi sử dụng"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                            FontSize="16"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                            FontSize="16"
                            FontAttributes="Italic"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</base:LocalizedSolverView>
