<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MathSolver.Views.FractionView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MathSolver.Models"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent">

    <!-- FractionView tự quản lý vùng cuộn.
         Không bọc nó trong ScrollView ở CalculationPage. -->
    <ScrollView>
        <VerticalStackLayout
            Padding="14,4,14,18"
            Spacing="12"
            HorizontalOptions="Center"
            MaximumWidthRequest="1000">

            <VerticalStackLayout Spacing="2" Margin="0,4,0,6">

                <Label
                Text="½"
                FontSize="42"
                HorizontalTextAlignment="Center"
                TextColor="#6D28D9" />

                <Label
                    Text="PHÂN SỐ"
                    FontSize="25"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="#1E293B" />

                <Label
                    Text="Cộng, trừ, nhân, chia, và rút gọn phân số"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    TextColor="#64748B" />

            </VerticalStackLayout>
            <!-- Khung chọn phép tính -->
            <Border
            Padding="14"
            BackgroundColor="White"
            Stroke="#D7E2EE"
            StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Label
                    Text="1. Chọn phép tính"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#334155" />

                    <Grid
                    ColumnDefinitions="*,*,*,*,1.4*"
                    ColumnSpacing="8">

                        <Button
                        x:Name="AddButton"
                        Grid.Column="0"
                        Text="+"
                        FontSize="20"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="9"
                        Clicked="OnAddClicked" />

                        <Button
                        x:Name="SubtractButton"
                        Grid.Column="1"
                        Text="−"
                        FontSize="20"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="9"
                        Clicked="OnSubtractClicked" />

                        <Button
                        x:Name="MultiplyButton"
                        Grid.Column="2"
                        Text="×"
                        FontSize="20"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="9"
                        Clicked="OnMultiplyClicked" />

                        <Button
                        x:Name="DivideButton"
                        Grid.Column="3"
                        Text="÷"
                        FontSize="20"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="9"
                        Clicked="OnDivideClicked" />

                        <Button
                        x:Name="CommonDenominatorButton"
                        Grid.Column="4"
                        Text="Quy đồng"
                        FontSize="14"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="9"
                        Clicked="OnCommonDenominatorClicked" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Khung nhập hai phân số -->
            <Border
                Padding="16"
                BackgroundColor="White"
                Stroke="#DDD6FE"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                     Text="2. Nhập phân số"
                     FontSize="18"
                     FontAttributes="Bold"
                     TextColor="#263B50" />

                    <Grid
                    x:Name="FractionInputGrid"
                    ColumnDefinitions="*,54,*"
                    ColumnSpacing="12">

                        <Border
                        x:Name="FirstFractionCard"
                        Grid.Column="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="7">

                                <Label
                                    Text="Phân số thứ nhất"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#334155" />

                                <Entry
                                    x:Name="FirstNumeratorEntry"
                                    TextColor="#172033"
                                    Placeholder="Tử số"
                                    Keyboard="Numeric"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center" />

                                <BoxView
                                    HeightRequest="2"
                                    BackgroundColor="#6D28D9" />

                                <Entry
                                    x:Name="FirstDenominatorEntry"
                                    TextColor="#172033"
                                    Placeholder="Mẫu số"
                                    Keyboard="Numeric"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <Label
                        x:Name="OperatorLabel"
                        Grid.Column="1"
                        Text="+"
                        FontSize="30"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        TextColor="#2563EB" />

                        <Border
                        x:Name="SecondFractionCard"
                        Grid.Column="2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="7">

                                <Label
                                    Text="Phân số thứ hai"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#334155" />

                                <Entry
                                    x:Name="SecondNumeratorEntry"
                                    TextColor="#172033"
                                    Placeholder="Tử số"
                                    Keyboard="Numeric"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center" />

                                <BoxView
                                    HeightRequest="2"
                                    BackgroundColor="#6D28D9" />

                                <Entry
                                    x:Name="SecondDenominatorEntry"
                                    TextColor="#172033"
                                    Placeholder="Mẫu số"
                                    Keyboard="Numeric"
                                    FontSize="18"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Tính kết quả và trình bày lời giải"
                            HeightRequest="46"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            BackgroundColor="#6D28D9"
                            TextColor="White"
                            Clicked="OnCalculateClicked" />

                        <Button
                            Grid.Column="1"
                            Text="Xóa"
                            HeightRequest="46"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            BackgroundColor="#E2E8F0"
                            TextColor="#334155"
                            Clicked="OnClearClicked" />

                    </Grid>

                    <Border
                        x:Name="ErrorBorder"
                        IsVisible="False"
                        Padding="11"
                        BackgroundColor="#FEF2F2"
                        Stroke="#FCA5A5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="ErrorLabel"
                            FontAttributes="Bold"
                            TextColor="#B91C1C"
                            LineBreakMode="WordWrap" />

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- Kết quả -->
            <Border
    x:Name="ResultBorder"
    IsVisible="False"
    Padding="14"
    BackgroundColor="White"
    Stroke="#BFDBFE"
    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <!-- Tiêu đề -->
                    <Label
            Text="3. Kết quả"
            FontSize="16"
            FontAttributes="Bold"
            TextColor="#334155" />

                    <!-- Biểu thức đầy đủ -->
                    <controls:FractionExpressionView
            x:Name="FullExpressionMathView"
            MathFontSize="18"
            MathColor="#2563EB"
            HorizontalOptions="Center" />

                    <BoxView
            HeightRequest="1"
            BackgroundColor="#E2E8F0" />

                    <!-- Đáp số -->
                    <Label
            Text="Đáp số"
            FontSize="13"
            HorizontalTextAlignment="Center"
            TextColor="#64748B" />

                    <controls:FractionExpressionView
            x:Name="AnswerMathView"
            MathFontSize="24"
            MathColor="#15803D"
            HorizontalOptions="Center" />

                    <!-- Lời giải -->
                    <Border
            Padding="12"
            BackgroundColor="#EFF6FF"
            Stroke="#BFDBFE"
            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">

                            <Label
                    Text="Lời giải chi tiết"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1D4ED8" />

                            <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Source={x:Reference Root}, Path=SolutionSteps}"
                    Spacing="9">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FractionSolutionStep">

                                        <Border
                                Padding="12"
                                BackgroundColor="White"
                                Stroke="#D8E2EF">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="8">

                                                <Label
                                        Text="{Binding Title}"
                                        FontAttributes="Bold"
                                        TextColor="#6D28D9" />

                                                <Label
                                        Text="{Binding Description}"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        TextColor="#475569">

                                                    <Label.Triggers>
                                                        <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Description}"
                                                Value="">

                                                            <Setter
                                                    Property="IsVisible"
                                                    Value="False" />

                                                        </DataTrigger>
                                                    </Label.Triggers>

                                                </Label>

                                                <VerticalStackLayout
                                                BindableLayout.ItemsSource="{Binding MathLines}"
                                                Spacing="8">

                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">

                                                            <controls:FractionExpressionView
                                                            Expression="{Binding .}"
                                                            MathFontSize="16"
                                                            MathColor="#334155"
                                                            HorizontalOptions="Start" />

                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>

                                                </VerticalStackLayout>

                                            </VerticalStackLayout>

                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>
            <!-- Lưu ý khi sử dụng -->
            <Border
            Padding="16"
            BackgroundColor="#FFF7ED"
            Stroke="#FDBA74"
            StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                    <Label
                    Grid.Column="0"
                    Text="⚠"
                    FontSize="24"
                    VerticalOptions="Start"
                    TextColor="#EA580C" />

                    <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="6">

                        <Label
                        Text="Lưu ý khi sử dụng"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#9A3412" />

                        <Label
                        Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                        FontSize="14"
                        LineHeight="1.25"
                        TextColor="#7C2D12" />

                        <Label
                        Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                        FontSize="14"
                        FontAttributes="Italic"
                        LineHeight="1.25"
                        TextColor="#9A3412" />

                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
