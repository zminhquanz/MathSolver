<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="{localization:Translate About.PageTitle}"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <!-- Ẩn nút Back mặc định để dùng cùng thanh tiêu đề tùy chỉnh
         với HardwarePerformancePage. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <!-- Thanh tiêu đề riêng nên không hiển thị nút Settings bên phải. -->
    <Shell.TitleView>
        <Grid
            Padding="{OnPlatform Android='0,0,4,0', WinUI='0,0,8,0', Default='0,0,8,0'}"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">

            <Button
                x:Name="AboutBackButton"
                controls:InteractiveButtonAnimation.IsScopeEnabled="True"
                Grid.Column="0"
                Text="‹"
                WidthRequest="40"
                HeightRequest="40"
                MinimumWidthRequest="40"
                MinimumHeightRequest="40"
                Padding="0"
                CornerRadius="20"
                FontSize="28"
                FontAttributes="Bold"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextPrimaryColor}"
                SemanticProperties.Description="{localization:Translate About.Back.Accessibility}"
                Clicked="OnCloseClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                VerticalOptions="Center">

                <Label
                    x:Name="AboutTitleLabel"
                    Text="{localization:Translate About.HeaderTitle}"
                    TranslationY="{OnPlatform Android=2, WinUI=0, Default=0}"
                    FontSize="19"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    x:Name="AboutSubtitleLabel"
                    Text="{localization:Translate About.Subtitle}"
                    IsVisible="{OnPlatform Android=False, WinUI=True, Default=True}"
                    FontSize="11"
                    LineBreakMode="TailTruncation"
                    TextColor="{DynamicResource TextSecondaryColor}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid x:Name="AboutPageContentRoot">
        <ScrollView>
            <VerticalStackLayout
            Padding="{OnPlatform Android='12,12,12,20', WinUI='20,22,20,30', Default='20,22,20,30'}"
            Spacing="16"
            MaximumWidthRequest="760"
            HorizontalOptions="Center">

            <!-- App identity -->
            <Border
                Padding="{OnPlatform Android=16, WinUI=22, Default=22}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="{OnPlatform Android='*', WinUI='Auto,*', Default='Auto,*'}"
                    RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                    ColumnSpacing="20"
                    RowSpacing="10">

                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Source="splashicon.png"
                        WidthRequest="{OnPlatform Android=72, WinUI=96, Default=96}"
                        HeightRequest="{OnPlatform Android=72, WinUI=96, Default=96}"
                        Aspect="AspectFit"
                        HorizontalOptions="{OnPlatform Android=Center, WinUI=Fill, Default=Fill}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{localization:Translate About.AppIcon.Accessibility}" />

                    <VerticalStackLayout
                        Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                        Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                        Spacing="5"
                        VerticalOptions="Center">

                        <Label
                            x:Name="AppNameLabel"
                            Text="{localization:Translate App.Title}"
                            FontSize="{OnPlatform Android=24, WinUI=30, Default=30}"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            HorizontalTextAlignment="{OnPlatform Android=Center, WinUI=Start, Default=Start}"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="VersionHeaderLabel"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="{OnPlatform Android=Center, WinUI=Start, Default=Start}"
                            TextColor="{DynamicResource PrimaryColor}" />

                        <Label
                            x:Name="AppDescriptionLabel"
                            Text="{localization:Translate About.Description}"
                            FontSize="14"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap"
                            HorizontalTextAlignment="{OnPlatform Android=Center, WinUI=Start, Default=Start}"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Application information -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Label
                        x:Name="InformationTitleLabel"
                        Text="{localization:Translate About.InformationTitle}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Grid
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnDefinitions="{OnPlatform Android='105,*', WinUI='150,*', Default='150,*'}"
                        RowSpacing="12"
                        ColumnSpacing="{OnPlatform Android=10, WinUI=16, Default=16}">

                        <Label
                            x:Name="AuthorCaptionLabel"
                            Text="{localization:Translate About.AuthorLabel}"
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{localization:Translate About.AuthorValue}"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="VersionCaptionLabel"
                            Text="{localization:Translate About.VersionLabel}"
                            Grid.Row="1"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Label
                            x:Name="VersionValueLabel"
                            Grid.Row="1"
                            Grid.Column="1"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="CopyrightCaptionLabel"
                            Text="{localization:Translate About.CopyrightLabel}"
                            Grid.Row="2"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{localization:Translate About.CopyrightValue}"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="LicenseCaptionLabel"
                            Text="{localization:Translate About.LicenseLabel}"
                            Grid.Row="3"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{localization:Translate About.LicenseValue}"
                            TextColor="{DynamicResource TextPrimaryColor}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Project links -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <!-- Canh trái giống tiêu đề Thông tin ứng dụng. -->
                    <Label
                        x:Name="LinksTitleLabel"
                        Text="{localization:Translate About.LinksTitle}"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Start"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <!-- Hai biểu tượng vẫn nằm giữa card. -->
                    <HorizontalStackLayout
                        Spacing="16"
                        HorizontalOptions="Center">

                            <ImageButton
                            x:Name="GitHubButton"
                            WidthRequest="{OnPlatform Android=56, WinUI=64, Default=64}"
                            HeightRequest="{OnPlatform Android=56, WinUI=64, Default=64}"
                            Padding="5"
                            BackgroundColor="Transparent"
                            Source="github_black_clearspace.png"
                            SemanticProperties.Description="{localization:Translate About.GitHub.Accessibility}"
                            ToolTipProperties.Text="{localization:Translate About.GitHub.Accessibility}">
                                <ImageButton.Behaviors>
                                    <toolkit:IconTintColorBehavior x:Name="GitHubIconTintBehavior" />
                                </ImageButton.Behaviors>
                            </ImageButton>

                            <ImageButton
                            x:Name="KoFiButton"
                            WidthRequest="{OnPlatform Android=56, WinUI=64, Default=64}"
                            HeightRequest="{OnPlatform Android=56, WinUI=64, Default=64}"
                            Padding="5"
                            BackgroundColor="Transparent"
                            Source="kofi_symbol.png"
                            SemanticProperties.Description="{localization:Translate About.KoFi.Accessibility}"
                            ToolTipProperties.Text="{localization:Translate About.KoFi.Accessibility}"
                            Clicked="OnKoFiClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
