<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MathSolver.Views.ProportionFormulaView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Padding="20,16,20,28"
            Spacing="14"
            HorizontalOptions="Fill">

            <VerticalStackLayout
                Margin="0,4,0,6"
                Spacing="2">

                <Label
                    Text="↗  ↘  ⤢"
                    FontSize="40"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource PrimaryColor}" />

                <Label
                    Text="{localization:Translate Formula.Proportion.Title}"
                    FontSize="27"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="{localization:Translate Formula.Proportion.Subtitle}"
                    FontSize="17"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextSecondaryColor}" />

            </VerticalStackLayout>

            <!-- 1. Mối quan hệ -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.Relationship}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Grid
                        x:Name="RelationshipGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Border
                            x:Name="DirectRelationshipCard"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="7">
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Direct.Title}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Direct.Relationship}"
                                    FontSize="16"
                                    LineHeight="1.25"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    Text="y = k × x"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="InverseRelationshipCard"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="7">
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Inverse.Title}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Inverse.Relationship}"
                                    FontSize="16"
                                    LineHeight="1.25"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    Text="y = k ÷ x"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="11" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="7">
                            <Label
                                Text="{localization:Translate Formula.Proportion.Compound.Title}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                Text="{localization:Translate Formula.Proportion.Compound.Relationship}"
                                FontSize="16"
                                LineHeight="1.25"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                            <Label
                                Text="D₂ = D₁ × (Q₂ ÷ Q₁) × (W₁ ÷ W₂) × (H₁ ÷ H₂)"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Minh họa tương tác -->
            <Border
                x:Name="InteractiveSectionBorder"
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Proportion.Graph.Title}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Proportion.Graph.Subtitle}"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button
                            x:Name="SingleModeButton"
                            Grid.Column="0"
                            HeightRequest="42"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            Text="{localization:Translate Formula.Proportion.Mode.Single}"
                            Clicked="OnSingleModeClicked" />
                        <Button
                            x:Name="CompoundModeButton"
                            Grid.Column="1"
                            HeightRequest="42"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            Text="{localization:Translate Formula.Proportion.Mode.Compound}"
                            Clicked="OnCompoundModeClicked" />
                    </Grid>

                    <Grid
                        x:Name="SingleInteractiveGrid"
                        ColumnDefinitions="3*,7*"
                        ColumnSpacing="16">

                        <Border
                            x:Name="InteractiveExplanationPanel"
                            Grid.Column="0"
                            Padding="16"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Text="y = 2x     y = 2 ÷ x"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource PrimaryBorderColor}" />
                                <Label
                                    x:Name="GraphXValueLabel"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label
                                    x:Name="GraphDirectValueLabel"
                                    FontSize="16"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    x:Name="GraphInverseValueLabel"
                                    FontSize="16"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Graph.SliderHint}"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                <Border
                                    HeightRequest="50"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Slider
                                        x:Name="ProportionXSlider"
                                        HeightRequest="38"
                                        Minimum="0.5"
                                        Maximum="2.5"
                                        Value="0.5"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        MaximumTrackColor="{DynamicResource PrimaryBorderColor}"
                                        ThumbColor="{DynamicResource PrimaryColor}"
                                        ValueChanged="OnProportionXSliderValueChanged" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="InteractiveGraphPanel"
                            Grid.Column="1"
                            Padding="8"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <GraphicsView
                                x:Name="ProportionGraphicsView"
                                MinimumHeightRequest="360"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="CompoundInteractiveGrid"
                        IsVisible="False"
                        ColumnDefinitions="3*,7*"
                        ColumnSpacing="16">

                        <Border
                            x:Name="CompoundExplanationPanel"
                            Grid.Column="0"
                            Padding="16"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Compound.Title}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Compound.InteractiveFormula}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <BoxView HeightRequest="1" Color="{DynamicResource PrimaryBorderColor}" />

                                <Label x:Name="CompoundProductValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Border
                                    HeightRequest="50"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Slider
                                        x:Name="CompoundProductSlider"
                                        HeightRequest="38"
                                        Minimum="60"
                                        Maximum="300"
                                        Value="240"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        MaximumTrackColor="{DynamicResource PrimaryBorderColor}"
                                        ThumbColor="{DynamicResource PrimaryColor}"
                                        ValueChanged="OnCompoundSliderValueChanged" />
                                </Border>

                                <Label x:Name="CompoundWorkersValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Border
                                    HeightRequest="50"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Slider
                                        x:Name="CompoundWorkersSlider"
                                        HeightRequest="38"
                                        Minimum="2"
                                        Maximum="10"
                                        Value="6"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        MaximumTrackColor="{DynamicResource PrimaryBorderColor}"
                                        ThumbColor="{DynamicResource PrimaryColor}"
                                        ValueChanged="OnCompoundSliderValueChanged" />
                                </Border>

                                <Label x:Name="CompoundHoursValueLabel" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Border
                                    HeightRequest="50"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Slider
                                        x:Name="CompoundHoursSlider"
                                        HeightRequest="38"
                                        Minimum="4"
                                        Maximum="10"
                                        Value="8"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        MinimumTrackColor="{DynamicResource PrimaryColor}"
                                        MaximumTrackColor="{DynamicResource PrimaryBorderColor}"
                                        ThumbColor="{DynamicResource PrimaryColor}"
                                        ValueChanged="OnCompoundSliderValueChanged" />
                                </Border>

                                <Border
                                    Padding="12"
                                    BackgroundColor="{DynamicResource SurfaceColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            x:Name="CompoundDaysValueLabel"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="Center"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                        <Label
                                            Text="{localization:Translate Formula.Proportion.Compound.InteractiveHint}"
                                            FontSize="14"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="CompoundGraphPanel"
                            Grid.Column="1"
                            Padding="8"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <GraphicsView
                                x:Name="CompoundGraphicsView"
                                MinimumHeightRequest="360"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 2. Công thức -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.Formulas}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Border
                        Padding="14,11"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label
                            Text="{localization:Translate Formula.Proportion.Direct.Formulas}"
                            FontSize="17"
                            FontAttributes="Bold"
                            LineHeight="1.35"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />
                    </Border>

                    <Border
                        Padding="14,11"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label
                            Text="{localization:Translate Formula.Proportion.Inverse.Formulas}"
                            FontSize="17"
                            FontAttributes="Bold"
                            LineHeight="1.35"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />
                    </Border>

                    <Border
                        Padding="14,11"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label
                            Text="{localization:Translate Formula.Proportion.Compound.Formulas}"
                            FontSize="17"
                            FontAttributes="Bold"
                            LineHeight="1.35"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />
                    </Border>

                    <Label
                        Text="{localization:Translate Formula.Proportion.Conditions}"
                        FontSize="15"
                        FontAttributes="Italic"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Tính chất -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="{localization:Translate Formula.Common.Properties}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Proportion.Direct.Properties}"
                        FontSize="17"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Proportion.Inverse.Properties}"
                        FontSize="17"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Proportion.Compound.Properties}"
                        FontSize="17"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Proportion.GraphProperties}"
                        FontSize="17"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- 4. Cách giải -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.HowToSolve}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Proportion.Steps}"
                        FontSize="17"
                        LineHeight="1.35"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Grid
                        x:Name="ExamplesGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">
                        <Border
                            x:Name="DirectExampleCard"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Direct.ExampleTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />

                                <Border
                                    Padding="12"
                                    BackgroundColor="{DynamicResource SurfaceColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label
                                                Text="{localization:Translate Formula.Proportion.Summary.Title}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextDecorations="Underline"
                                                TextColor="{DynamicResource PrimaryColor}" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{localization:Translate Formula.Proportion.Direct.Method}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="End"
                                                TextColor="{DynamicResource PrimaryColor}" />
                                        </Grid>

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            RowDefinitions="Auto,Auto"
                                            RowSpacing="7"
                                            ColumnSpacing="10">
                                            <Label Grid.Row="0" Grid.Column="0" Text="{localization:Translate Formula.Proportion.Direct.LeftTop}" FontSize="16" TextColor="{DynamicResource TextPrimaryColor}" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{localization:Translate Formula.Proportion.Direct.RightTop}" FontSize="16" HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimaryColor}" />
                                            <Label Grid.Row="1" Grid.Column="0" Text="{localization:Translate Formula.Proportion.Direct.LeftBottom}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{localization:Translate Formula.Proportion.Direct.RightBottom}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource PrimaryColor}" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{DynamicResource PrimaryBorderColor}" />
                                        <Label Text="{localization:Translate Formula.Proportion.Direct.Calculation}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Label Text="{localization:Translate Formula.Proportion.Summary.Solution}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextSecondaryColor}" />
                                <Label Text="{localization:Translate Formula.Proportion.Direct.Example}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="InverseExampleCard"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{localization:Translate Formula.Proportion.Inverse.ExampleTitle}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />

                                <Border Padding="12" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label Text="{localization:Translate Formula.Proportion.Summary.Title}" FontSize="15" FontAttributes="Bold" TextDecorations="Underline" TextColor="{DynamicResource PrimaryColor}" />
                                            <Label Grid.Column="1" Text="{localization:Translate Formula.Proportion.Inverse.Method}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource PrimaryColor}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="7" ColumnSpacing="10">
                                            <Label Grid.Row="0" Grid.Column="0" Text="{localization:Translate Formula.Proportion.Inverse.LeftTop}" FontSize="16" TextColor="{DynamicResource TextPrimaryColor}" />
                                            <Label Grid.Row="0" Grid.Column="1" Text="{localization:Translate Formula.Proportion.Inverse.RightTop}" FontSize="16" HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimaryColor}" />
                                            <Label Grid.Row="1" Grid.Column="0" Text="{localization:Translate Formula.Proportion.Inverse.LeftBottom}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{localization:Translate Formula.Proportion.Inverse.RightBottom}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource PrimaryColor}" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                                        <Label Text="{localization:Translate Formula.Proportion.Inverse.Calculation}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Label Text="{localization:Translate Formula.Proportion.Summary.Solution}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextSecondaryColor}" />
                                <Label Text="{localization:Translate Formula.Proportion.Inverse.Example}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="{localization:Translate Formula.Proportion.Compound.ExampleTitle}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                Text="{localization:Translate Formula.Proportion.Compound.ExampleSummary}"
                                FontSize="16"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                            <Border
                                Padding="12"
                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Label
                                    Text="{localization:Translate Formula.Proportion.Compound.Calculation}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    LineHeight="1.35"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </Border>
