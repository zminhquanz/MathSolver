<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    Title="Cài đặt"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <!-- Ẩn nút Back mặc định của Shell/Windows NavigationView. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <!-- Thay tiêu đề Math Solver bằng tiêu đề riêng của trang Cài đặt. -->
    <Shell.TitleView>
        <Grid
            Padding="{OnPlatform Android='0,0,8,0', WinUI='2,0,10,0', Default='2,0,10,0'}"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{OnPlatform Android=2, WinUI=6, Default=6}">

            <Grid
                Grid.Column="0"
                WidthRequest="{OnPlatform Android=48, WinUI=40, Default=40}"
                HeightRequest="{OnPlatform Android=48, WinUI=40, Default=40}"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Button
                    x:Name="SettingsBackButton"
                    Style="{StaticResource PlatformBackButtonStyle}"
                    controls:InteractiveButtonAnimation.IsScopeEnabled="True"
                    controls:InteractiveButtonAnimation.IsPlatformBackButton="True"
                    SemanticProperties.Description="Quay lại"
                    Clicked="OnCloseClicked" />

                <controls:ThemedSvgPathIcon
                    Data="M313-440h487v-80H313l223-223-56-57-320 320 320 320 56-57-223-223Z"
                    WidthRequest="{OnPlatform Android=24, WinUI=18, Default=18}"
                    HeightRequest="{OnPlatform Android=24, WinUI=18, Default=18}"
                    Opacity="{Binding Source={x:Reference SettingsBackButton}, Path=Opacity}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                VerticalOptions="Center">
                <Label
                    x:Name="SettingsPageTitleLabel"
                    Text="Cài đặt"
                    TranslationY="{OnPlatform Android=1, WinUI=0, Default=0}"
                    FontSize="{OnPlatform Android=20, WinUI=20, Default=20}"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    MaxLines="1"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    x:Name="SettingsPageSubtitleLabel"
                    Text="Giao diện, kết quả hiển thị và công cụ nhà phát triển"
                    IsVisible="{OnPlatform Android=False, WinUI=True, Default=True}"
                    FontSize="11"
                    LineBreakMode="TailTruncation"
                    TextColor="{DynamicResource TextSecondaryColor}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ScrollView
        x:Name="SettingsPageContentRoot">
            <VerticalStackLayout
            Padding="{OnPlatform Android=12, WinUI=18, Default=18}"
            Spacing="{OnPlatform Android=12, WinUI=16, Default=16}"
            HorizontalOptions="Center"
            MaximumWidthRequest="900">

                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="13">
                        <Label
                        Text="Phong cách hiển thị"
                        FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Theo hệ thống sẽ tự chuyển sáng hoặc tối theo thiết bị."
                        FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="10">

                            <Button
                            x:Name="SystemThemeButton"
                            Grid.Column="0"
                            Text="Hệ thống"
                            Clicked="OnSystemThemeClicked" />

                            <Button
                            x:Name="LightThemeButton"
                            Grid.Column="1"
                            Text="Sáng"
                            Clicked="OnLightThemeClicked" />

                            <Button
                            x:Name="DarkThemeButton"
                            Grid.Column="2"
                            Text="Tối"
                            Clicked="OnDarkThemeClicked" />
                        </Grid>

                        <BoxView
                            IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                            HeightRequest="1"
                            Margin="0,2"
                            BackgroundColor="{DynamicResource DividerColor}" />

                        <Grid
                            IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            Padding="2,2,2,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label
                                    x:Name="DynamicColorTitleLabel"
                                    Text="Màu theo hình nền"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    x:Name="DynamicColorSummaryLabel"
                                    Text="Dùng bảng màu Material You của hệ thống"
                                    Style="{StaticResource MaterialBodyMediumStyle}" />
                            </VerticalStackLayout>

                            <Switch
                                x:Name="DynamicColorSwitch"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Toggled="OnDynamicColorToggled" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="AccentColorCard" Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="{OnPlatform Android=10, WinUI=14, Default=14}">
                        <Label
                        Text="Màu chủ đề"
                        FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Chọn màu có sẵn, nhập mã HEX hoặc điều chỉnh ba kênh RGB."
                        FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <!-- WinUI: center the preset color group as one balanced row. -->
                        <Grid
                        IsVisible="{OnPlatform Android=False, WinUI=True, Default=True}"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                            <Button
                            Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#6D28D9"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#6D28D9"
                            SemanticProperties.Description="Màu tím"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="1"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#2563EB"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#2563EB"
                            SemanticProperties.Description="Màu xanh dương"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="2"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#0891B2"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#0891B2"
                            SemanticProperties.Description="Màu xanh ngọc"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="3"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#16A34A"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#16A34A"
                            SemanticProperties.Description="Màu xanh lá"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="4"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#EA580C"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#EA580C"
                            SemanticProperties.Description="Màu cam"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="5"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#DB2777"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#DB2777"
                            SemanticProperties.Description="Màu hồng"
                            Clicked="OnPresetColorClicked" />
                        </Grid>

                        <!-- Android: fixed-height equal columns avoid FlexLayout's oversized measurement on narrow screens. -->
                        <Grid
                        IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                        ColumnDefinitions="*,*,*,*,*,*"
                        ColumnSpacing="4"
                        HeightRequest="46"
                        Margin="2,0"
                        HorizontalOptions="Fill">

                            <Button
                            Grid.Column="0"
                            WidthRequest="42"
                            HeightRequest="42"
                            MinimumWidthRequest="42"
                            MinimumHeightRequest="42"
                            Padding="0"
                            CornerRadius="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="#6D28D9"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#6D28D9"
                            SemanticProperties.Description="Màu tím"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="1"
                            WidthRequest="42"
                            HeightRequest="42"
                            MinimumWidthRequest="42"
                            MinimumHeightRequest="42"
                            Padding="0"
                            CornerRadius="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="#2563EB"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#2563EB"
                            SemanticProperties.Description="Màu xanh dương"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="2"
                            WidthRequest="42"
                            HeightRequest="42"
                            MinimumWidthRequest="42"
                            MinimumHeightRequest="42"
                            Padding="0"
                            CornerRadius="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="#0891B2"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#0891B2"
                            SemanticProperties.Description="Màu xanh ngọc"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="3"
                            WidthRequest="42"
                            HeightRequest="42"
                            MinimumWidthRequest="42"
                            MinimumHeightRequest="42"
                            Padding="0"
                            CornerRadius="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="#16A34A"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#16A34A"
                            SemanticProperties.Description="Màu xanh lá"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="4"
                            WidthRequest="42"
                            HeightRequest="42"
                            MinimumWidthRequest="42"
                            MinimumHeightRequest="42"
                            Padding="0"
                            CornerRadius="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="#EA580C"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#EA580C"
                            SemanticProperties.Description="Màu cam"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Grid.Column="5"
                            WidthRequest="42"
                            HeightRequest="42"
                            MinimumWidthRequest="42"
                            MinimumHeightRequest="42"
                            Padding="0"
                            CornerRadius="21"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="#DB2777"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#DB2777"
                            SemanticProperties.Description="Màu hồng"
                            Clicked="OnPresetColorClicked" />
                        </Grid>

                        <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                            <Border
                            Grid.Column="0"
                            Padding="10,0"
                            BackgroundColor="{DynamicResource InputBackgroundColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                x:Name="HexColorEntry"
                                Placeholder="#6D28D9"
                                MaxLength="7"
                                Keyboard="Text"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Completed="OnApplyHexClicked" />
                            </Border>

                            <Button
                            Grid.Column="1"
                            Text="Áp dụng"
                            Style="{StaticResource ThemePrimaryButtonStyle}"
                            Clicked="OnApplyHexClicked" />
                        </Grid>

                        <Label
                        x:Name="ValidationLabel"
                        IsVisible="False"
                        FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                        TextColor="{DynamicResource DangerColor}" />

                        <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnDefinitions="Auto,*,Auto"
                        RowSpacing="12"
                        ColumnSpacing="10">

                            <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="R"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            VerticalTextAlignment="Center" />

                            <Slider
                            x:Name="RedSlider"
                            Grid.Row="0"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            ValueChanged="OnRgbValueChanged"
                            DragCompleted="OnRgbDragCompleted"
                            MinimumTrackColor="{DynamicResource PrimaryColor}"
                            MaximumTrackColor="{DynamicResource BorderColor}" />

                            <Label
                            x:Name="RedValueLabel"
                            Grid.Row="0"
                            Grid.Column="2"
                            WidthRequest="36"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="G"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            VerticalTextAlignment="Center" />

                            <Slider
                            x:Name="GreenSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            ValueChanged="OnRgbValueChanged"
                            DragCompleted="OnRgbDragCompleted"
                            MinimumTrackColor="{DynamicResource PrimaryColor}"
                            MaximumTrackColor="{DynamicResource BorderColor}" />

                            <Label
                            x:Name="GreenValueLabel"
                            Grid.Row="1"
                            Grid.Column="2"
                            WidthRequest="36"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="B"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            VerticalTextAlignment="Center" />

                            <Slider
                            x:Name="BlueSlider"
                            Grid.Row="2"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            ValueChanged="OnRgbValueChanged"
                            DragCompleted="OnRgbDragCompleted"
                            MinimumTrackColor="{DynamicResource PrimaryColor}"
                            MaximumTrackColor="{DynamicResource BorderColor}" />

                            <Label
                            x:Name="BlueValueLabel"
                            Grid.Row="2"
                            Grid.Column="2"
                            WidthRequest="36"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                        </Grid>

                        <Border
                        x:Name="ColorPreviewBorder"
                        Padding="16"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                    x:Name="PreviewTitleLabel"
                                    Text="Xem trước màu chủ đề"
                                    FontAttributes="Bold" />

                                    <Label
                                    x:Name="PreviewHexLabel"
                                    FontSize="{OnPlatform Android=14, WinUI=13, Default=13}" />
                                </VerticalStackLayout>

                                <Label
                                x:Name="PreviewSampleLabel"
                                Grid.Column="1"
                                Text="Aa"
                                FontSize="24"
                                FontAttributes="Bold"
                                VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>


                <!-- TÙY CHỈNH PHÔNG CHỮ -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="13">

                        <Label
                        Text="Phông chữ"
                        FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Chọn phông chữ dùng cho toàn bộ giao diện Math Solver."
                        FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                        Padding="0"
                        BackgroundColor="{DynamicResource InputBackgroundColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="{OnPlatform Android=0, WinUI=1, Default=1}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Picker
                            x:Name="FontPicker"
                            HeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                            ItemDisplayBinding="{Binding LocalizedDisplayName}"
                            Margin="{OnPlatform Android='0', WinUI='12,0,0,0', Default='12,0,0,0'}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            FontSize="14"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            TitleColor="{DynamicResource TextSecondaryColor}"
                            SelectedIndexChanged="OnFontSelectionChanged" />
                        </Border>

                        <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="7">

                                <Label
                                Text="Xem trước phông chữ"
                                FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                                <Label
                                x:Name="FontPreviewLabel"
                                Text="Aa Bb Cc — 0123456789 — Toán học"
                                FontSize="23"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                x:Name="SelectedFontNameLabel"
                                FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>


                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                        Text="Ngôn ngữ"
                        FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Chọn ngôn ngữ dùng cho toàn bộ giao diện và lời giải."
                        FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                            Padding="0"
                            BackgroundColor="{DynamicResource InputBackgroundColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="{OnPlatform Android=0, WinUI=1, Default=1}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Picker
                                x:Name="LanguagePicker"
                                HeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                                ItemDisplayBinding="{Binding LocalizedDisplayName}"
                                Margin="{OnPlatform Android='0', WinUI='12,0,0,0', Default='12,0,0,0'}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                TitleColor="{DynamicResource TextSecondaryColor}"
                                    SelectedIndexChanged="OnLanguageSelectionChanged" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- HIỂN THỊ KẾT QUẢ -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="13">
                        <Label
                            x:Name="ResultDisplaySectionTitleLabel"
                            Text="Hiển thị kết quả"
                            FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="ResultDisplaySectionDescriptionLabel"
                            Text="Tùy chỉnh cách Math Solver trình bày các kết quả có nhiều chữ số."
                            FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Label
                                    Grid.Column="0"
                                    Text="123"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">
                                    <Label
                                        x:Name="FullNumberDisplayTitleLabel"
                                        Text="Hiển thị kết quả đầy đủ"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="FullNumberDisplaySummaryLabel"
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </VerticalStackLayout>

                                <Switch
                                    x:Name="FullNumberDisplaySwitch"
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    Toggled="OnFullNumberDisplayToggled" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- CHẾ ĐỘ NHÀ PHÁT TRIỂN -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label
                            x:Name="DeveloperSectionTitleLabel"
                            Text="Chế độ nhà phát triển"
                            FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="DeveloperSectionDescriptionLabel"
                            Text="Bật các dữ liệu chẩn đoán dùng để kiểm tra thuật toán và AI/LLM."
                            FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Label
                                        Grid.Column="0"
                                        Text="&lt;/&gt;"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        TextColor="{DynamicResource PrimaryColor}" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label
                                            x:Name="DeveloperModeTitleLabel"
                                            Text="Chế độ nhà phát triển"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />
                                        <Label
                                            x:Name="DeveloperModeDescriptionLabel"
                                            Text="Hiện JSON, log validation và chi tiết kỹ thuật khi cần kiểm tra."
                                            FontSize="12"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>

                                    <Switch
                                        x:Name="DeveloperModeSwitch"
                                        Grid.Column="2"
                                        VerticalOptions="Center"
                                        Toggled="OnDeveloperModeToggled" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border
                                        x:Name="DeveloperModeStateBadge"
                                        Grid.Column="0"
                                        Padding="{OnPlatform Android='10,0', WinUI='10,6', Default='10,6'}"
                                        MinimumHeightRequest="{OnPlatform Android=36, WinUI=-1, Default=-1}"
                                        VerticalOptions="Center"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label
                                            x:Name="DeveloperModeStateLabel"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Fill"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            TranslationY="{OnPlatform Android=1, WinUI=0, Default=0}" />
                                    </Border>

                                    <Label
                                        x:Name="DeveloperModeDefaultNoteLabel"
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontAttributes="Italic"
                                        VerticalTextAlignment="Center"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                                <Label
                                    x:Name="DeveloperVisibleToolsTitleLabel"
                                    Text="Nội dung được hiển thị khi bật"
                                    FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        Text="JSON"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label
                                            x:Name="DeveloperLlmToolsTitleLabel"
                                            Text="JSON và log kiểm tra AI"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />
                                        <Label
                                            x:Name="DeveloperLlmToolsDescriptionLabel"
                                            Text="Hiện JSON do LLM tạo và từng bước validation của C#."
                                            FontSize="12"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label
                                        Grid.Column="0"
                                        Text="aⁿ"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label
                                            x:Name="DeveloperPowerToolsTitleLabel"
                                            Text="Chi tiết lũy thừa và căn bậc"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />
                                        <Label
                                            x:Name="DeveloperPowerToolsDescriptionLabel"
                                            Text="Hiện nút và nội dung phân tích kỹ thuật của quá trình tính toán."
                                            FontSize="12"
                                            TextColor="{DynamicResource TextSecondaryColor}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                        x:Name="ResetSectionTitleLabel"
                        Text="Khôi phục mặc định"
                        FontSize="{OnPlatform Android=20, WinUI=19, Default=19}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        x:Name="ResetSectionDescriptionLabel"
                        Text="Đặt lại giao diện, hiển thị kết quả và chế độ nhà phát triển về mặc định."
                        FontSize="{OnPlatform Android=14, WinUI=13, Default=13}"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Button
                        x:Name="ResetSettingsButton"
                        Text="Khôi phục"
                        Style="{StaticResource ThemeSecondaryButtonStyle}"
                        HorizontalOptions="Start"
                        Clicked="OnResetClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
</ContentPage>
