<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    Title="Cài đặt giao diện"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <!-- Ẩn nút Back mặc định của Shell/Windows NavigationView. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <!-- Thay tiêu đề Math Solver bằng tiêu đề riêng của trang Cài đặt. -->
    <Shell.TitleView>
        <Grid
            Padding="0,0,8,0"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">

            <Button
                x:Name="SettingsBackButton"
                Grid.Column="0"
                Text="‹"
                WidthRequest="40"
                HeightRequest="40"
                MinimumWidthRequest="40"
                MinimumHeightRequest="40"
                Padding="0"
                CornerRadius="20"
                FontSize="28"
                FontAttributes="Bold"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextPrimaryColor}"
                AutomationProperties.Name="Quay lại"
                Clicked="OnCloseClicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                VerticalOptions="Center">
                <Label
                    Text="CÀI ĐẶT GIAO DIỆN"
                    FontSize="19"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="Chọn phong cách sáng, tối và bất kỳ màu chủ đề nào cho Math Solver"
                    FontSize="11"
                    LineBreakMode="TailTruncation"
                    TextColor="{DynamicResource TextSecondaryColor}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ScrollView
        x:Name="SettingsPageContentRoot">
            <VerticalStackLayout
            Padding="18"
            Spacing="16"
            HorizontalOptions="Center"
            MaximumWidthRequest="900">

                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="13">
                        <Label
                        Text="Phong cách hiển thị"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Theo hệ thống sẽ tự chuyển sáng hoặc tối theo thiết bị."
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="10">

                            <Button
                            x:Name="SystemThemeButton"
                            Grid.Column="0"
                            Text="Hệ thống"
                            Clicked="OnSystemThemeClicked" />

                            <Button
                            x:Name="LightThemeButton"
                            Grid.Column="1"
                            Text="Sáng"
                            Clicked="OnLightThemeClicked" />

                            <Button
                            x:Name="DarkThemeButton"
                            Grid.Column="2"
                            Text="Tối"
                            Clicked="OnDarkThemeClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label
                        Text="Màu chủ đề"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Chọn màu có sẵn, nhập mã HEX hoặc điều chỉnh ba kênh RGB."
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <FlexLayout
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Center">

                            <Button
                            Margin="0,0,10,10"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#6D28D9"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#6D28D9"
                            AutomationProperties.Name="Màu tím"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Margin="0,0,10,10"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#2563EB"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#2563EB"
                            AutomationProperties.Name="Màu xanh dương"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Margin="0,0,10,10"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#0891B2"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#0891B2"
                            AutomationProperties.Name="Màu xanh ngọc"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Margin="0,0,10,10"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#16A34A"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#16A34A"
                            AutomationProperties.Name="Màu xanh lá"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Margin="0,0,10,10"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#EA580C"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#EA580C"
                            AutomationProperties.Name="Màu cam"
                            Clicked="OnPresetColorClicked" />

                            <Button
                            Margin="0,0,10,10"
                            WidthRequest="44"
                            HeightRequest="44"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            BackgroundColor="#DB2777"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CommandParameter="#DB2777"
                            AutomationProperties.Name="Màu hồng"
                            Clicked="OnPresetColorClicked" />
                        </FlexLayout>

                        <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                            <Border
                            Grid.Column="0"
                            Padding="10,0"
                            BackgroundColor="{DynamicResource InputBackgroundColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <controls:BorderlessEntry
                                x:Name="HexColorEntry"
                                Placeholder="#6D28D9"
                                MaxLength="7"
                                Keyboard="Text"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Completed="OnApplyHexClicked" />
                            </Border>

                            <Button
                            Grid.Column="1"
                            Text="Áp dụng"
                            Style="{StaticResource ThemePrimaryButtonStyle}"
                            Clicked="OnApplyHexClicked" />
                        </Grid>

                        <Label
                        x:Name="ValidationLabel"
                        IsVisible="False"
                        FontSize="13"
                        TextColor="{DynamicResource DangerColor}" />

                        <Grid
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnDefinitions="Auto,*,Auto"
                        RowSpacing="12"
                        ColumnSpacing="10">

                            <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="R"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            VerticalTextAlignment="Center" />

                            <Slider
                            x:Name="RedSlider"
                            Grid.Row="0"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            ValueChanged="OnRgbValueChanged"
                            DragCompleted="OnRgbDragCompleted"
                            MinimumTrackColor="{DynamicResource PrimaryColor}"
                            MaximumTrackColor="{DynamicResource BorderColor}" />

                            <Label
                            x:Name="RedValueLabel"
                            Grid.Row="0"
                            Grid.Column="2"
                            WidthRequest="36"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="G"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            VerticalTextAlignment="Center" />

                            <Slider
                            x:Name="GreenSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            ValueChanged="OnRgbValueChanged"
                            DragCompleted="OnRgbDragCompleted"
                            MinimumTrackColor="{DynamicResource PrimaryColor}"
                            MaximumTrackColor="{DynamicResource BorderColor}" />

                            <Label
                            x:Name="GreenValueLabel"
                            Grid.Row="1"
                            Grid.Column="2"
                            WidthRequest="36"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="B"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            VerticalTextAlignment="Center" />

                            <Slider
                            x:Name="BlueSlider"
                            Grid.Row="2"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="255"
                            ValueChanged="OnRgbValueChanged"
                            DragCompleted="OnRgbDragCompleted"
                            MinimumTrackColor="{DynamicResource PrimaryColor}"
                            MaximumTrackColor="{DynamicResource BorderColor}" />

                            <Label
                            x:Name="BlueValueLabel"
                            Grid.Row="2"
                            Grid.Column="2"
                            WidthRequest="36"
                            HorizontalTextAlignment="End"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                        </Grid>

                        <Border
                        x:Name="ColorPreviewBorder"
                        Padding="16"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label
                                    x:Name="PreviewTitleLabel"
                                    Text="Xem trước màu chủ đề"
                                    FontAttributes="Bold" />

                                    <Label
                                    x:Name="PreviewHexLabel"
                                    FontSize="13" />
                                </VerticalStackLayout>

                                <Label
                                x:Name="PreviewSampleLabel"
                                Grid.Column="1"
                                Text="Aa"
                                FontSize="24"
                                FontAttributes="Bold"
                                VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>


                <!-- TÙY CHỈNH PHÔNG CHỮ -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="13">

                        <Label
                        Text="Phông chữ"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Chọn phông chữ dùng cho toàn bộ giao diện Math Solver."
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                        Padding="0"
                        BackgroundColor="{DynamicResource InputBackgroundColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Grid
                            HeightRequest="46"
                            ColumnDefinitions="*,44">

                                <!--
                                Picker phủ toàn bộ chiều rộng để người dùng có thể
                                bấm cả vùng mũi tên. Padding native bên phải được
                                chừa trong BorderlessPicker.cs.
                            -->
                                <controls:BorderlessPicker
                                x:Name="FontPicker"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                ItemDisplayBinding="{Binding LocalizedDisplayName}"
                                Margin="12,0,0,0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                TitleColor="{DynamicResource TextSecondaryColor}"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnFontSelectionChanged" />

                                <!-- Vạch phân cách nhẹ cho vùng nút xổ xuống. -->
                                <BoxView
                                Grid.Column="1"
                                WidthRequest="1"
                                Margin="0,9,0,9"
                                HorizontalOptions="Start"
                                BackgroundColor="{DynamicResource DividerColor}"
                                InputTransparent="True" />

                                <!-- Nút xổ xuống dạng pill nhỏ, cân giữa và đồng bộ theme. -->
                                <Border
                                Grid.Column="1"
                                WidthRequest="30"
                                HeightRequest="30"
                                Margin="6"
                                Padding="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                StrokeThickness="1"
                                InputTransparent="True">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <Label
                                    Text="▾"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                </Border>

                            </Grid>
                        </Border>

                        <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="7">

                                <Label
                                Text="Xem trước phông chữ"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                                <Label
                                x:Name="FontPreviewLabel"
                                Text="Aa Bb Cc — 0123456789 — Toán học"
                                FontSize="23"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                x:Name="SelectedFontNameLabel"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>


                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                        Text="Ngôn ngữ"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Chọn ngôn ngữ dùng cho toàn bộ giao diện và lời giải."
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                            x:Name="VietnameseLanguageButton"
                            Grid.Column="0"
                            Text="Tiếng Việt"
                            Clicked="OnVietnameseLanguageClicked" />

                            <Button
                            x:Name="EnglishLanguageButton"
                            Grid.Column="1"
                            Text="Tiếng Anh"
                            Clicked="OnEnglishLanguageClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ThemeCardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                        Text="Khôi phục mặc định"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        Text="Đưa ứng dụng về màu tím, phông Open Sans và phong cách theo hệ thống."
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                        <Button
                        Text="Khôi phục"
                        Style="{StaticResource ThemeSecondaryButtonStyle}"
                        HorizontalOptions="Start"
                        Clicked="OnResetClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
</ContentPage>
