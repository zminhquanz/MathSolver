<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.HardwarePerformancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    Title="Thông tin phần cứng"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="HardwareSectionIconStyle" TargetType="Path">
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
            <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
        </Style>
        <Style x:Key="HardwareRunButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemePrimaryButtonStyle}">
            <Setter Property="HorizontalOptions" Value="{OnPlatform WinUI=Start, Default=Fill}" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="HardwareDiagnosticValueStyle" TargetType="Label" BasedOn="{StaticResource HardwareInfoValueStyle}">
            <Setter Property="HorizontalTextAlignment" Value="Start" />
        </Style>
    </ContentPage.Resources>

    <!-- Dùng cùng vị trí tiêu đề với trang Cài đặt giao diện. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid
            Padding="{OnPlatform Android='0,0,8,0', WinUI='2,0,10,0', Default='2,0,10,0'}"
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="{OnPlatform Android=2, WinUI=6, Default=6}">

            <Grid
                Grid.Column="0"
                WidthRequest="{DynamicResource Density.ControlWidth}"
                HeightRequest="{DynamicResource Density.ControlHeight}"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Button
                    x:Name="HardwareBackButton"
                    Style="{StaticResource PlatformBackButtonStyle}"
                    controls:InteractiveButtonAnimation.IsScopeEnabled="True"
                    controls:InteractiveButtonAnimation.IsPlatformBackButton="True"
                    SemanticProperties.Description="Quay lại"
                    Clicked="OnCloseClicked" />

                <controls:ThemedSvgPathIcon
                    Data="M313-440h487v-80H313l223-223-56-57-320 320 320 320 56-57-223-223Z"
                    WidthRequest="{OnPlatform Android=20, WinUI=18, Default=18}"
                    HeightRequest="{OnPlatform Android=20, WinUI=18, Default=18}"
                    Opacity="{Binding Source={x:Reference HardwareBackButton}, Path=Opacity, x:DataType='Button'}"
                    TranslationX="{OnPlatform Android=-2, WinUI=0, Default=0}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <controls:ThemedSvgPathIcon Grid.Column="1"
                Data="{x:Static controls:SettingsDestinationIconPaths.Hardware}"
                WidthRequest="24" HeightRequest="24" Margin="4,0"
                HorizontalOptions="Center" VerticalOptions="Center"
                AutomationProperties.IsInAccessibleTree="False" />

            <VerticalStackLayout
                Grid.Column="2"
                Spacing="0"
                VerticalOptions="Center">

                <Label
                    Text="Thông tin phần cứng"
                    TranslationY="{OnPlatform Android=1, WinUI=0, Default=0}"
                    Style="{StaticResource AppPageHeaderTitleStyle}" />

                <Label
                    Text="Đo hiệu năng Int32, Int64, Float và Double"
                    IsVisible="{OnPlatform Android=False, WinUI=True, Default=True}"
                    Style="{StaticResource AppPageHeaderSubtitleStyle}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid x:Name="HardwarePageContentRoot">
        <ScrollView>
            <VerticalStackLayout
                Padding="{OnPlatform Android=12, WinUI=16, Default=16}"
                Spacing="{OnPlatform Android=12, WinUI=16, Default=16}"
                MaximumWidthRequest="920"
                HorizontalOptions="Center">

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Thông tin thiết bị"
                            SemanticProperties.HeadingLevel="Level2"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Tên thiết bị" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DeviceNameValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Mẫu thiết bị" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DeviceModelValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Nhà sản xuất" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="ManufacturerValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Nền tảng" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="PlatformValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Phiên bản hệ điều hành" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="OsVersionValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Môi trường thiết bị" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DeviceTypeValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Màn hình" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DisplayValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Bộ xử lý"
                            SemanticProperties.HeadingLevel="Level2"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Tên bộ vi xử lý" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="ProcessorNameValueLabel"
                                Grid.Column="1"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Xung nhịp CPU" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="ProcessorClockValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Kiến trúc CPU" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="CpuArchitectureValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Kiến trúc hệ điều hành" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="OsArchitectureValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Số lõi vật lý" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="PhysicalCoresValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Số luồng logic" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="LogicalProcessorsValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Tập lệnh CPU" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="SimdValueLabel"
                                Grid.Column="1"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Độ rộng vector" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="VectorWidthValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Bộ nhớ khả dụng cho tiến trình" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="AvailableMemoryValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text=".NET Runtime" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="RuntimeValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="AiAccelerationSection"
                    IsVisible="{OnPlatform Android=True, WinUI=True, Default=False}"
                    Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            x:Name="AiAccelerationTitleLabel"
                            SemanticProperties.HeadingLevel="Level2"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <Label
                            x:Name="AiAccelerationDescriptionLabel"
                            Style="{StaticResource HardwareDescriptionStyle}" />

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Label
                            x:Name="AiAdapterLabel"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Grid x:Name="AiComputeModeSelector" ColumnDefinitions="*,*" ColumnSpacing="10"
                              IsVisible="{OnPlatform Android=False, Default=True}">
                            <Grid>
                            <Button
                                x:Name="AiCpuModeButton"
                                AutomationId="AiCpuModeButton"
                                Style="{StaticResource AppButtonBaseStyle}"
                                MinimumHeightRequest="46"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                Clicked="OnAiCpuModeClicked" />
                            <HorizontalStackLayout Spacing="8" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   AutomationProperties.IsInAccessibleTree="False">
                                <Image x:Name="AiCpuModeIcon" WidthRequest="24" HeightRequest="24"
                                       MinimumWidthRequest="24" MinimumHeightRequest="24"
                                       Aspect="AspectFit" VerticalOptions="Center"
                                       AutomationProperties.IsInAccessibleTree="False" />
                                <Label x:Name="AiCpuModeCaption" FontAttributes="Bold" VerticalOptions="Center"
                                       FontSize="{Binding FontSize, Source={x:Reference AiCpuModeButton}, x:DataType='Button'}"
                                       TextColor="{Binding TextColor, Source={x:Reference AiCpuModeButton}, x:DataType='Button'}"
                                       FontFamily="{Binding FontFamily, Source={x:Reference AiCpuModeButton}, x:DataType='Button'}"
                                       AutomationProperties.IsInAccessibleTree="False" />
                            </HorizontalStackLayout>
                            </Grid>
                            <Grid Grid.Column="1">
                            <Button
                                x:Name="AiGpuModeButton"
                                AutomationId="AiGpuModeButton"
                                Style="{StaticResource AppButtonBaseStyle}"
                                MinimumHeightRequest="46"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                Clicked="OnAiGpuModeClicked" />
                            <HorizontalStackLayout Spacing="8" InputTransparent="True"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   AutomationProperties.IsInAccessibleTree="False">
                                <Image x:Name="AiGpuModeIcon" WidthRequest="24" HeightRequest="24"
                                       MinimumWidthRequest="24" MinimumHeightRequest="24"
                                       Aspect="AspectFit" VerticalOptions="Center"
                                       AutomationProperties.IsInAccessibleTree="False" />
                                <Label x:Name="AiGpuModeCaption" FontAttributes="Bold" VerticalOptions="Center"
                                       FontSize="{Binding FontSize, Source={x:Reference AiGpuModeButton}, x:DataType='Button'}"
                                       TextColor="{Binding TextColor, Source={x:Reference AiGpuModeButton}, x:DataType='Button'}"
                                       FontFamily="{Binding FontFamily, Source={x:Reference AiGpuModeButton}, x:DataType='Button'}"
                                       AutomationProperties.IsInAccessibleTree="False" />
                            </HorizontalStackLayout>
                            </Grid>
                        </Grid>

                        <Label
                            x:Name="AiPreferredBackendLabel"
                            Style="{StaticResource HardwareDescriptionStyle}" />

                        <Label
                            x:Name="AiRuntimeStatusLabel"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="AiCpuRuntimeLabel"
                            AutomationId="AiCpuRuntimeLabel"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextPrimaryColor}" />
                        <Label
                            x:Name="AiCpuRuntimeDetailsLabel"
                            AutomationId="AiCpuRuntimeDetailsLabel"
                            LineBreakMode="WordWrap"
                            Style="{StaticResource HardwareDescriptionStyle}" />

                        <Label
                            x:Name="AiFallbackStatusLabel"
                            IsVisible="False"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Label
                            x:Name="AiModeBusyLabel"
                            IsVisible="False"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout
                    x:Name="RawPerformanceContent"
                    Spacing="{OnPlatform Android=12, WinUI=16, Default=16}">

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <!-- Three vector lanes with offset controls. -->
                            <Path
                                Data="M2,4H8V2H10V4H22V6H10V8H8V6H2Z M2,11H14V9H16V11H22V13H16V15H14V13H2Z M2,18H6V16H8V18H22V20H8V22H6V20H2Z"
                                Style="{StaticResource HardwareSectionIconStyle}" />
                            <Label
                                Grid.Column="1"
                                Text="Tăng tốc tính toán"
                                SemanticProperties.HeadingLevel="Level2"
                                Style="{StaticResource HardwareSectionTitleStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="Tăng tốc phần cứng"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Bật SIMD cho benchmark và toàn ứng dụng."
                                    Style="{StaticResource HardwareDescriptionStyle}" />

                                <Label
                                    x:Name="AccelerationStatusLabel"
                                    Style="{StaticResource HardwareDescriptionStyle}" />
                            </VerticalStackLayout>

                            <Switch
                                x:Name="HardwareAccelerationSwitch"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Toggled="OnHardwareAccelerationToggled" />
                        </Grid>

                        <VerticalStackLayout
                            x:Name="SimdModeSelectorContainer"
                            IsVisible="False"
                            Spacing="6"
                            Margin="0,2,0,0">

                            <Label
                                Text="Tập lệnh SIMD toàn ứng dụng"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />


                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="SimdModePicker"
                                        MinimumHeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='12,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TitleColor="{DynamicResource TextSecondaryColor}"
                                        SelectedIndexChanged="OnSimdModeSelectionChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>
                            </Border>


                            <Label
                                Text="{OnPlatform Android='Benchmark CPU trên Android dùng NEON/AdvSIMD khi bật tăng tốc.', Default='Chỉ các tập lệnh CPU đang hỗ trợ mới được hiển thị.'}"
                                FontSize="11"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                                x:Name="ArmRuntimeSupportLabel"
                                IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="Đa luồng"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Đa luồng chỉ áp dụng cho bài đo hiệu năng."
                                    Style="{StaticResource HardwareDescriptionStyle}" />

                                <Label
                                    x:Name="MultithreadingStatusLabel"
                                    Style="{StaticResource HardwareDescriptionStyle}" />
                            </VerticalStackLayout>

                            <Switch
                                x:Name="MultithreadingSwitch"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Toggled="OnMultithreadingToggled" />
                        </Grid>

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="*,1.5*" ColumnSpacing="12">
                            <Label
                                Text="Chế độ Float / Double"
                                Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="FloatingPointModeValueLabel"
                                Grid.Column="1"
                                Style="{StaticResource HardwareDiagnosticValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,1.5*" ColumnSpacing="12">
                            <Label
                                Text="Chế độ Int32 / Int64"
                                Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="IntegerModeValueLabel"
                                Grid.Column="1"
                                Style="{StaticResource HardwareDiagnosticValueStyle}" />
                        </Grid>

                        <Border Padding="12" StrokeThickness="0" BackgroundColor="{DynamicResource SurfaceAltColor}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="Tăng tốc theo tác vụ"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Grid ColumnDefinitions="*,1.5*" RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="8">
                                    <Label Text="Lũy thừa lớn (NTT/CRT)" Style="{StaticResource HardwareInfoNameStyle}" />
                                    <Label x:Name="NttBackendValueLabel" Grid.Column="1" Style="{StaticResource HardwareDiagnosticValueStyle}" />

                                    <Label Grid.Row="1" Text="Xuất TXT lũy thừa lớn" Style="{StaticResource HardwareInfoNameStyle}" />
                                    <Label x:Name="PowerExportBackendValueLabel" Grid.Row="1" Grid.Column="1" Style="{StaticResource HardwareDiagnosticValueStyle}" />

                                    <Label Grid.Row="2" Text="Đồ thị parabol" Style="{StaticResource HardwareInfoNameStyle}" />
                                    <Label x:Name="ParabolaBackendValueLabel" Grid.Row="2" Grid.Column="1" Style="{StaticResource HardwareDiagnosticValueStyle}" />

                                    <Label Grid.Row="3" Text="Ma trận từ 16 × 16" Style="{StaticResource HardwareInfoNameStyle}" />
                                    <Label x:Name="MatrixBackendValueLabel" Grid.Row="3" Grid.Column="1" Style="{StaticResource HardwareDiagnosticValueStyle}" />
                                </Grid>
                                <Label
                                    Text="Ma trận nhỏ hơn dùng Scalar."
                                    Style="{StaticResource HardwareDescriptionStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <!-- Stopwatch silhouette with inset dial and hand. -->
                            <Path
                                Data="M9,2H15V4H13V5.06C17.22,5.55 20.5,9.14 20.5,13.5A8.5,8.5 0 1 1 11,5.06V4H9Z M12,7A6.5,6.5 0 1 0 12,20A6.5,6.5 0 1 0 12,7Z M11,9H13V13.1L15.5,15.6L14.1,17L11,13.9Z"
                                Style="{StaticResource HardwareSectionIconStyle}" />
                            <Label
                                x:Name="BenchmarkTestSectionTitleLabel"
                                Grid.Column="1"
                                Text="Bài kiểm tra hiệu năng"
                                SemanticProperties.HeadingLevel="Level2"
                                Style="{StaticResource HardwareSectionTitleStyle}" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                x:Name="BenchmarkTestPickerLabel"
                                Text="Chọn bài kiểm tra"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="BenchmarkTestPicker"
                                        SelectedIndex="0"
                                        MinimumHeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='12,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        SelectedIndexChanged="OnBenchmarkTestPickerSelectedIndexChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <VerticalStackLayout
                            x:Name="StandardBenchmarkPanel"
                            Spacing="12">
                            <Label
                                x:Name="StandardBenchmarkDescriptionLabel"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Label
                                x:Name="StandardBenchmarkNoteLabel"
                                FontSize="12"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Button
                                x:Name="RunBenchmarkButton"
                                Style="{StaticResource HardwareRunButtonStyle}"
                                Clicked="OnRunBenchmarkClicked" />

                            <ActivityIndicator
                                x:Name="BenchmarkProgress"
                                IsVisible="False"
                                IsRunning="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="BenchmarkCountdownLabel"
                                IsVisible="False"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="BenchmarkStatusLabel"
                                Text="Chưa có kết quả."
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Border
                                x:Name="BenchmarkResultsBorder"
                                IsVisible="False"
                                Padding="14"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            Text="Điểm tham khảo"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />
                                        <Label
                                            x:Name="BenchmarkScoreValueLabel"
                                            Grid.Column="1"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Grid>

                                    <BoxView Style="{StaticResource HardwareDividerStyle}" />

                                    <Label
                                        x:Name="BenchmarkFloatingModeResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="BenchmarkIntegerModeResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <BoxView Style="{StaticResource HardwareDividerStyle}" />

                                    <Label
                                        x:Name="Int32ResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="Int64ResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="FloatResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="DoubleResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <BoxView Style="{StaticResource HardwareDividerStyle}" />

                                    <Label
                                        x:Name="ElapsedResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="ThreadComparisonPanel"
                            IsVisible="False"
                            Spacing="12">
                            <Label
                                x:Name="ThreadComparisonDescriptionLabel"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Label
                                x:Name="ThreadComparisonNoteLabel"
                                FontSize="12"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Button
                                x:Name="RunThreadComparisonButton"
                                Text="Chạy so sánh đơn / đa luồng"
                                Style="{StaticResource HardwareRunButtonStyle}"
                                Clicked="OnRunThreadComparisonClicked" />

                            <ActivityIndicator
                                x:Name="ThreadComparisonProgress"
                                IsVisible="False"
                                IsRunning="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ThreadComparisonCountdownLabel"
                                IsVisible="False"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ThreadComparisonStatusLabel"
                                Text="Chưa có kết quả."
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <GraphicsView
                                x:Name="ThreadComparisonChartView"
                                IsVisible="False"
                                HeightRequest="300"
                                HorizontalOptions="Fill"
                                InputTransparent="True" />

                            <Label
                                x:Name="ThreadComparisonResultLabel"
                                IsVisible="False"
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="SimdComparisonPanel"
                            IsVisible="False"
                            Spacing="12">
                            <Label
                                x:Name="SimdComparisonDescriptionLabel"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Label
                                x:Name="SimdComparisonAvailabilityLabel"
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                                x:Name="SimdComparisonNoteLabel"
                                FontSize="12"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Button
                                x:Name="RunSimdComparisonButton"
                                Text="Chạy so sánh SIMD"
                                Style="{StaticResource HardwareRunButtonStyle}"
                                Clicked="OnRunSimdComparisonClicked" />

                            <ActivityIndicator
                                x:Name="SimdComparisonProgress"
                                IsVisible="False"
                                IsRunning="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="SimdComparisonCountdownLabel"
                                IsVisible="False"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="SimdComparisonStatusLabel"
                                Text="Chưa có kết quả."
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <GraphicsView
                                x:Name="SimdComparisonChartView"
                                IsVisible="False"
                                HeightRequest="320"
                                HorizontalOptions="Fill"
                                InputTransparent="True" />

                            <Label
                                x:Name="SimdComparisonResultLabel"
                                IsVisible="False"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
