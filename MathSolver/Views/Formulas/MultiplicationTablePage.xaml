<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.MultiplicationTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    Title="{localization:Translate Tabs.TimesTables}"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource WallpaperBorderBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceColor}" />
            <Setter Property="Padding" Value="{OnPlatform Android=12, WinUI=16, Default=16}" />
                    <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#33000000" Offset="0,2" Radius="8" Opacity="{OnPlatform Android=0.10, WinUI=0.08, Default=0.08}" />
                </Setter.Value>
            </Setter>
</Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource WallpaperBorderBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceColor}" />
            <Setter Property="Padding" Value="{OnPlatform Android=12, WinUI=14, Default=14}" />
                    <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#33000000" Offset="0,2" Radius="8" Opacity="{OnPlatform Android=0.10, WinUI=0.08, Default=0.08}" />
                </Setter.Value>
            </Setter>
</Style>

        <Style x:Key="TableLineBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource WallpaperBorderBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource WallpaperSurfaceAltColor}" />
            <Setter Property="Padding" Value="{OnPlatform Android='8,7', WinUI='10,8', Default='10,8'}" />
        </Style>

        <Style x:Key="TitleLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{OnPlatform Android=16, WinUI=17, Default=17}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
        </Style>

        <Style x:Key="SubLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="{OnPlatform Android=14, WinUI=15, Default=15}" />
            <Setter Property="TextColor" Value="{DynamicResource WallpaperTextSecondaryColor}" />
        </Style>

        <Style x:Key="TableLineStyle" TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
        </Style>


        <!--
            RadioButton mặc định trên Windows dùng màu accent của hệ điều hành
            cho vòng tròn checked, nên có thể bị xanh dù app đang dùng màu cam,
            tím, cyan... Template riêng chỉ dùng PrimaryColor/BorderColor của app.
            Màu luôn nằm ở DynamicResource; VisualState chỉ bật/tắt Opacity để
            đổi theme không bị giữ brush cũ trong trạng thái Checked.
        -->
        <ControlTemplate x:Key="TimesTableRangeRadioTemplate">
            <Grid
                WidthRequest="24"
                HeightRequest="24"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CheckedStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter
                                        TargetName="CheckedVisual"
                                        Property="Opacity"
                                        Value="1" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Unchecked">
                                <VisualState.Setters>
                                    <Setter
                                        TargetName="CheckedVisual"
                                        Property="Opacity"
                                        Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Ellipse
                    WidthRequest="20"
                    HeightRequest="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Fill="{DynamicResource WallpaperSurfaceColor}"
                    Stroke="{DynamicResource WallpaperBorderColor}"
                    StrokeThickness="2" />

                <Grid
                    x:Name="CheckedVisual"
                    Opacity="0"
                    InputTransparent="True">

                    <Ellipse
                        WidthRequest="20"
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Fill="Transparent"
                        Stroke="{DynamicResource PrimaryColor}"
                        StrokeThickness="2" />

                    <Ellipse
                        WidthRequest="10"
                        HeightRequest="10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Fill="{DynamicResource PrimaryColor}" />
                </Grid>
            </Grid>
        </ControlTemplate>

        <Style x:Key="TimesTableRangeRadioStyle" TargetType="RadioButton">
            <Setter Property="ControlTemplate" Value="{StaticResource TimesTableRangeRadioTemplate}" />
            <Setter Property="WidthRequest" Value="24" />
            <Setter Property="HeightRequest" Value="24" />
            <Setter Property="MinimumWidthRequest" Value="24" />
            <Setter Property="MinimumHeightRequest" Value="24" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
    </ContentPage.Resources>

    <Grid
        x:Name="MultiplicationPageContentRoot"
        Padding="{OnPlatform Android='12,10,12,20', WinUI='20,16', Default='20,16'}">
        <controls:LiveWallpaperView
            x:Name="LiveWallpaper"
            Margin="{OnPlatform Android='-12,-10,-12,-20', WinUI='-20,-16', Default='-20,-16'}" />
        <CollectionView
            x:Name="TablesCollectionView"
            ItemsSource="{Binding TableCards}"
            SelectionMode="None"
            BackgroundColor="Transparent">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16">

                    <!-- Hero -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            Text="×  ÷"
                            FontSize="{OnPlatform Android=24, WinUI=28, Default=28}"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />

                        <Label
                            Text="{localization:Translate TimesTables.Title}"
                            FontSize="{OnPlatform Android=24, WinUI=30, Default=30}"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        <Label
                            Text="{localization:Translate TimesTables.Subtitle}"
                            FontSize="{OnPlatform Android=14, WinUI=17, Default=17}"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                    </VerticalStackLayout>

                    <!-- Control panel -->
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <VerticalStackLayout Spacing="18">

                            <!-- 1. Chọn loại bảng -->
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="{localization:Translate TimesTables.ChooseTypeTitle}"
                                    Style="{StaticResource TitleLabelStyle}" />

                                <Label
                                    Text="{localization:Translate TimesTables.ChooseTypeDescription}"
                                    Style="{StaticResource SubLabelStyle}" />

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <Button
                                        x:Name="MultiplyButton"
                                        Grid.Column="0"
                                        HeightRequest="50"
                                        CornerRadius="12"
                                        Clicked="OnMultiplyClicked"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{localization:Translate TimesTables.MultiplyButton}" 
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="{DynamicResource OnPrimaryColor}" />

                                    <Button
                                        x:Name="DivideButton"
                                        Grid.Column="1"
                                        HeightRequest="50"
                                        CornerRadius="12"
                                        Clicked="OnDivideClicked"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{localization:Translate TimesTables.DivideButton}"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="{DynamicResource OnPrimaryColor}" />

                                </Grid>
                            </VerticalStackLayout>

                            <BoxView
                                Margin="0,2"
                                HeightRequest="1"
                                BackgroundColor="{DynamicResource WallpaperDividerColor}" />

                            <!-- 2. Chọn phạm vi -->
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="{localization:Translate TimesTables.RangeTitle}"
                                    Style="{StaticResource TitleLabelStyle}" />

                                <Label
                                    Text="{localization:Translate TimesTables.RangeDescription}"
                                    Style="{StaticResource SubLabelStyle}" />

                                <Grid
                                    ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*,*', Default='*,*,*'}"
                                    RowDefinitions="{OnPlatform Android='Auto,Auto,Auto', WinUI='Auto', Default='Auto'}"
                                    ColumnSpacing="12"
                                    RowSpacing="8">

                                    <Border
                                        x:Name="Range1To10Border"
                                        Grid.Column="0"
                                        Style="{StaticResource CardBorderStyle}"
                                        Padding="14,12">

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Center">

                                            <RadioButton
                                                x:Name="Range1To10Radio"
                                                Style="{StaticResource TimesTableRangeRadioStyle}"
                                                GroupName="RangeGroup"
                                                CheckedChanged="OnRangeChanged"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{localization:Translate TimesTables.Range1To10Title}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                <Label
                                                    Text="{localization:Translate TimesTables.Range1To10Subtitle}"
                                                    FontSize="14"
                                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                            </VerticalStackLayout>

                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border
                                        x:Name="Range11To20Border"
                                        Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                        Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                        Style="{StaticResource CardBorderStyle}"
                                        Padding="14,12">

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Center">

                                            <RadioButton
                                                x:Name="Range11To20Radio"
                                                Style="{StaticResource TimesTableRangeRadioStyle}"
                                                GroupName="RangeGroup"
                                                CheckedChanged="OnRangeChanged"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{localization:Translate TimesTables.Range11To20Title}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                <Label
                                                    Text="{localization:Translate TimesTables.Range11To20Subtitle}"
                                                    FontSize="14"
                                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                            </VerticalStackLayout>

                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border
                                        x:Name="RangeAllBorder"
                                        Grid.Row="{OnPlatform Android=2, WinUI=0, Default=0}"
                                        Grid.Column="{OnPlatform Android=0, WinUI=2, Default=2}"
                                        Style="{StaticResource CardBorderStyle}"
                                        Padding="14,12">

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Center">

                                            <RadioButton
                                                x:Name="RangeAllRadio"
                                                Style="{StaticResource TimesTableRangeRadioStyle}"
                                                GroupName="RangeGroup"
                                                CheckedChanged="OnRangeChanged"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{localization:Translate TimesTables.RangeAllTitle}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                <Label
                                                    Text="{localization:Translate TimesTables.RangeAllSubtitle}"
                                                    FontSize="14"
                                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                            </VerticalStackLayout>

                                        </HorizontalStackLayout>
                                    </Border>

                                </Grid>
                            </VerticalStackLayout>

                            <Border
                                x:Name="StatusBorder"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{DynamicResource PrimaryColor}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                Padding="14,10">
                                <Label
                                    x:Name="StatusLabel"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Title list -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{localization:Translate TimesTables.ListTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        <Label
                            Text="{localization:Translate TimesTables.ListDescription}"
                            FontSize="15"
                            TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="{OnPlatform Android=2, WinUI=5, Default=5}"
                    HorizontalItemSpacing="{OnPlatform Android=8, WinUI=12, Default=12}"
                    VerticalItemSpacing="{OnPlatform Android=8, WinUI=12, Default=12}" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="{Binding Title}"
                                HorizontalTextAlignment="Center"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource WallpaperDividerColor}" />

                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding Lines}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Style="{StaticResource TableLineBorderStyle}">
                                            <Label
                                                Style="{StaticResource TableLineStyle}"
                                                Text="{Binding .}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>