<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.MathPuzzlePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid
        x:Name="MathPuzzlePageContentRoot"
        RowDefinitions="*">

        <controls:LiveWallpaperView
            x:Name="LiveWallpaper" />

        <ScrollView
            Grid.Row="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

                <VerticalStackLayout
                    Padding="{OnPlatform Android='12,10,12,20', WinUI='20,12,20,28', Default='20,12,20,28'}"
                    Spacing="{OnPlatform Android=10, WinUI=14, Default=14}"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout
                        Margin="0,4,0,4"
                        Spacing="3">

                        <Label
                            Text="?  + − × ÷"
                            Style="{StaticResource SolverHeroSymbolStyle}" />

                        <Label
                            Text="{localization:Translate Quiz.PracticeTitle}"
                            Style="{StaticResource SolverHeroTitleStyle}" />

                        <Label
                            IsVisible="{OnPlatform Android=False, Default=True}"
                            Text="{localization:Translate Quiz.PracticeSubtitle}"
                            Style="{StaticResource SolverHeroSubtitleStyle}" />

                        <Label
                            IsVisible="{OnPlatform Android=True, Default=False}"
                            Text="{localization:QuizTranslate Quiz.PracticeSubtitleAlgorithmOnly}"
                            Style="{StaticResource SolverHeroSubtitleStyle}" />

                    </VerticalStackLayout>

                    <!-- Android currently exposes only the deterministic Algorithm source.
                         Hide the entire source/LLM card until the dedicated LiteRT-LM
                         Android backend is implemented; Windows keeps the full selector. -->
                    <Border
                        IsVisible="{OnPlatform Android=False, Default=True}"
                        Style="{StaticResource SolverCardStyle}">
                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="{localization:Translate Quiz.SourceTitle}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">

                                <Button
                                    x:Name="AlgorithmSourceButton"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="{OnPlatform Android=2, WinUI=1, iOS=2, MacCatalyst=2, Default=2}"
                                    Text="{localization:Translate Quiz.AlgorithmSource}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnAlgorithmSourceClicked" />

                                <Button
                                    x:Name="LocalLlmSourceButton"
                                    Grid.Column="1"
                                    IsVisible="{OnPlatform Android=False, WinUI=True, iOS=False, MacCatalyst=False, Default=False}"
                                    Text="{localization:Translate Quiz.LocalLlmSource}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnLocalLlmSourceClicked" />

                            </Grid>

                            <Border
                                x:Name="LlmSettingsBorder"
                                IsVisible="False"
                                Padding="{OnPlatform Android=12, WinUI=16, Default=16}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                                Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                StrokeThickness="1.5">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="12">

                                    <Grid
                                        ColumnDefinitions="{OnPlatform Android='Auto,*', WinUI='Auto,*,Auto', Default='Auto,*,Auto'}"
                                        RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                                        ColumnSpacing="12"
                                        RowSpacing="8">

                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="{OnPlatform Android=46, WinUI=54, Default=54}"
                                            HeightRequest="{OnPlatform Android=46, WinUI=54, Default=54}"
                                            Padding="0"
                                            BackgroundColor="{DynamicResource PrimaryColor}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="17" />
                                            </Border.StrokeShape>
                                            <Label
                                                Text="🤖"
                                                FontSize="{OnPlatform Android=23, WinUI=27, Default=27}"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="3"
                                            VerticalOptions="Center">
                                            <Label
                                                Text="{localization:Translate Quiz.LlmSettingsTitle}"
                                                FontSize="19"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                            <Label
                                                Text="{localization:Translate Quiz.LlmSettingsDescription}"
                                                FontSize="14"
                                                LineHeight="1.2"
                                                LineBreakMode="WordWrap"
                                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                            Grid.Column="{OnPlatform Android=0, WinUI=2, Default=2}"
                                            Grid.ColumnSpan="{OnPlatform Android=2, WinUI=1, Default=1}"
                                            HorizontalOptions="{OnPlatform Android=Start, WinUI=Fill, Default=Fill}"
                                            Padding="10,6"
                                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                            Stroke="{DynamicResource WallpaperBorderBrush}"
                                            StrokeThickness="1"
                                            VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6">
                                                <BoxView
                                                    x:Name="AiTeacherStateDot"
                                                    WidthRequest="8"
                                                    HeightRequest="8"
                                                    CornerRadius="4"
                                                    Color="{DynamicResource WallpaperTextSecondaryColor}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    x:Name="AiTeacherStateLabel"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}"
                                                    VerticalTextAlignment="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        Color="{DynamicResource WallpaperDividerColor}" />

                                    <Grid
                                        ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*', Default='*,*'}"
                                        ColumnSpacing="10"
                                        RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                                        RowSpacing="8">

                                        <Button
                                            x:Name="DownloadGemma4Button"
                                            Grid.Column="0"
                                            Text="{localization:Translate Quiz.DownloadGemma4}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            BackgroundColor="{DynamicResource PrimaryColor}"
                                            TextColor="{DynamicResource OnPrimaryColor}"
                                            Clicked="OnDownloadGemma4Clicked" />

                                        <Button
                                            x:Name="OpenLlmModelFolderButton"
                                            Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                            Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                            Text="{localization:Translate Quiz.OpenInFileExplorer}"
                                            IsEnabled="False"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            BackgroundColor="{DynamicResource WallpaperSurfaceStrongColor}"
                                            BorderColor="{DynamicResource WallpaperPrimaryBorderColor}"
                                            BorderWidth="1"
                                            TextColor="{DynamicResource PrimaryColor}"
                                            Clicked="OnOpenLlmModelFolderClicked" />

                                    </Grid>

                                    <Grid
                                        ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*', Default='*,*'}"
                                        ColumnSpacing="10"
                                        RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                                        RowSpacing="8">

                                        <Button
                                            x:Name="SelectLlmModelButton"
                                            Grid.Column="0"
                                            Text="{localization:Translate Quiz.SelectModel}"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            BackgroundColor="{DynamicResource WallpaperSurfaceStrongColor}"
                                            BorderColor="{DynamicResource WallpaperPrimaryBorderColor}"
                                            BorderWidth="1"
                                            TextColor="{DynamicResource PrimaryColor}"
                                            Clicked="OnSelectLlmModelClicked" />

                                        <Button
                                            x:Name="EjectLlmModelButton"
                                            Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                            Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                            Text="{localization:Translate Quiz.EjectModel}"
                                            IsEnabled="False"
                                            HeightRequest="46"
                                            CornerRadius="11"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                                            BorderColor="{DynamicResource DangerBorderColor}"
                                            BorderWidth="1"
                                            TextColor="{DynamicResource DangerColor}"
                                            Clicked="OnEjectLlmModelClicked" />

                                    </Grid>

                                    <Border
                                        Padding="12"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label
                                                Grid.Column="0"
                                                Text="🧠"
                                                FontSize="22"
                                                VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label
                                                    x:Name="LlmModelNameLabel"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation"
                                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                                <Label
                                                    x:Name="LlmModelRecommendationLabel"
                                                    FontSize="14"
                                                    LineHeight="1.2"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Grid
                                        x:Name="LlmProgressGrid"
                                        IsVisible="False"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">

                                        <ActivityIndicator
                                            x:Name="LlmActivityIndicator"
                                            Grid.Column="0"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            IsRunning="False"
                                            IsVisible="False"
                                            Color="{DynamicResource PrimaryColor}"
                                            VerticalOptions="Start" />

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="3">

                                            <Label
                                                x:Name="LlmStatusLabel"
                                                FontSize="14"
                                                LineHeight="1.2"
                                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                            <Label
                                                x:Name="LlmTokenSpeedLabel"
                                                IsVisible="False"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource PrimaryColor}" />

                                        </VerticalStackLayout>

                                    </Grid>

                                    <ProgressBar
                                        x:Name="LlmDownloadProgressBar"
                                        IsVisible="False"
                                        Progress="0"
                                        ProgressColor="{DynamicResource PrimaryColor}"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}" />

                                    <Border
                                        x:Name="AiTeacherGreetingBorder"
                                        IsVisible="False"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                Padding="0"
                                                BackgroundColor="{DynamicResource PrimaryColor}"
                                                StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label
                                                    Text="🤖"
                                                    FontSize="20"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label
                                                    Text="{localization:Translate Quiz.AiTeacherGreetingTitle}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource PrimaryColor}" />
                                                <Label
                                                    x:Name="AiTeacherGreetingLabel"
                                                    FontSize="15"
                                                    LineHeight="1.25"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Border
                                        x:Name="AiValidationStatusBorder"
                                        IsVisible="False"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label
                                                x:Name="AiValidationStatusIconLabel"
                                                Grid.Column="0"
                                                Text="⏳"
                                                FontSize="22"
                                                VerticalOptions="Start" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label
                                                    x:Name="AiValidationStatusTitleLabel"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                                <Label
                                                    x:Name="AiValidationStatusDetailLabel"
                                                    FontSize="13"
                                                    LineHeight="1.22"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Border
                                        x:Name="AiDiagnosticsSectionBorder"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="10">

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="12">

                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    Spacing="2"
                                                    VerticalOptions="Center">

                                                    <Label
                                                        Text="{localization:QuizTranslate Quiz.AiDiagnosticsTitle}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                    <Label
                                                        Text="{localization:QuizTranslate Quiz.AiDiagnosticsDescription}"
                                                        FontSize="13"
                                                        LineHeight="1.15"
                                                        TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                                </VerticalStackLayout>

                                                <Button
                                                    x:Name="AiDiagnosticsToggleButton"
                                                    Grid.Column="1"
                                                    Text="{localization:QuizTranslate Quiz.ShowAiDiagnostics}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Center"
                                                    HeightRequest="38"
                                                    Padding="14,5"
                                                    CornerRadius="9"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                                                    BorderColor="{DynamicResource WallpaperPrimaryBorderColor}"
                                                    BorderWidth="1"
                                                    TextColor="{DynamicResource PrimaryColor}"
                                                    Clicked="OnAiDiagnosticsToggleClicked" />

                                            </Grid>

                                            <Border
                                                x:Name="AiDiagnosticsBorder"
                                                IsVisible="False"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <Grid
                                            ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*', Default='*,*'}"
                                            ColumnSpacing="10"
                                            RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                                            RowSpacing="10">

                                            <Border
                                                Grid.Column="0"
                                                Padding="10"
                                                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <Grid
                                                    RowDefinitions="Auto,*"
                                                    RowSpacing="8">

                                                    <Label
                                                        Grid.Row="0"
                                                        Text="{localization:QuizTranslate Quiz.RawJsonTitle}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                    <Editor
                                                        x:Name="LlmRawJsonEditor"
                                                        Grid.Row="1"
                                                        HeightRequest="{OnPlatform Android=190, WinUI=260, Default=260}"
                                                        IsReadOnly="True"
                                                        FontSize="15"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                </Grid>

                                            </Border>

                                            <Border
                                                Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                                Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                                Padding="10"
                                                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <Grid
                                                    RowDefinitions="Auto,*"
                                                    RowSpacing="8">

                                                    <Label
                                                        Grid.Row="0"
                                                        Text="{localization:QuizTranslate Quiz.ValidationLogTitle}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                    <Editor
                                                        x:Name="LlmValidationLogEditor"
                                                        Grid.Row="1"
                                                        HeightRequest="{OnPlatform Android=190, WinUI=260, Default=260}"
                                                        IsReadOnly="True"
                                                        FontSize="15"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                                </Grid>

                                            </Border>

                                        </Grid>

                                            </Border>

                                        </VerticalStackLayout>

                                    </Border>

                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource SolverCardStyle}">
                        <VerticalStackLayout Spacing="14">

                            <Label
                                IsVisible="{OnPlatform Android=False, Default=True}"
                                Text="{localization:Translate Quiz.ModeTitle}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Label
                                IsVisible="{OnPlatform Android=True, Default=False}"
                                Text="{localization:QuizTranslate Quiz.ModeTitleAlgorithmOnly}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                                x:Name="QuestionModeGrid"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Button
                                    x:Name="TrueFalseModeButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Quiz.TrueFalseMode}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnTrueFalseModeClicked" />

                                <Button
                                    x:Name="MultipleChoiceModeButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Quiz.MultipleChoiceMode}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnMultipleChoiceModeClicked" />

                                <Button
                                    x:Name="EssayModeButton"
                                    Grid.Column="2"
                                    Text="{localization:QuizTranslate Quiz.EssayMode}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnEssayModeClicked" />

                            </Grid>

                            <Label
                                IsVisible="{OnPlatform Android=False, Default=True}"
                                Text="{localization:Translate Quiz.OperationTitle}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Label
                                IsVisible="{OnPlatform Android=True, Default=False}"
                                Text="{localization:QuizTranslate Quiz.OperationTitleAlgorithmOnly}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="OperationPicker"
                                        HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        SelectedIndexChanged="OnOperationChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>

                            </Border>

                            <VerticalStackLayout
                                x:Name="ProblemOperationPanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    x:Name="ProblemOperationTitleLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Grid
                                    ColumnDefinitions="*,*,*,*"
                                    ColumnSpacing="8">

                                    <Button x:Name="ProblemAddButton" Grid.Column="0" Text="+" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemAddClicked" />
                                    <Button x:Name="ProblemSubtractButton" Grid.Column="1" Text="−" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemSubtractClicked" />
                                    <Button x:Name="ProblemMultiplyButton" Grid.Column="2" Text="×" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemMultiplyClicked" />
                                    <Button x:Name="ProblemDivideButton" Grid.Column="3" Text="÷" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemDivideClicked" />

                                </Grid>

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="ProportionTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.ProportionTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button
                                        x:Name="DirectProportionButton"
                                        Grid.Column="0"
                                        Text="{localization:QuizTranslate Quiz.ProportionDirect}"
                                        HeightRequest="46"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnDirectProportionClicked" />
                                    <Button
                                        x:Name="InverseProportionButton"
                                        Grid.Column="1"
                                        Text="{localization:QuizTranslate Quiz.ProportionInverse}"
                                        HeightRequest="46"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnInverseProportionClicked" />
                                </Grid>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="12">

                            <Label
                                x:Name="QuestionCounterLabel"
                                Grid.Column="0"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                            <Label
                                x:Name="CorrectScoreLabel"
                                Grid.Column="1"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}"
                                VerticalTextAlignment="Center" />

                            <Label
                                x:Name="IncorrectScoreLabel"
                                Grid.Column="2"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}"
                                VerticalTextAlignment="Center" />

                        </Grid>
                    </Border>

                    <Border
                        Padding="18"
                        BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                        StrokeThickness="1.5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">

                            <Label
                                x:Name="QuestionPromptLabel"
                                Text="{localization:Translate Quiz.QuestionTitle}"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Label
                                x:Name="QuestionExpressionLabel"
                                FontSize="34"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <controls:FractionExpressionView
                                x:Name="QuestionFractionExpressionView"
                                IsVisible="False"
                                MathFontSize="21"
                                MathColor="{DynamicResource PrimaryColor}"
                                HorizontalTextAlignment="Center"
                                WrapContent="True"
                                TokenSpacing="4"
                                HorizontalOptions="Fill" />

                            <Label
                                x:Name="PresentedAnswerLabel"
                                IsVisible="False"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <controls:FractionExpressionView
                                x:Name="PresentedAnswerFractionView"
                                IsVisible="False"
                                MathFontSize="18"
                                MathColor="{DynamicResource PrimaryColor}"
                                HorizontalTextAlignment="Center"
                                WrapContent="True"
                                HorizontalOptions="Fill" />

                            <Grid
                                x:Name="TrueFalseAnswerGrid"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12">

                                <Button
                                    x:Name="TrueAnswerButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Quiz.TrueAnswer}"
                                    CommandParameter="true"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSuccessSoftColor}"
                                    BorderColor="{DynamicResource SuccessColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource SuccessColor}"
                                    Clicked="OnTrueFalseAnswerClicked" />

                                <Button
                                    x:Name="FalseAnswerButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Quiz.FalseAnswer}"
                                    CommandParameter="false"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                                    BorderColor="{DynamicResource DangerColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource DangerColor}"
                                    Clicked="OnTrueFalseAnswerClicked" />

                            </Grid>

                            <Grid
                                x:Name="MultipleChoiceAnswerGrid"
                                IsVisible="False"
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="*,*"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="ChoiceAButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceBButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceCButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceDButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceAFractionView"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceBFractionView"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceCFractionView"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceDFractionView"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                            </Grid>

                            <VerticalStackLayout
                                x:Name="EssayAnswerLayout"
                                IsVisible="False"
                                Spacing="10">

                                <VerticalStackLayout
                                    x:Name="EssaySolutionSection"
                                    Spacing="10">

                                    <Label
                                        Text="{localization:QuizTranslate Quiz.EssaySolutionLabel}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Border
                                        Padding="12,8"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <Editor
                                            x:Name="EssaySolutionEditor"
                                            MinimumHeightRequest="86"
                                            AutoSize="TextChanges"
                                            FontSize="16"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            Placeholder="{localization:QuizTranslate Quiz.EssaySolutionPlaceholder}"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                    </Border>

                                </VerticalStackLayout>

                                <Label
                                    Text="{localization:QuizTranslate Quiz.EssayEquationLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="EssayEquationEntry"
                                        HeightRequest="48"
                                        FontSize="18"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        Placeholder="{localization:QuizTranslate Quiz.EssayEquationPlaceholder}"
                                        PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                </Border>

                                <Label
                                    Text="{localization:QuizTranslate Quiz.EssayAnswerLabel}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <Border
                                    Padding="12,4"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="EssayAnswerEntry"
                                        HeightRequest="48"
                                        FontSize="18"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        Placeholder="{localization:QuizTranslate Quiz.EssayAnswerPlaceholder}"
                                        PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                </Border>

                                <Label
                                    x:Name="EssayValidationHintLabel"
                                    Text="{localization:QuizTranslate Quiz.EssayValidationHint}"
                                    FontSize="14"
                                    LineHeight="1.2"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Button
                                    x:Name="SubmitEssayAnswerButton"
                                    Text="{localization:QuizTranslate Quiz.SubmitEssayAnswer}"
                                    HeightRequest="50"
                                    CornerRadius="12"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnSubmitEssayAnswerClicked" />

                            </VerticalStackLayout>

                            <Border
                                x:Name="FeedbackBorder"
                                IsVisible="False"
                                Padding="12"
                                BackgroundColor="{DynamicResource WallpaperSuccessSoftColor}"
                                Stroke="{DynamicResource SuccessBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Label
                                        x:Name="FeedbackLabel"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource SuccessColor}" />

                                    <controls:FractionExpressionView
                                        x:Name="FeedbackFractionView"
                                        IsVisible="False"
                                        MathFontSize="17"
                                        MathColor="{DynamicResource SuccessColor}"
                                        HorizontalTextAlignment="Center"
                                        WrapContent="True"
                                        TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                </Grid>

                            </Border>

                            <Border
                                x:Name="SolutionBorder"
                                IsVisible="False"
                                Padding="14"
                                BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                                Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="{localization:Translate Quiz.SolutionTitle}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Label
                                        x:Name="SolutionLabel"
                                        FontSize="17"
                                        LineHeight="1.3"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <controls:FractionExpressionView
                                        x:Name="SolutionFractionView"
                                        IsVisible="False"
                                        MathFontSize="17"
                                        MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        HorizontalTextAlignment="Start"
                                        WrapContent="True"
                                        TokenSpacing="4"
                                        HorizontalOptions="Fill" />

                                </VerticalStackLayout>
                            </Border>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="CreateOrRegenerateQuestionButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Quiz.CreateWithAi}"
                                    HeightRequest="50"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=14, WinUI=16, Default=16}"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnCreateOrRegenerateQuestionClicked" />

                                <Button
                                    x:Name="NextQuestionButton"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    Text="{localization:Translate Quiz.NextQuestion}"
                                    HeightRequest="50"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=14, WinUI=16, Default=16}"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnNextQuestionClicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{localization:Translate Quiz.ValidationHint}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
