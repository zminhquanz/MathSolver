<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.GemmaModelCatalogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="Transparent">

    <Grid x:Name="OverlayRoot">
        <BoxView
            x:Name="OverlayScrim"
            BackgroundColor="#99000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOutsideTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            x:Name="CatalogPanel"
            Margin="16"
            Padding="0"
            WidthRequest="940"
            MaximumHeightRequest="720"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource BorderBrush}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow
                    Brush="#88000000"
                    Offset="0,10"
                    Radius="28"
                    Opacity="0.48" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*">
                <Grid
                    Grid.Row="0"
                    Padding="20,15"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="8"
                    BackgroundColor="{DynamicResource SurfaceAltColor}">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="2"
                        VerticalOptions="Center">

                        <Label
                            x:Name="CatalogTitleLabel"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="CatalogSubtitleLabel"
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="OpenModelPageButton"
                        Grid.Column="1"
                        Text="↗"
                        WidthRequest="42"
                        HeightRequest="42"
                        Padding="0"
                        CornerRadius="21"
                        FontSize="22"
                        FontAttributes="Bold"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        BorderColor="{DynamicResource PrimaryBorderColor}"
                        BorderWidth="1"
                        TextColor="{DynamicResource PrimaryColor}"
                        Clicked="OnOpenModelPageClicked" />

                    <Button
                        Grid.Column="2"
                        Text="×"
                        WidthRequest="42"
                        HeightRequest="42"
                        Padding="0"
                        CornerRadius="21"
                        FontSize="23"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        Clicked="OnCloseClicked" />
                </Grid>

                <Grid
                    x:Name="CatalogBodyGrid"
                    Grid.Row="1"
                    Padding="14"
                    ColumnDefinitions="310,*"
                    RowDefinitions="*"
                    ColumnSpacing="14"
                    RowSpacing="14">

                    <VerticalStackLayout
                        x:Name="ModelListPanel"
                        Grid.Column="0"
                        Spacing="10">

                        <Label
                            x:Name="ModelsHeadingLabel"
                            Margin="2,0,0,2"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                            x:Name="E2BModelBorder"
                            Padding="14,12"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        x:Name="E2BTitleLabel"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="E2BDescriptionLabel"
                                        FontSize="13"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                    <Label
                                        x:Name="E2BMetadataLabel"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                </VerticalStackLayout>

                                <Button
                                    x:Name="DownloadE2BButton"
                                    Grid.Column="1"
                                    Text="↓"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0"
                                    CornerRadius="21"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnDownloadE2BClicked" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnE2BRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="E4BModelBorder"
                            Padding="14,12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        x:Name="E4BTitleLabel"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="E4BDescriptionLabel"
                                        FontSize="13"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                    <Label
                                        x:Name="E4BMetadataLabel"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                </VerticalStackLayout>

                                <Button
                                    x:Name="DownloadE4BButton"
                                    Grid.Column="1"
                                    Text="↓"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0"
                                    CornerRadius="21"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnDownloadE4BClicked" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnE4BRowTapped" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <Label
                            x:Name="RowInteractionHintLabel"
                            Margin="4,2,4,0"
                            FontSize="12"
                            LineHeight="1.2"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>

                    <Grid
                        x:Name="ReadmePanel"
                        Grid.Column="1"
                        RowDefinitions="Auto,*"
                        RowSpacing="8">

                        <Label
                            x:Name="ReadmeHeadingLabel"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                        <Border
                            Grid.Row="1"
                            Padding="0"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <ScrollView>
                                <VerticalStackLayout Padding="18" Spacing="13">
                                    <Label
                                        x:Name="ReadmeModelTitleLabel"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <BoxView HeightRequest="1" />

                                    <Label
                                        x:Name="ReadmeSummaryLabel"
                                        FontSize="15"
                                        LineHeight="1.35"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label
                                        x:Name="ReadmeMathSolverHeadingLabel"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label
                                        x:Name="ReadmeMathSolverBodyLabel"
                                        FontSize="14"
                                        LineHeight="1.32"
                                        TextColor="{DynamicResource TextSecondaryColor}" />

                                    <Label
                                        x:Name="ReadmeRecommendationHeadingLabel"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label
                                        x:Name="ReadmeRecommendationBodyLabel"
                                        FontSize="14"
                                        LineHeight="1.32"
                                        TextColor="{DynamicResource TextSecondaryColor}" />

                                    <Label
                                        x:Name="ReadmeFileHeadingLabel"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label
                                        x:Name="ReadmeFileBodyLabel"
                                        FontSize="13"
                                        LineHeight="1.3"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </VerticalStackLayout>
                            </ScrollView>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
