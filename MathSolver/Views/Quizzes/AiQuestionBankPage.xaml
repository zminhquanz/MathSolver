<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MathSolver.Views.AiQuestionBankPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    Title="{localization:Translate AiBank.Title}"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="True" BackgroundColor="{DynamicResource PageBackgroundColor}">
    <ContentPage.Resources>
        <!-- Native picker chrome is transparent; the outer border supplies the input shape. -->
        <Style x:Key="AiBankInputBorderStyle" TargetType="Border" BasedOn="{StaticResource SolverInputBorderStyle}">
            <Setter Property="HeightRequest" Value="-1" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=60, WinUI=48, Default=48}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAltColor}" />
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBorderBrush}" />
        </Style>
        <!-- Match the shape selector in GeometryCalculatorView. Native picker spacing
             already insets its text; extra frame padding would double that spacing. -->
        <Style x:Key="AiBankPickerBorderStyle" TargetType="Border" BasedOn="{StaticResource SolverInputBorderStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=56, WinUI=48, Default=48}" />
        </Style>
        <Style x:Key="AiBankPickerStyle" TargetType="Picker" BasedOn="{StaticResource DefaultPickerStyle}">
            <Setter Property="MinimumHeightRequest" Value="{OnPlatform Android=56, WinUI=48, Default=48}" />
            <Setter Property="Margin" Value="{OnPlatform Android='0', WinUI='0', Default='12,0,0,0'}" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
            <Setter Property="TitleColor" Value="{DynamicResource WallpaperTextPrimaryColor}" />
        </Style>
        <Style x:Key="AiBankDiagnosticCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAltColor}" />
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBorderBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiBankDiagnosticEditorStyle" TargetType="Editor">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoSize" Value="Disabled" />
            <Setter Property="HeightRequest" Value="220" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="AiBankPreviewPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource SolverPrimaryActionStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
        <Style x:Key="AiBankPreviewOutlinedActionStyle" TargetType="Button" BasedOn="{StaticResource SolverOutlinedActionStyle}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
        <Style x:Key="AiBankMutedStatusStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="TextColor" Value="{DynamicResource WallpaperTextSecondaryColor}" />
        </Style>
    </ContentPage.Resources>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Shell.TitleView>
        <Grid Padding="{OnPlatform Android='0,0,8,0', WinUI='2,0,10,0', Default='2,0,10,0'}"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="{OnPlatform Android=2, WinUI=6, Default=6}">
            <Grid WidthRequest="{DynamicResource Density.ControlWidth}"
                  HeightRequest="{DynamicResource Density.ControlHeight}"
                  HorizontalOptions="Center" VerticalOptions="Center">
                <Button x:Name="AiBankBackButton" Style="{StaticResource PlatformBackButtonStyle}"
                        controls:InteractiveButtonAnimation.IsScopeEnabled="True"
                        controls:InteractiveButtonAnimation.IsPlatformBackButton="True"
                        controls:InteractiveButtonAnimation.IsPressAnimationEnabled="False"
                        SemanticProperties.Description="{localization:Translate About.Back.Accessibility}"
                        ToolTipProperties.Text="{localization:Translate About.Back.Accessibility}"
                        Clicked="OnBackClicked" />
                <controls:ThemedSvgPathIcon
                    Data="M313-440h487v-80H313l223-223-56-57-320 320 320 320 56-57-223-223Z"
                    WidthRequest="{OnPlatform Android=20, WinUI=18, Default=18}"
                    HeightRequest="{OnPlatform Android=20, WinUI=18, Default=18}"
                    TranslationX="{OnPlatform Android=-2, WinUI=0, Default=0}"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    AutomationProperties.IsInAccessibleTree="False"
                    Opacity="{Binding Source={x:Reference AiBankBackButton}, Path=Opacity, x:DataType='Button'}" />
            </Grid>
            <controls:ActionIconView Key="Ai" Grid.Column="1" IconSize="24" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                <Label x:Name="AiBankHeaderTitleLabel"
                       Text="{localization:Translate AiBank.Title}"
                       TranslationY="{OnPlatform Android=1, WinUI=0, Default=0}"
                       Style="{StaticResource AppPageHeaderTitleStyle}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="AiBankHeaderSubtitleLabel"
                       Text="{localization:Translate AiBank.HeaderSubtitle}"
                       Style="{StaticResource AppPageHeaderSubtitleStyle}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>
    <Grid RowDefinitions="*,Auto">
        <controls:LiveWallpaperView x:Name="LiveWallpaper" />
        <ScrollView x:Name="WorkflowScroll" controls:SolverWorkspace.IsEnabled="True">
            <VerticalStackLayout Style="{StaticResource SolverContentStyle}">
                <!-- A page introduction stays above both workspace columns, including on resize. -->
                <Border x:Name="GuidanceCard" controls:SolverHeader.Role="Description"
                        Style="{StaticResource SolverCardStyle}" Padding="16"
                        BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                    <VerticalStackLayout x:Name="GuidanceContent" Spacing="12">
                        <VerticalStackLayout x:Name="GuidanceOverview" Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Image x:Name="GuidanceArtwork" Source="ai_guide_stationery.png"
                                   WidthRequest="{OnPlatform Android=96, Default=144}"
                                   HeightRequest="{OnPlatform Android=80, Default=96}"
                                   Aspect="AspectFit" VerticalOptions="Center" InputTransparent="True"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{localization:Translate AiBank.Workflow.Guide}" FontSize="20" FontAttributes="Bold"
                                       LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{localization:Translate AiBank.Workflow.Intro}" FontSize="13"
                                       LineBreakMode="WordWrap" TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid x:Name="GuidanceSteps" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto"
                              ColumnSpacing="16" RowSpacing="16" SizeChanged="OnGuidanceStepsSizeChanged">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{localization:Translate AiBank.Workflow.StepModel}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{localization:Translate AiBank.Workflow.StepModelHint}" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{localization:Translate AiBank.Workflow.StepConfigure}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{localization:Translate AiBank.Workflow.StepConfigureHint}" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="5">
                                <Label Text="{localization:Translate AiBank.Workflow.StepGenerate}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{localization:Translate AiBank.Workflow.StepGenerateHint}" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="5">
                                <Label Text="{localization:Translate AiBank.Workflow.StepReview}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{localization:Translate AiBank.Workflow.StepReviewHint}" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                        </VerticalStackLayout>
                        <Grid x:Name="GuidanceStatusRow"
                              ColumnDefinitions="*,Auto" RowDefinitions="Auto"
                              ColumnSpacing="12" RowSpacing="12">
                        <Label x:Name="WorkflowStatusLabel" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource ContentAccentTextColor}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                        <Button x:Name="GuidanceToggleButton" Style="{StaticResource SolverOutlinedActionStyle}"
                                Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center"
                                FontSize="13" Padding="12,8" MinimumHeightRequest="44"
                                Clicked="OnToggleGuidanceClicked" />
                        </Grid>
                        <VerticalStackLayout x:Name="GuidancePanel" IsVisible="False" Spacing="10">
                            <Grid x:Name="GuidanceFlowHost" HorizontalOptions="Center" MaximumWidthRequest="288" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" MaximumWidthRequest="288" HorizontalOptions="Fill">
                                <Label Text="{localization:Translate AiBank.Workflow.FlowCreate}" FontSize="13" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="{localization:Translate AiBank.Workflow.FlowReview}" FontSize="13" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="{localization:Translate AiBank.Workflow.FlowSave}" FontSize="13" HorizontalTextAlignment="Center" />
                            </Grid>
                            <Label Text="{localization:Translate AiBank.Workflow.SaveNote}" FontSize="13" LineBreakMode="WordWrap" />
                            <Label Text="{localization:Translate AiBank.Workflow.ReviewNote}" FontSize="13" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="ModelCard" Style="{StaticResource SolverCardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Grid x:Name="ModelSummaryHeader" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="ModelSummaryLabel" MaxLines="1" LineBreakMode="TailTruncation"
                                   FontAttributes="Bold" VerticalTextAlignment="Center" />
                            <Button x:Name="ModelDetailsToggleButton" Grid.Column="1" Style="{StaticResource SolverOutlinedActionStyle}"
                                    Clicked="OnToggleModelDetailsClicked" />
                        </Grid>
                        <VerticalStackLayout x:Name="ModelDetailsPanel" Spacing="10">
                        <Label Text="{localization:Translate AiBank.ModelSection}" Style="{StaticResource SolverSectionTitleStyle}" />
                        <Label x:Name="ModelStatusLabel" LineBreakMode="WordWrap" />
                        <Button x:Name="ChooseModelButton" controls:ActionIcon.Key="AiBank.ChooseModel" Text="{localization:Translate AiBank.ChooseModel, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnChooseModelClicked" />
                        <Button x:Name="ModelToolsToggleButton" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnToggleModelToolsClicked" />
                        <VerticalStackLayout x:Name="ModelToolsPanel" IsVisible="False" Spacing="8">
                        <Button x:Name="EjectModelButton" controls:ActionIcon.Key="Eject" Text="{localization:Translate AiBank.Eject, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnEjectClicked" />
                        <Button x:Name="OpenFolderButton" controls:ActionIcon.Key="AiBank.OpenFolder" Text="{localization:Translate AiBank.OpenFolder, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnOpenFolderClicked" />
                        <Label Text="{localization:Translate AiBank.DownloadHint}" />
                        <Border Style="{StaticResource AiBankPickerBorderStyle}">
                            <Picker x:Name="DownloadModelPicker" Style="{StaticResource AiBankPickerStyle}" />
                        </Border>
                        <Button x:Name="DownloadButton" controls:ActionIcon.Key="Download" Text="{localization:Translate AiBank.Download, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnDownloadClicked" />
                        </VerticalStackLayout>
                        <Button controls:ActionIcon.Key="AiBank.CancelModelAction" x:Name="CancelModelButton" Text="{localization:Translate AiBank.CancelModelAction, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnCancelModelClicked" IsEnabled="False" IsVisible="False" />
                        <ProgressBar x:Name="DownloadProgressBar" IsVisible="False" />
                        <Label x:Name="DownloadStatusLabel" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="ModelLiveStatusPanel" Spacing="6" IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <ActivityIndicator x:Name="ModelBusyIndicator" IsVisible="False" IsRunning="False"
                                                   WidthRequest="24" HeightRequest="24" Color="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                <Label x:Name="ModelGenerationStatusLabel" Grid.Column="1" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            </Grid>
                            <Label x:Name="ModelTokenSpeedLabel" FontSize="13" TextColor="{DynamicResource ContentAccentTextColor}" IsVisible="False" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Button controls:ActionIcon.Key="AiBank.Review.Open" x:Name="ReviewButton" Text="{localization:Translate AiBank.Review.Open, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnReviewClicked" />
                <Border x:Name="ProblemCard" Style="{StaticResource SolverCardStyle}">
                    <VerticalStackLayout x:Name="ConfigurationPanel" Spacing="10">
                        <Label Text="{localization:Translate AiBank.ProblemSection}" Style="{StaticResource SolverSectionTitleStyle}" />
                        <Label x:Name="MotionOpenHintLabel" Text="{localization:QuizTranslate Quiz.MotionOpenHint}" FontSize="13" IsVisible="False" />
                        <Label x:Name="MotionExtendedHintLabel" Text="{localization:QuizTranslate Quiz.MotionExtendedHint}" FontSize="13" IsVisible="False" />
                        <Label Text="{localization:Translate AiBank.ProblemType}" />
                        <Border Style="{StaticResource AiBankPickerBorderStyle}">
                            <Picker x:Name="ProblemPicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnBankProblemChanged" />
                        </Border>
                        <VerticalStackLayout x:Name="LearningGroupPanel" Spacing="8">
                        <Label Text="{localization:Translate Learning.Group}" />
                        <Border Style="{StaticResource AiBankPickerBorderStyle}">
                            <Picker x:Name="LearningGroupPicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnLearningGroupChanged" />
                        </Border>
                        </VerticalStackLayout>
                        <Label Text="{localization:Translate AiBank.Operation}" />
                        <Border Style="{StaticResource AiBankPickerBorderStyle}">
                            <Picker x:Name="OperationPicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnBankOperationChanged" />
                        </Border>
                        <VerticalStackLayout x:Name="FindXRolePanel" IsVisible="False" Spacing="8">
                            <Label Text="{localization:Translate FindXBank.UnknownRole}" />
                            <Border Style="{StaticResource AiBankPickerBorderStyle}">
                                <Picker x:Name="FindXRolePicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnFindXRoleChanged" />
                            </Border>
                        </VerticalStackLayout>
                        <Label Text="{localization:Translate AiBank.Difficulty}" />
                        <Border Style="{StaticResource AiBankPickerBorderStyle}">
                            <Picker x:Name="StarsPicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnBankOperationChanged" />
                        </Border>
                        <Label Text="{localization:Translate AiBank.GenerationMode}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Style="{StaticResource AiBankPickerBorderStyle}">
                                <Picker x:Name="BatchModePicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnBatchModeChanged" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource AiBankInputBorderStyle}">
                                <Entry x:Name="CountEntry" Text="10" Keyboard="Numeric" Placeholder="{localization:Translate AiBank.Count}" IsEnabled="False" />
                            </Border>
                        </Grid>
                        <Button x:Name="OtherOptionsToggleButton" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnToggleOtherOptionsClicked" />
                        <Label x:Name="OtherOptionsSummaryLabel" Style="{StaticResource AiBankMutedStatusStyle}" />
                        <VerticalStackLayout x:Name="OtherOptionsPanel" IsVisible="False" Spacing="10">
                            <Grid x:Name="CreativeProsePanel" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{localization:Translate AiBank.Review.Experimental}" VerticalOptions="Center" />
                                <Switch x:Name="CreativeProseSwitch" Grid.Column="1" IsToggled="False" />
                            </Grid>
                            <Label Text="{localization:Translate AiBank.Language}" />
                            <Border Style="{StaticResource AiBankPickerBorderStyle}">
                                <Picker x:Name="LanguagePicker" Style="{StaticResource AiBankPickerStyle}" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{localization:Translate AiBank.AutoInsert}" VerticalOptions="Center" />
                                <Switch x:Name="AutoInsertSwitch" Grid.Column="1" IsToggled="True" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- Keep the result boundary and its padding stable when status/selection text changes. -->
                <Border x:Name="ProcessedQuestionsCard" controls:SolverWorkspace.StartsResult="True"
                        Style="{StaticResource SolverCardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{localization:Translate AiBank.ProcessedQuestions}"
                               Style="{StaticResource SolverSectionTitleStyle}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding Text, Source={x:Reference JobStatusLabel}, x:DataType='Label'}"
                               IsVisible="{Binding IsVisible, Source={x:Reference JobStatusLabel}, x:DataType='Label'}"
                               Style="{StaticResource AiBankMutedStatusStyle}" />
                        <Label x:Name="ProcessedQuestionsEmptyLabel" Text="{localization:Translate AiBank.ProcessedQuestionsEmpty}"
                               Style="{StaticResource AiBankMutedStatusStyle}" />
                        <Border x:Name="ProcessedQuestionPickerFrame" IsVisible="False" Style="{StaticResource AiBankPickerBorderStyle}">
                            <Picker x:Name="QuestionPicker" Style="{StaticResource AiBankPickerStyle}" SelectedIndexChanged="OnQuestionSelected" IsEnabled="False" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="PreviewCard" Style="{StaticResource SolverCardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{localization:Translate AiBank.Preview}" Style="{StaticResource SolverSectionTitleStyle}" HorizontalTextAlignment="Center" />
                        <Label x:Name="PreviewStatusLabel" HorizontalTextAlignment="Center" FontSize="13" />
                        <controls:QuestionFactTableView x:Name="PreviewFactTable" />
                        <controls:FractionExpressionView x:Name="PreviewText" IsVisible="False" MathFontSize="22" WrapContent="True" HorizontalTextAlignment="Center" />
                        <Label x:Name="PreviewSolutionLabel" IsVisible="False" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                        <controls:FractionExpressionView x:Name="PreviewFractionSolution" IsVisible="False" MathFontSize="18"
                            ParseArithmeticExpressions="True" WrapContent="True" HorizontalTextAlignment="Center" />
                        <Label x:Name="PreviewStreamingTextLabel" IsVisible="False" FontSize="22" LineBreakMode="WordWrap"
                               HorizontalTextAlignment="Center" TextColor="{DynamicResource WallpaperTextPrimaryColor}" FontFamily="{DynamicResource AppFontFamily}" />
                        <Label x:Name="PreviewReadOnlyHint" IsVisible="False" Text="{localization:Translate AiBank.ReadOnlyHint}" HorizontalTextAlignment="Center" FontSize="13" />
                        <VerticalStackLayout x:Name="PreviewActionFooter" IsVisible="False" Spacing="12">
                            <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />
                            <controls:CompletionNotice x:Name="PreviewSaveCompletionNotice">
                                <Label Text="{Binding Text, Source={x:Reference PreviewStatusLabel}, x:DataType='Label'}"
                                       FontSize="14" LineBreakMode="WordWrap"
                                       TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                            </controls:CompletionNotice>
                            <Grid x:Name="PreviewActions" ColumnDefinitions="*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="8" SizeChanged="OnPreviewActionsSizeChanged">
                                <Button x:Name="InsertButton" controls:ActionIcon.Key="Save" Text="{localization:Translate AiBank.Insert, ActionIcons=True}"
                                        Style="{StaticResource AiBankPreviewPrimaryActionStyle}" Clicked="OnInsertClicked" IsEnabled="False" />
                                <Button x:Name="ShareButton" controls:ActionIcon.Key="Share" Grid.Row="1"
                                        Style="{StaticResource AiBankPreviewOutlinedActionStyle}" Clicked="OnShareClicked" IsEnabled="False" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="DiagnosticsCard" Style="{StaticResource SolverCardStyle}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Button x:Name="DiagnosticsToggleButton" controls:ActionIcon.Key="Code" Text="{localization:Translate AiBank.ShowDiagnostics, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnToggleDiagnosticsClicked" />
                        <Grid x:Name="DiagnosticsPanel" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*"
                              RowSpacing="12" ColumnSpacing="12" IsVisible="False" SizeChanged="OnDiagnosticsSizeChanged">
                            <Border x:Name="ContractDiagnosticCard" Style="{StaticResource AiBankDiagnosticCardStyle}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Label Text="{localization:Translate AiBank.Contract}" FontAttributes="Bold" />
                                    <Editor x:Name="ContractEditor" Grid.Row="1" Style="{StaticResource AiBankDiagnosticEditorStyle}" />
                                </Grid>
                            </Border>
                            <Border x:Name="RawJsonDiagnosticCard" Grid.Row="1" Style="{StaticResource AiBankDiagnosticCardStyle}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Label Text="{localization:Translate AiBank.RawJson}" FontAttributes="Bold" />
                                    <Editor x:Name="RawJsonEditor" Grid.Row="1" Style="{StaticResource AiBankDiagnosticEditorStyle}" />
                                </Grid>
                            </Border>
                            <Border x:Name="ValidationDiagnosticCard" Grid.Row="2" Style="{StaticResource AiBankDiagnosticCardStyle}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Label Text="{localization:Translate AiBank.ValidationLog}" FontAttributes="Bold" />
                                    <Editor x:Name="ValidationLogEditor" Grid.Row="1" Style="{StaticResource AiBankDiagnosticEditorStyle}" />
                                </Grid>
                            </Border>
                            <Border x:Name="PromptDiagnosticCard" Grid.Row="3" Style="{StaticResource AiBankDiagnosticCardStyle}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                    <Label Text="{localization:Translate AiBank.Prompt}" FontAttributes="Bold" />
                                    <Editor x:Name="PromptEditor" Grid.Row="1" Style="{StaticResource AiBankDiagnosticEditorStyle}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border x:Name="GenerationActionBar" Grid.Row="1" Style="{StaticResource SolverActionBarStyle}">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button controls:ActionIcon.Key="AiBank.Generate" x:Name="GenerateButton" Text="{localization:Translate AiBank.Generate, ActionIcons=True}" Style="{StaticResource SolverPrimaryActionStyle}" Clicked="OnGenerateClicked" />
                    <Button controls:ActionIcon.Key="AiBank.Stop" x:Name="StopButton" Grid.Column="1" Text="{localization:Translate AiBank.Stop, ActionIcons=True}" Style="{StaticResource SolverOutlinedActionStyle}" Clicked="OnStopClicked" IsEnabled="False" />
                </Grid>
                <controls:CompletionNotice x:Name="JobCompletionNotice">
                    <Label x:Name="JobStatusLabel" FontAttributes="Bold" FontSize="13" MaxLines="2" LineBreakMode="TailTruncation"
                           ToolTipProperties.Text="{Binding Text, Source={RelativeSource Self}, x:DataType='Label'}" />
                </controls:CompletionNotice>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
