<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.MathPuzzlePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="PracticeToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SolverOutlinedActionStyle}">
            <Setter Property="MinimumHeightRequest" Value="{DynamicResource Density.ControlHeight}" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAutoScalingEnabled" Value="True" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid
        x:Name="MathPuzzlePageContentRoot"
        RowDefinitions="Auto,*,Auto" SizeChanged="OnPracticeLayoutSizeChanged">

        <controls:LiveWallpaperView
            x:Name="LiveWallpaper"
            Grid.RowSpan="3" />

                <!-- Keep the status, actions and title outside the scrolling content. -->
                <VerticalStackLayout
                    x:Name="PracticeHeader"
                    Grid.Row="0"
                    Padding="{OnPlatform Android='12,10,12,10', WinUI='20,12,20,14', Default='20,12,20,14'}"
                    Spacing="{OnPlatform Android=10, WinUI=14, Default=14}"
                    MaximumWidthRequest="1320"
                    WidthRequest="{Binding Source={x:Reference MathPuzzlePageContentRoot}, Path=Width, x:DataType='Grid'}"
                    HorizontalOptions="Center">

                    <Border Style="{StaticResource SolverCardStyle}" Padding="12,6">
                        <Grid x:Name="PracticeSummaryGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                              ColumnSpacing="10" RowSpacing="0" SizeChanged="OnPracticeLayoutSizeChanged">
                            <Label x:Name="PracticeSummaryLabel" FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1"
                                   TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                            <Grid x:Name="PracticeSummaryActionsGrid" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto"
                                  RowDefinitions="Auto" ColumnSpacing="6" RowSpacing="6">
                                <Grid>
                                    <Button x:Name="ChangePracticeSettingsButton"
                                            Text="{localization:QuizTranslate Quiz.ChangeSettingsCompact}"
                                            Padding="32,4,10,4"
                                            Style="{StaticResource PracticeToolbarButtonStyle}"
                                            Clicked="OnChangePracticeSettingsClicked" />
                                    <controls:ThemedImageIcon x:Name="PracticeSettingsIcon"
                                            Source="quiz_collapse.png"
                                            FollowWallpaperContrast="True"
                                            WidthRequest="16" HeightRequest="16" Margin="10,0,0,0"
                                            HorizontalOptions="Start" VerticalOptions="Center"
                                            AutomationProperties.IsInAccessibleTree="False"
                                            Opacity="{Binding Source={x:Reference ChangePracticeSettingsButton}, Path=Opacity, x:DataType='Button'}" />
                                </Grid>
                                <Grid x:Name="OpenAiQuestionBankHost" Grid.Column="1">
                                    <Button x:Name="OpenAiQuestionBankButton"
                                            Text="{localization:Translate AiBank.OpenCompact}"
                                            Padding="32,4,10,4"
                                            SemanticProperties.Description="{localization:Translate AiBank.Title}"
                                            ToolTipProperties.Text="{localization:Translate AiBank.Title}"
                                            Style="{StaticResource PracticeToolbarButtonStyle}"
                                            Clicked="OnOpenAiQuestionBankClicked" />
                                    <controls:EmojiLabel x:Name="OpenAiQuestionBankEmojiLabel"
                                                        FontSize="16" WidthRequest="18" Margin="10,0,0,0"
                                                        HorizontalOptions="Start" VerticalOptions="Center"
                                                        HorizontalTextAlignment="Center"
                                                        Opacity="{Binding Source={x:Reference OpenAiQuestionBankButton}, Path=Opacity, x:DataType='Button'}" />
                                </Grid>
                                <Button x:Name="ExportQuizPdfButton" Grid.Column="2"
                                        Text="{localization:Translate QuizPdf.Export}"
                                        ImageSource="quiz_export_pdf.png"
                                        ContentLayout="Left,6"
                                        SemanticProperties.Description="{localization:Translate QuizPdf.Title}"
                                        ToolTipProperties.Text="{localization:Translate QuizPdf.Title}"
                                        Style="{StaticResource PracticeToolbarButtonStyle}"
                                        Clicked="OnExportQuizPdfClicked" />
                            </Grid>
                            <Grid x:Name="PracticeCompactActionsGrid" Grid.Column="1" IsVisible="False"
                                  ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <Grid>
                                    <Button x:Name="CompactPracticeSettingsButton" Text="" Padding="0"
                                            WidthRequest="{DynamicResource Density.ControlWidth}"
                                            MinimumWidthRequest="{DynamicResource Density.ControlWidth}"
                                            Style="{StaticResource PracticeToolbarButtonStyle}"
                                            Clicked="OnChangePracticeSettingsClicked" />
                                    <controls:ThemedImageIcon x:Name="PracticeCompactSettingsIcon" Source="quiz_collapse.png"
                                            FollowWallpaperContrast="True" WidthRequest="16" HeightRequest="16"
                                            HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"
                                            AutomationProperties.IsInAccessibleTree="False" />
                                </Grid>
                                <Button x:Name="MorePracticeActionsButton" Grid.Column="1" Text="⋯"
                                        FontSize="22" FontAutoScalingEnabled="False" Padding="0"
                                        WidthRequest="{DynamicResource Density.ControlWidth}"
                                        MinimumWidthRequest="{DynamicResource Density.ControlWidth}"
                                        SemanticProperties.Description="{localization:QuizTranslate Quiz.MoreActions}"
                                        ToolTipProperties.Text="{localization:QuizTranslate Quiz.MoreActions}"
                                        Style="{StaticResource PracticeToolbarButtonStyle}"
                                        Clicked="OnMorePracticeActionsClicked" />
                            </Grid>
                            <Label x:Name="AiQuestionBankProgressLabel" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                   IsVisible="False" FontSize="12" LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        x:Name="PracticeHero"
                        Margin="0,4,0,4"
                        Spacing="3">

                        <controls:EmojiLabel
                            x:Name="PracticeHeroEmojiLabel"
                            Style="{StaticResource SolverHeroSymbolStyle}" />

                        <Label
                            x:Name="PracticeHeroTitle"
                            Text="{localization:Translate Quiz.PracticeTitle}"
                            Style="{StaticResource SolverHeroTitleStyle}" />

                        <Label
                            x:Name="PracticeHeroSubtitle"
                            Text="{localization:QuizTranslate Quiz.PracticeSubtitleAlgorithmOnly}"
                            Style="{StaticResource SolverHeroSubtitleStyle}" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

        <ScrollView
            x:Name="MathPuzzleScrollView"
            SizeChanged="OnPracticeViewportSizeChanged"
            Grid.Row="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

                <VerticalStackLayout
                    x:Name="QuizContent"
                    Padding="{OnPlatform Android='12,0,12,20', WinUI='20,0,20,28', Default='20,0,20,28'}"
                    Spacing="{OnPlatform Android=10, WinUI=14, Default=14}"
                    MaximumWidthRequest="1320"
                    WidthRequest="{Binding Source={x:Reference MathPuzzleScrollView}, Path=Width, x:DataType='ScrollView'}"
                    HorizontalOptions="Center">

                    <VerticalStackLayout x:Name="PracticeSettingsPanel" Spacing="14" HorizontalOptions="Fill">
                    <Border Style="{StaticResource SolverCardStyle}">
                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="{localization:QuizTranslate Quiz.ModeTitleAlgorithmOnly}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                                x:Name="QuestionModeGrid"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Button
                                    x:Name="TrueFalseModeButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Quiz.TrueFalseMode}"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnTrueFalseModeClicked" />

                                <Button
                                    x:Name="MultipleChoiceModeButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Quiz.MultipleChoiceMode}"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnMultipleChoiceModeClicked" />

                                <Button
                                    x:Name="EssayModeButton"
                                    Grid.Column="2"
                                    Text="{localization:QuizTranslate Quiz.EssayMode}"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnEssayModeClicked" />

                            </Grid>

                            <Label
                                Text="{localization:QuizTranslate Quiz.CurriculumTitleAlgorithmOnly}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <!--
                                Keep all five difficulty choices fully readable on narrow Android screens.
                                Android uses a balanced 3 + 2 layout; desktop keeps the compact single row.
                                A six-column Android grid lets the first row use 2-column spans (3 equal cells)
                                and the second row use 3-column spans (2 equal cells) without rebuilding controls.
                            -->
                            <Grid
                                x:Name="CurriculumGrid"
                                ColumnDefinitions="{OnPlatform Android='*,*,*,*,*,*', Default='*,*,*,*,*'}"
                                RowDefinitions="{OnPlatform Android='Auto,Auto', Default='Auto'}"
                                ColumnSpacing="6"
                                RowSpacing="{OnPlatform Android=6, Default=0}">

                                <Button
                                    x:Name="CurriculumOneStarButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=1}"
                                    Text="★"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=16}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumOneStarClicked" />

                                <Button
                                    x:Name="CurriculumTwoStarsButton"
                                    Grid.Row="0"
                                    Grid.Column="{OnPlatform Android=2, Default=1}"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=1}"
                                    Text="★★"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=14}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumTwoStarsClicked" />

                                <Button
                                    x:Name="CurriculumThreeStarsButton"
                                    Grid.Row="0"
                                    Grid.Column="{OnPlatform Android=4, Default=2}"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=1}"
                                    Text="★★★"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=13}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumThreeStarsClicked" />

                                <Button
                                    x:Name="CurriculumFourStarsButton"
                                    Grid.Row="{OnPlatform Android=1, Default=0}"
                                    Grid.Column="{OnPlatform Android=0, Default=3}"
                                    Grid.ColumnSpan="{OnPlatform Android=3, Default=1}"
                                    Text="★★★★"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=12}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumFourStarsClicked" />

                                <Button
                                    x:Name="CurriculumFiveStarsButton"
                                    Grid.Row="{OnPlatform Android=1, Default=0}"
                                    Grid.Column="{OnPlatform Android=3, Default=4}"
                                    Grid.ColumnSpan="{OnPlatform Android=3, Default=1}"
                                    Text="★★★★★"
                                    MinimumHeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=11}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumFiveStarsClicked" />

                            </Grid>

                            <Label
                                x:Name="CurriculumHintLabel"
                                Text="{localization:Translate Quiz.CurriculumHintMixed}"
                                FontSize="13"
                                LineHeight="1.2"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Label
                                Text="{localization:QuizTranslate Quiz.OperationTitleAlgorithmOnly}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="OperationPicker"
                                        MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        SelectedIndexChanged="OnOperationChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>

                            </Border>

                            <VerticalStackLayout x:Name="PracticeFormatPanel" IsVisible="False" Spacing="8">
                                <Label x:Name="PracticeFormatTitleLabel" FontSize="15" FontAttributes="Bold" />
                                <Border Padding="0" BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Grid>
                                        <Picker x:Name="PracticeFormatPicker" FontSize="15" FontAttributes="Bold"
                                                MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                                HorizontalOptions="Fill" VerticalOptions="Fill"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                SelectedIndexChanged="OnPracticeFormatChanged" />
                                        <Path IsVisible="{OnPlatform Android=True, Default=False}" Data="M4,7 L10,13 L16,7 Z"
                                              Fill="{DynamicResource WallpaperTextSecondaryBrush}" WidthRequest="14" HeightRequest="14"
                                              Margin="0,0,18,0" HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                                    </Grid>
                                </Border>
                                <Label x:Name="PracticeFormatHintLabel" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="LearningProfilePanel" IsVisible="False" Spacing="8">
                                <Label Text="{localization:Translate Learning.Group}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                <Border Padding="0"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker x:Name="LearningGroupPicker"
                                                MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                                Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                                HorizontalOptions="Fill" VerticalOptions="Fill"
                                                FontSize="15" FontAttributes="Bold"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                SemanticProperties.Description="{localization:Translate Learning.Group}"
                                                SelectedIndexChanged="OnLearningGroupChanged" />
                                        <Path IsVisible="{OnPlatform Android=True, Default=False}"
                                              Data="M4,7 L10,13 L16,7 Z"
                                              Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                              WidthRequest="14" HeightRequest="14" Margin="0,0,18,0"
                                              HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                                    </Grid>
                                </Border>
                                <Label Text="{localization:Translate Learning.Hint}" FontSize="13" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="ElementaryTypePanel" IsVisible="False" Spacing="8">
                                <Label Text="{localization:QuizTranslate Quiz.ElementaryTypeTitle}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                <Border Padding="0"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker x:Name="ElementaryTypePicker"
                                                MinimumHeightRequest="{OnPlatform Android=56, Default=50}"
                                                FontSize="16" FontAttributes="Bold"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                SelectedIndexChanged="OnElementaryTypeChanged" />
                                        <Path IsVisible="{OnPlatform Android=True, Default=False}"
                                              Data="M4,7 L10,13 L16,7 Z"
                                              Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                              WidthRequest="14" HeightRequest="14" Margin="0,0,18,0"
                                              HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="ExpressionTypePanel" IsVisible="False" Spacing="8">
                                <Label Text="{localization:QuizTranslate Quiz.ExpressionTypeTitle}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                <Border Padding="0"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker x:Name="ExpressionTypePicker"
                                                MinimumHeightRequest="{OnPlatform Android=56, Default=50}"
                                                FontSize="16" FontAttributes="Bold"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                SelectedIndexChanged="OnExpressionTypeChanged" />
                                        <Path IsVisible="{OnPlatform Android=True, Default=False}"
                                              Data="M4,7 L10,13 L16,7 Z"
                                              Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                              WidthRequest="14" HeightRequest="14" Margin="0,0,18,0"
                                              HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="ProblemOperationPanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    x:Name="ProblemOperationTitleLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button
                                        x:Name="ProblemMixedButton"
                                        Text="{localization:QuizTranslate Quiz.SubtypeMixed}"
                                        MinimumHeightRequest="48"
                                        CornerRadius="12"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Clicked="OnProblemMixedClicked" />
                                    <Button x:Name="ProblemCompareButton" Grid.Column="1"
                                            Text="{localization:QuizTranslate Quiz.ComparisonSubtype}"
                                            MinimumHeightRequest="48" CornerRadius="12" FontSize="14" FontAttributes="Bold"
                                            Clicked="OnProblemCompareClicked" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,*,*,*"
                                    ColumnSpacing="8">

                                    <Button x:Name="ProblemAddButton" Grid.Column="0" Text="+" MinimumHeightRequest="48" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemAddClicked" />
                                    <Button x:Name="ProblemSubtractButton" Grid.Column="1" Text="−" MinimumHeightRequest="48" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemSubtractClicked" />
                                    <Button x:Name="ProblemMultiplyButton" Grid.Column="2" Text="×" MinimumHeightRequest="48" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemMultiplyClicked" />
                                    <Button x:Name="ProblemDivideButton" Grid.Column="3" Text="÷" MinimumHeightRequest="48" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemDivideClicked" />

                                </Grid>

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="ProportionTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.ProportionTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Button
                                        x:Name="MixedProportionButton"
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Text="{localization:QuizTranslate Quiz.OperationMixed}"
                                        MinimumHeightRequest="48"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnMixedProportionClicked" />
                                    <Button
                                        x:Name="DirectProportionButton"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{localization:QuizTranslate Quiz.ProportionDirect}"
                                        MinimumHeightRequest="48"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnDirectProportionClicked" />
                                    <Button
                                        x:Name="InverseProportionButton"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{localization:QuizTranslate Quiz.ProportionInverse}"
                                        MinimumHeightRequest="48"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnInverseProportionClicked" />
                                    <Button
                                        x:Name="UnitaryGroupCountButton"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Text="{localization:QuizTranslate Quiz.ProportionUnitaryGroupCount}"
                                        MinimumHeightRequest="48"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnUnitaryGroupCountClicked" />
                                </Grid>

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="MotionTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.MotionTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="MotionTypePicker"
                                            MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnMotionTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="AverageTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.AverageTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="AverageTypePicker"
                                            MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnAverageTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="PercentageTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.PercentageTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="PercentageTypePicker"
                                            MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnPercentageTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="FindXTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.FindXTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="FindXTypePicker"
                                            MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnFindXTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="GeometryShapePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.GeometryShapeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="GeometryShapePicker"
                                            MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnGeometryShapeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>

                                <Label
                                    Text="{localization:QuizTranslate Quiz.GeometryMeasurementTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker
                                            x:Name="GeometryMeasurementPicker"
                                            MinimumHeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnGeometryMeasurementChanged" />
                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                        <Button x:Name="StartPracticeButton" Text="{localization:QuizTranslate Quiz.StartPractice}"
                                IsEnabled="False" Style="{StaticResource SolverPrimaryActionStyle}"
                                Clicked="OnStartPracticeClicked" />
                    </VerticalStackLayout>

                    <Border x:Name="PracticeQuestionStart"
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="12">

                            <Label
                                x:Name="QuestionCounterLabel"
                                Grid.Column="0"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                            <Label
                                x:Name="CorrectScoreLabel"
                                Grid.Column="1"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ContentSuccessTextColor}"
                                VerticalTextAlignment="Center" />

                            <Label
                                x:Name="IncorrectScoreLabel"
                                Grid.Column="2"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ContentDangerTextColor}"
                                VerticalTextAlignment="Center" />

                        </Grid>
                    </Border>

                    <Border
                        x:Name="QuestionCard"
                        Padding="18"
                        BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                        StrokeThickness="1.5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">

                            <Label
                                x:Name="QuestionPromptLabel"
                                Text="{localization:Translate Quiz.QuestionTitle}"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                SemanticProperties.HeadingLevel="Level2"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Button x:Name="QuizDiagramToggleButton" IsVisible="False"
                                    Text="{localization:QuizTranslate Quiz.ShowDiagram}"
                                    Clicked="OnQuizDiagramToggleClicked" HorizontalOptions="Center"
                                    CornerRadius="12" />

                            <Label x:Name="QuestionCurriculumLabel" IsVisible="False" FontSize="12"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Grid x:Name="QuestionDiagramGrid" RowDefinitions="Auto,Auto"
                                  RowSpacing="16" ColumnSpacing="20" SizeChanged="OnQuestionDiagramSizeChanged">
                                <VerticalStackLayout x:Name="QuestionTextPanel" Spacing="8" VerticalOptions="Center">
                                    <controls:QuestionFactTableView x:Name="PracticeFactTable" />
                                    <Label x:Name="QuestionExpressionLabel" FontSize="34" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                           TextColor="{DynamicResource ContentAccentTextColor}" />
                                    <controls:FractionExpressionView x:Name="QuestionFractionExpressionView"
                                        IsVisible="False" MathFontSize="21" MathColor="{DynamicResource ContentAccentTextColor}"
                                        HorizontalTextAlignment="Center" WrapContent="True" TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                    <controls:FractionExpressionView x:Name="QuestionComparisonFractionView"
                                        IsVisible="False" MathFontSize="32" MathColor="{DynamicResource ContentAccentTextColor}"
                                        HorizontalTextAlignment="Center" WrapContent="True" TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                    <Label x:Name="NumericResultLabel" IsVisible="False"
                                           FontSize="34" FontAttributes="Bold" MinimumHeightRequest="56"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                           TextColor="{DynamicResource ContentAccentTextColor}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="QuizDiagramPanel" Grid.Row="1" IsVisible="False" Spacing="8">
                                    <Label x:Name="QuizDiagramCaptionLabel" FontSize="15" FontAttributes="Bold"
                                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <controls:FractionExpressionView x:Name="QuizDiagramCaptionFractionView"
                                        IsVisible="False" MathFontSize="15" WrapContent="True" TokenSpacing="4"
                                        ParseArithmeticExpressions="True" HorizontalTextAlignment="Center"
                                        HorizontalOptions="Fill" MathColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <GraphicsView x:Name="QuizVisualView" IsVisible="False" HeightRequest="260"
                                                  HorizontalOptions="Fill" />
                                    <Label x:Name="QuizVisualDataLabel" IsVisible="False" FontSize="14"
                                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                    <Label x:Name="QuizDiagramNoteLabel" IsVisible="False" FontSize="12"
                                           Text="{localization:QuizTranslate Quiz.DiagramNotToScale}"
                                           HorizontalTextAlignment="Center" TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                    <Label x:Name="QuizDiagramExplanationLabel" IsVisible="False" FontSize="15"
                                           LineBreakMode="WordWrap" TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <controls:FractionExpressionView x:Name="QuizDiagramExplanationFractionView"
                                        IsVisible="False" MathFontSize="15" WrapContent="True" TokenSpacing="4"
                                        HorizontalOptions="Fill" MathColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <Button Text="{localization:QuizTranslate Quiz.EnlargeDiagram}"
                                            Clicked="OnEnlargeQuizDiagramClicked" HorizontalOptions="Center" CornerRadius="12" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label
                                x:Name="PresentedAnswerLabel"
                                IsVisible="False"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource ContentAccentTextColor}" />

                            <controls:FractionExpressionView
                                x:Name="PresentedAnswerFractionView"
                                IsVisible="False"
                                MathFontSize="18"
                                MathColor="{DynamicResource ContentAccentTextColor}"
                                HorizontalTextAlignment="Center"
                                WrapContent="True"
                                HorizontalOptions="Fill" />

                            <Grid
                                x:Name="TrueFalseAnswerGrid"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12">

                                <Button
                                    x:Name="TrueAnswerButton"
                                    Grid.Column="0"
                                    CommandParameter="true"
                                    MinimumHeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSuccessSoftColor}"
                                    BorderColor="{DynamicResource SuccessColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource ContentSuccessTextColor}"
                                    Clicked="OnTrueFalseAnswerClicked" />

                                <Button
                                    x:Name="FalseAnswerButton"
                                    Grid.Column="1"
                                    CommandParameter="false"
                                    MinimumHeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                                    BorderColor="{DynamicResource DangerColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource ContentDangerTextColor}"
                                    Clicked="OnTrueFalseAnswerClicked" />

                            </Grid>

                            <Grid
                                x:Name="MultipleChoiceAnswerGrid"
                                SizeChanged="OnAnswerGridSizeChanged"
                                IsVisible="False"
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="*,*"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="ChoiceAButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    MinimumHeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceBButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    MinimumHeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceCButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    MinimumHeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceDButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinimumHeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceAFractionView"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceBFractionView"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceCFractionView"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceDFractionView"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                            </Grid>

                            <VerticalStackLayout
                                x:Name="EssayAnswerLayout"
                                IsVisible="False"
                                HorizontalOptions="Fill"
                                Spacing="10">

                                <VerticalStackLayout
                                    x:Name="EssayWorkSection"
                                    Spacing="10">

                                    <Label
                                        x:Name="EssayWorkLabel"
                                        Text="{localization:QuizTranslate Quiz.EssayCombinedLabel}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Border
                                        Padding="12,8"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <Editor
                                            x:Name="EssayWorkEditor"
                                            Focused="OnEssayWorkFocused"
                                            TextChanged="OnEssayWorkTextChanged"
                                            MinimumHeightRequest="180"
                                            AutoSize="TextChanges"
                                            FontSize="16"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            Placeholder="{localization:QuizTranslate Quiz.EssayCombinedPlaceholder}"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                    </Border>

                                </VerticalStackLayout>

                                <Label
                                    x:Name="EssayValidationHintLabel"
                                    Text="{localization:QuizTranslate Quiz.EssayValidationHint}"
                                    FontSize="14"
                                    LineHeight="1.2"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />


                            </VerticalStackLayout>

                            <Border
                                x:Name="FeedbackBorder"
                                IsVisible="False"
                                Padding="12"
                                BackgroundColor="{DynamicResource WallpaperSuccessSoftColor}"
                                Stroke="{DynamicResource SuccessBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Label
                                        x:Name="FeedbackLabel"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource ContentSuccessTextColor}" />

                                    <controls:FractionExpressionView
                                        x:Name="FeedbackFractionView"
                                        IsVisible="False"
                                        MathFontSize="17"
                                        MathColor="{DynamicResource SuccessColor}"
                                        HorizontalTextAlignment="Center"
                                        WrapContent="True"
                                        TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                </Grid>

                            </Border>

                            <Border
                                x:Name="SolutionBorder"
                                IsVisible="False"
                                Padding="14"
                                BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                                Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="{localization:Translate Quiz.SolutionTitle}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Label
                                        x:Name="SolutionLabel"
                                        FontSize="17"
                                        LineHeight="1.3"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <controls:FractionExpressionView
                                        x:Name="SolutionFractionView"
                                        IsVisible="False"
                                        MathFontSize="17"
                                        MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        HorizontalTextAlignment="Start"
                                        WrapContent="True"
                                        TokenSpacing="4"
                                        HorizontalOptions="Fill" />

                                </VerticalStackLayout>
                            </Border>


                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{localization:Translate Quiz.ValidationHint}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                </VerticalStackLayout>
        </ScrollView>
        <Border x:Name="PracticeActionBar" Grid.Row="2" Style="{StaticResource SolverActionBarStyle}">
            <Grid x:Name="PracticeActionButtons" ColumnDefinitions="*,*" ColumnSpacing="10">
                <controls:EmojiActionButton x:Name="SubmitEssayAnswerButton" Grid.Column="0"
                        Caption="{localization:QuizTranslate Quiz.CheckAnswer}"
                        Style="{StaticResource SolverPrimaryActionStyle}" FontSize="14" LineBreakMode="WordWrap"
                        IsEnabled="False" Clicked="OnCheckAnswerClicked" />
                <Button x:Name="NextQuestionButton" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="{localization:Translate Quiz.NextQuestion}"
                        Style="{StaticResource SolverPrimaryActionStyle}" FontSize="14" LineBreakMode="WordWrap"
                        IsVisible="False" IsEnabled="False" Clicked="OnNextQuestionClicked" />
                <controls:EmojiActionButton x:Name="RegenerateQuestionButton" Grid.Column="1"
                        Caption="{localization:QuizTranslate Quiz.RegenerateQuestionCompact}"
                        SemanticProperties.Description="{localization:QuizTranslate Quiz.RegenerateQuestion}"
                        ToolTipProperties.Text="{localization:QuizTranslate Quiz.RegenerateQuestion}"
                        Style="{StaticResource SolverOutlinedActionStyle}" FontSize="14" LineBreakMode="WordWrap"
                        Clicked="OnRegenerateQuestionClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
