<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.MathPuzzlePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid
        x:Name="MathPuzzlePageContentRoot"
        RowDefinitions="*">

        <controls:LiveWallpaperView
            x:Name="LiveWallpaper" />

        <ScrollView
            x:Name="MathPuzzleScrollView"
            Grid.Row="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

                <VerticalStackLayout
                    Padding="{OnPlatform Android='12,10,12,20', WinUI='20,12,20,28', Default='20,12,20,28'}"
                    Spacing="{OnPlatform Android=10, WinUI=14, Default=14}"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout
                        Margin="0,4,0,4"
                        Spacing="3">

                        <Label
                            Text="?  + − × ÷"
                            Style="{StaticResource SolverHeroSymbolStyle}" />

                        <Label
                            Text="{localization:Translate Quiz.PracticeTitle}"
                            Style="{StaticResource SolverHeroTitleStyle}" />

                        <Label
                            Text="{localization:QuizTranslate Quiz.PracticeSubtitleAlgorithmOnly}"
                            Style="{StaticResource SolverHeroSubtitleStyle}" />

                    </VerticalStackLayout>

                    <Border Style="{StaticResource SolverCardStyle}">
                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="{localization:QuizTranslate Quiz.ModeTitleAlgorithmOnly}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                                x:Name="QuestionModeGrid"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="8"
                                RowSpacing="8">

                                <Button
                                    x:Name="TrueFalseModeButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Quiz.TrueFalseMode}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnTrueFalseModeClicked" />

                                <Button
                                    x:Name="MultipleChoiceModeButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Quiz.MultipleChoiceMode}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnMultipleChoiceModeClicked" />

                                <Button
                                    x:Name="EssayModeButton"
                                    Grid.Column="2"
                                    Text="{localization:QuizTranslate Quiz.EssayMode}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnEssayModeClicked" />

                            </Grid>

                            <Label
                                Text="{localization:QuizTranslate Quiz.CurriculumTitleAlgorithmOnly}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <!--
                                Keep all five difficulty choices fully readable on narrow Android screens.
                                Android uses a balanced 3 + 2 layout; desktop keeps the compact single row.
                                A six-column Android grid lets the first row use 2-column spans (3 equal cells)
                                and the second row use 3-column spans (2 equal cells) without rebuilding controls.
                            -->
                            <Grid
                                ColumnDefinitions="{OnPlatform Android='*,*,*,*,*,*', Default='*,*,*,*,*'}"
                                RowDefinitions="{OnPlatform Android='Auto,Auto', Default='Auto'}"
                                ColumnSpacing="6"
                                RowSpacing="{OnPlatform Android=6, Default=0}">

                                <Button
                                    x:Name="CurriculumOneStarButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=1}"
                                    Text="★"
                                    HeightRequest="46"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=16}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumOneStarClicked" />

                                <Button
                                    x:Name="CurriculumTwoStarsButton"
                                    Grid.Row="0"
                                    Grid.Column="{OnPlatform Android=2, Default=1}"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=1}"
                                    Text="★★"
                                    HeightRequest="46"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=14}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumTwoStarsClicked" />

                                <Button
                                    x:Name="CurriculumThreeStarsButton"
                                    Grid.Row="0"
                                    Grid.Column="{OnPlatform Android=4, Default=2}"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=1}"
                                    Text="★★★"
                                    HeightRequest="46"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=13}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumThreeStarsClicked" />

                                <Button
                                    x:Name="CurriculumFourStarsButton"
                                    Grid.Row="{OnPlatform Android=1, Default=0}"
                                    Grid.Column="{OnPlatform Android=0, Default=3}"
                                    Grid.ColumnSpan="{OnPlatform Android=3, Default=1}"
                                    Text="★★★★"
                                    HeightRequest="46"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=12}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumFourStarsClicked" />

                                <Button
                                    x:Name="CurriculumFiveStarsButton"
                                    Grid.Row="{OnPlatform Android=1, Default=0}"
                                    Grid.Column="{OnPlatform Android=3, Default=4}"
                                    Grid.ColumnSpan="{OnPlatform Android=3, Default=1}"
                                    Text="★★★★★"
                                    HeightRequest="46"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=15, Default=11}"
                                    FontAttributes="Bold"
                                    Clicked="OnCurriculumFiveStarsClicked" />

                            </Grid>

                            <Label
                                x:Name="CurriculumHintLabel"
                                Text="{localization:Translate Quiz.CurriculumHintMixed}"
                                FontSize="13"
                                LineHeight="1.2"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Label
                                Text="{localization:QuizTranslate Quiz.OperationTitleAlgorithmOnly}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="OperationPicker"
                                        HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        SelectedIndexChanged="OnOperationChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>

                            </Border>

                            <VerticalStackLayout x:Name="ElementaryTypePanel" IsVisible="False" Spacing="8">
                                <Label Text="{localization:QuizTranslate Quiz.ElementaryTypeTitle}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                <Border Padding="0"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker x:Name="ElementaryTypePicker"
                                                HeightRequest="{OnPlatform Android=56, Default=50}"
                                                FontSize="16" FontAttributes="Bold"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                SelectedIndexChanged="OnElementaryTypeChanged" />
                                        <Path IsVisible="{OnPlatform Android=True, Default=False}"
                                              Data="M4,7 L10,13 L16,7 Z"
                                              Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                              WidthRequest="14" HeightRequest="14" Margin="0,0,18,0"
                                              HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="ExpressionTypePanel" IsVisible="False" Spacing="8">
                                <Label Text="{localization:QuizTranslate Quiz.ExpressionTypeTitle}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                <Border Padding="0"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker x:Name="ExpressionTypePicker"
                                                HeightRequest="{OnPlatform Android=56, Default=50}"
                                                FontSize="16" FontAttributes="Bold"
                                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                SelectedIndexChanged="OnExpressionTypeChanged" />
                                        <Path IsVisible="{OnPlatform Android=True, Default=False}"
                                              Data="M4,7 L10,13 L16,7 Z"
                                              Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                              WidthRequest="14" HeightRequest="14" Margin="0,0,18,0"
                                              HorizontalOptions="End" VerticalOptions="Center" InputTransparent="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="ProblemOperationPanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    x:Name="ProblemOperationTitleLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button
                                        x:Name="ProblemMixedButton"
                                        Text="{localization:QuizTranslate Quiz.SubtypeMixed}"
                                        HeightRequest="44"
                                        CornerRadius="12"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Clicked="OnProblemMixedClicked" />
                                    <Button x:Name="ProblemCompareButton" Grid.Column="1"
                                            Text="{localization:QuizTranslate Quiz.ComparisonSubtype}"
                                            HeightRequest="44" CornerRadius="12" FontSize="14" FontAttributes="Bold"
                                            Clicked="OnProblemCompareClicked" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,*,*,*"
                                    ColumnSpacing="8">

                                    <Button x:Name="ProblemAddButton" Grid.Column="0" Text="+" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemAddClicked" />
                                    <Button x:Name="ProblemSubtractButton" Grid.Column="1" Text="−" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemSubtractClicked" />
                                    <Button x:Name="ProblemMultiplyButton" Grid.Column="2" Text="×" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemMultiplyClicked" />
                                    <Button x:Name="ProblemDivideButton" Grid.Column="3" Text="÷" HeightRequest="46" CornerRadius="12" FontSize="20" FontAttributes="Bold" Clicked="OnProblemDivideClicked" />

                                </Grid>

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="ProportionTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.ProportionTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Button
                                        x:Name="MixedProportionButton"
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Text="{localization:QuizTranslate Quiz.OperationMixed}"
                                        HeightRequest="46"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnMixedProportionClicked" />
                                    <Button
                                        x:Name="DirectProportionButton"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{localization:QuizTranslate Quiz.ProportionDirect}"
                                        HeightRequest="46"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnDirectProportionClicked" />
                                    <Button
                                        x:Name="InverseProportionButton"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{localization:QuizTranslate Quiz.ProportionInverse}"
                                        HeightRequest="46"
                                        CornerRadius="12"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Clicked="OnInverseProportionClicked" />
                                </Grid>

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                x:Name="MotionTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.MotionTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="MotionTypePicker"
                                            HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnMotionTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="AverageTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.AverageTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="AverageTypePicker"
                                            HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnAverageTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="PercentageTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.PercentageTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="PercentageTypePicker"
                                            HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnPercentageTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="FindXTypePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.FindXTypeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="FindXTypePicker"
                                            HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnFindXTypeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="GeometryShapePanel"
                                IsVisible="False"
                                Spacing="8">

                                <Label
                                    Text="{localization:QuizTranslate Quiz.GeometryShapeTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid>
                                        <Picker
                                            x:Name="GeometryShapePicker"
                                            HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnGeometryShapeChanged" />

                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>

                                </Border>

                                <Label
                                    Text="{localization:QuizTranslate Quiz.GeometryMeasurementTitle}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    Padding="0"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Picker
                                            x:Name="GeometryMeasurementPicker"
                                            HeightRequest="{OnPlatform Android=56, WinUI=50, Default=50}"
                                            Margin="{OnPlatform Android='0', WinUI='0', Default='14,0,0,0'}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            SelectedIndexChanged="OnGeometryMeasurementChanged" />
                                        <Path
                                            IsVisible="{OnPlatform Android=True, Default=False}"
                                            Data="M4,7 L10,13 L16,7 Z"
                                            Fill="{DynamicResource WallpaperTextSecondaryBrush}"
                                            WidthRequest="14"
                                            HeightRequest="14"
                                            Margin="0,0,18,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            InputTransparent="True" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <Button
                        Text="{localization:Translate AiBank.Open}"
                        Style="{StaticResource SolverOutlinedActionStyle}"
                        Clicked="OnOpenAiQuestionBankClicked" />
                    <Label x:Name="AiQuestionBankProgressLabel" IsVisible="False" FontSize="13" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="12">

                            <Label
                                x:Name="QuestionCounterLabel"
                                Grid.Column="0"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                            <Label
                                x:Name="CorrectScoreLabel"
                                Grid.Column="1"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}"
                                VerticalTextAlignment="Center" />

                            <Label
                                x:Name="IncorrectScoreLabel"
                                Grid.Column="2"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}"
                                VerticalTextAlignment="Center" />

                        </Grid>
                    </Border>

                    <Border
                        Padding="18"
                        BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                        Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                        StrokeThickness="1.5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">

                            <Label
                                x:Name="QuestionPromptLabel"
                                Text="{localization:Translate Quiz.QuestionTitle}"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Button x:Name="QuizDiagramToggleButton" IsVisible="False"
                                    Text="{localization:QuizTranslate Quiz.ShowDiagram}"
                                    Clicked="OnQuizDiagramToggleClicked" HorizontalOptions="Center"
                                    CornerRadius="12" />

                            <Grid x:Name="QuestionDiagramGrid" RowDefinitions="Auto,Auto"
                                  RowSpacing="16" ColumnSpacing="20" SizeChanged="OnQuestionDiagramSizeChanged">
                                <VerticalStackLayout x:Name="QuestionTextPanel" Spacing="8" VerticalOptions="Center">
                                    <Label x:Name="QuestionExpressionLabel" FontSize="34" FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                           TextColor="{DynamicResource PrimaryColor}" />
                                    <controls:FractionExpressionView x:Name="QuestionFractionExpressionView"
                                        IsVisible="False" MathFontSize="21" MathColor="{DynamicResource PrimaryColor}"
                                        HorizontalTextAlignment="Center" WrapContent="True" TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                    <controls:FractionExpressionView x:Name="QuestionComparisonFractionView"
                                        IsVisible="False" MathFontSize="32" MathColor="{DynamicResource PrimaryColor}"
                                        HorizontalTextAlignment="Center" WrapContent="True" TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                    <Label x:Name="NumericResultLabel" IsVisible="False"
                                           FontSize="34" FontAttributes="Bold" MinimumHeightRequest="56"
                                           HorizontalOptions="Fill" HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                           TextColor="{DynamicResource PrimaryColor}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="QuizDiagramPanel" Grid.Row="1" IsVisible="False" Spacing="8">
                                    <Label x:Name="QuizDiagramCaptionLabel" FontSize="15" FontAttributes="Bold"
                                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <GraphicsView x:Name="QuizVisualView" IsVisible="False" HeightRequest="260"
                                                  HorizontalOptions="Fill" />
                                    <Label x:Name="QuizVisualDataLabel" IsVisible="False" FontSize="14"
                                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                    <Label x:Name="QuizDiagramNoteLabel" IsVisible="False" FontSize="12"
                                           Text="{localization:QuizTranslate Quiz.DiagramNotToScale}"
                                           HorizontalTextAlignment="Center" TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                                    <Label x:Name="QuizDiagramExplanationLabel" IsVisible="False" FontSize="15"
                                           LineBreakMode="WordWrap" TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <controls:FractionExpressionView x:Name="QuizDiagramExplanationFractionView"
                                        IsVisible="False" MathFontSize="15" WrapContent="True" TokenSpacing="4"
                                        HorizontalOptions="Fill" MathColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                    <Button Text="{localization:QuizTranslate Quiz.EnlargeDiagram}"
                                            Clicked="OnEnlargeQuizDiagramClicked" HorizontalOptions="Center" CornerRadius="12" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label
                                x:Name="PresentedAnswerLabel"
                                IsVisible="False"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <controls:FractionExpressionView
                                x:Name="PresentedAnswerFractionView"
                                IsVisible="False"
                                MathFontSize="18"
                                MathColor="{DynamicResource PrimaryColor}"
                                HorizontalTextAlignment="Center"
                                WrapContent="True"
                                HorizontalOptions="Fill" />

                            <Grid
                                x:Name="TrueFalseAnswerGrid"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12">

                                <Button
                                    x:Name="TrueAnswerButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Quiz.TrueAnswer}"
                                    CommandParameter="true"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSuccessSoftColor}"
                                    BorderColor="{DynamicResource SuccessColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource SuccessColor}"
                                    Clicked="OnTrueFalseAnswerClicked" />

                                <Button
                                    x:Name="FalseAnswerButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Quiz.FalseAnswer}"
                                    CommandParameter="false"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                                    BorderColor="{DynamicResource DangerColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource DangerColor}"
                                    Clicked="OnTrueFalseAnswerClicked" />

                            </Grid>

                            <Grid
                                x:Name="MultipleChoiceAnswerGrid"
                                IsVisible="False"
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="*,*"
                                RowSpacing="10"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="ChoiceAButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceBButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceCButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <Button
                                    x:Name="ChoiceDButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HeightRequest="54"
                                    CornerRadius="12"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                    BorderColor="{DynamicResource WallpaperBorderColor}"
                                    BorderWidth="1"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    Clicked="OnChoiceAnswerClicked" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceAFractionView"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceBFractionView"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceCFractionView"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                                <controls:FractionExpressionView
                                    x:Name="ChoiceDFractionView"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    Margin="12,8"
                                    MathFontSize="16"
                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    HorizontalTextAlignment="Center"
                                    WrapContent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                            </Grid>

                            <VerticalStackLayout
                                x:Name="EssayAnswerLayout"
                                IsVisible="False"
                                Spacing="10">

                                <VerticalStackLayout
                                    x:Name="EssayWorkSection"
                                    Spacing="10">

                                    <Label
                                        x:Name="EssayWorkLabel"
                                        Text="{localization:QuizTranslate Quiz.EssayCombinedLabel}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Border
                                        Padding="12,8"
                                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>

                                        <Editor
                                            x:Name="EssayWorkEditor"
                                            MinimumHeightRequest="180"
                                            AutoSize="TextChanges"
                                            FontSize="16"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            Placeholder="{localization:QuizTranslate Quiz.EssayCombinedPlaceholder}"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                    </Border>

                                </VerticalStackLayout>

                                <Label
                                    x:Name="EssayValidationHintLabel"
                                    Text="{localization:QuizTranslate Quiz.EssayValidationHint}"
                                    FontSize="14"
                                    LineHeight="1.2"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Button
                                    x:Name="SubmitEssayAnswerButton"
                                    Text="{localization:QuizTranslate Quiz.SubmitEssayAnswer}"
                                    HeightRequest="50"
                                    CornerRadius="12"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnSubmitEssayAnswerClicked" />

                            </VerticalStackLayout>

                            <Border
                                x:Name="FeedbackBorder"
                                IsVisible="False"
                                Padding="12"
                                BackgroundColor="{DynamicResource WallpaperSuccessSoftColor}"
                                Stroke="{DynamicResource SuccessBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Label
                                        x:Name="FeedbackLabel"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource SuccessColor}" />

                                    <controls:FractionExpressionView
                                        x:Name="FeedbackFractionView"
                                        IsVisible="False"
                                        MathFontSize="17"
                                        MathColor="{DynamicResource SuccessColor}"
                                        HorizontalTextAlignment="Center"
                                        WrapContent="True"
                                        TokenSpacing="4"
                                        HorizontalOptions="Fill" />
                                </Grid>

                            </Border>

                            <Border
                                x:Name="SolutionBorder"
                                IsVisible="False"
                                Padding="14"
                                BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                                Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="{localization:Translate Quiz.SolutionTitle}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Label
                                        x:Name="SolutionLabel"
                                        FontSize="17"
                                        LineHeight="1.3"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <controls:FractionExpressionView
                                        x:Name="SolutionFractionView"
                                        IsVisible="False"
                                        MathFontSize="17"
                                        MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        HorizontalTextAlignment="Start"
                                        WrapContent="True"
                                        TokenSpacing="4"
                                        HorizontalOptions="Fill" />

                                </VerticalStackLayout>
                            </Border>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="RegenerateQuestionButton"
                                    Grid.Column="0"
                                    Text="{localization:QuizTranslate Quiz.RegenerateQuestion}"
                                    HeightRequest="50"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=14, WinUI=16, Default=16}"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnRegenerateQuestionClicked" />

                                <Button
                                    x:Name="NextQuestionButton"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    Text="{localization:Translate Quiz.NextQuestion}"
                                    HeightRequest="50"
                                    CornerRadius="12"
                                    FontSize="{OnPlatform Android=14, WinUI=16, Default=16}"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnNextQuestionClicked" />

                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{localization:Translate Quiz.ValidationHint}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
