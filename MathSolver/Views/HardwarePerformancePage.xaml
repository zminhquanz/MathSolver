<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.HardwarePerformancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:local="clr-namespace:MathSolver.Views"
    Title="Thông tin phần cứng"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <!-- Dùng cùng vị trí tiêu đề với trang Cài đặt giao diện. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid
            Padding="{OnPlatform Android='0,0,8,0', WinUI='2,0,10,0', Default='2,0,10,0'}"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{OnPlatform Android=2, WinUI=6, Default=6}">

            <Grid
                Grid.Column="0"
                WidthRequest="{OnPlatform Android=48, WinUI=40, Default=40}"
                HeightRequest="{OnPlatform Android=48, WinUI=40, Default=40}"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Button
                    x:Name="HardwareBackButton"
                    Style="{StaticResource PlatformBackButtonStyle}"
                    controls:InteractiveButtonAnimation.IsScopeEnabled="True"
                    controls:InteractiveButtonAnimation.IsPlatformBackButton="True"
                    SemanticProperties.Description="Quay lại"
                    Clicked="OnCloseClicked" />

                <controls:ThemedSvgPathIcon
                    Data="M313-440h487v-80H313l223-223-56-57-320 320 320 320 56-57-223-223Z"
                    WidthRequest="{OnPlatform Android=20, WinUI=18, Default=18}"
                    HeightRequest="{OnPlatform Android=20, WinUI=18, Default=18}"
                    Opacity="{Binding Source={x:Reference HardwareBackButton}, Path=Opacity}"
                    TranslationX="{OnPlatform Android=-2, WinUI=0, Default=0}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                VerticalOptions="Center">

                <Label
                    Text="Thông tin phần cứng"
                    TranslationY="{OnPlatform Android=1, WinUI=0, Default=0}"
                    FontSize="{OnPlatform Android=20, WinUI=20, Default=20}"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    MaxLines="1"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="Đo hiệu năng Int32, Int64, Float và Double"
                    IsVisible="{OnPlatform Android=False, WinUI=True, Default=True}"
                    FontSize="11"
                    LineBreakMode="TailTruncation"
                    TextColor="{DynamicResource TextSecondaryColor}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>

    <Grid x:Name="HardwarePageContentRoot">
        <ScrollView>
            <VerticalStackLayout
                Padding="{OnPlatform Android=12, WinUI=16, Default=16}"
                Spacing="{OnPlatform Android=10, WinUI=14, Default=14}"
                MaximumWidthRequest="920"
                HorizontalOptions="Center">

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Thông tin thiết bị"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Tên thiết bị" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DeviceNameValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Mẫu thiết bị" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DeviceModelValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Nhà sản xuất" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="ManufacturerValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Nền tảng" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="PlatformValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Phiên bản hệ điều hành" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="OsVersionValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Môi trường thiết bị" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DeviceTypeValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Màn hình" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="DisplayValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Bộ xử lý"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Tên bộ vi xử lý" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="ProcessorNameValueLabel"
                                Grid.Column="1"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Xung nhịp CPU" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="ProcessorClockValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Kiến trúc CPU" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="CpuArchitectureValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Kiến trúc hệ điều hành" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="OsArchitectureValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Số lõi vật lý" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="PhysicalCoresValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Số luồng logic" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="LogicalProcessorsValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Tập lệnh SIMD" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="SimdValueLabel"
                                Grid.Column="1"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Độ rộng vector" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="VectorWidthValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="Bộ nhớ khả dụng cho tiến trình" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="AvailableMemoryValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text=".NET Runtime" Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label x:Name="RuntimeValueLabel" Grid.Column="1" Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid
                    x:Name="BenchmarkModeTabs"
                    IsVisible="{OnPlatform WinUI=True, Default=False}"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8">
                    <Button
                        x:Name="RawPerformanceTabButton"
                        Grid.Column="0"
                        Grid.ColumnSpan="{OnPlatform Android=2, WinUI=1, Default=1}"
                        HeightRequest="44"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        Text="⚙ Hiệu năng thuần"
                        Clicked="OnRawPerformanceTabClicked" />
                    <Button
                        x:Name="LlmPerformanceTabButton"
                        Grid.Column="1"
                        IsVisible="{OnPlatform WinUI=True, Default=False}"
                        HeightRequest="44"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        Text="🤖 AI / LLM"
                        Clicked="OnLlmPerformanceTabClicked" />
                </Grid>

                <VerticalStackLayout
                    x:Name="RawPerformanceContent"
                    Spacing="{OnPlatform Android=10, WinUI=14, Default=14}">

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Tăng tốc tính toán"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label
                                    Text="Tăng tốc phần cứng"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Bật SIMD cho benchmark và AVX2 256-bit cho NTT/CRT ≤ 10 triệu khi CPU hỗ trợ."
                                    Style="{StaticResource HardwareDescriptionStyle}" />

                                <Label
                                    x:Name="AccelerationStatusLabel"
                                    FontSize="12"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">

                                <Switch
                                    x:Name="HardwareAccelerationSwitch"
                                    HorizontalOptions="Center"
                                    Toggled="OnHardwareAccelerationToggled" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout
                            x:Name="SimdModeSelectorContainer"
                            IsVisible="False"
                            Spacing="6"
                            Margin="0,2,0,0">

                            <Label
                                Text="Tập lệnh SIMD benchmark"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />


                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="SimdModePicker"
                                        HeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='12,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TitleColor="{DynamicResource TextSecondaryColor}"
                                        SelectedIndexChanged="OnSimdModeSelectionChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>
                            </Border>


                            <Label
                                Text="{OnPlatform Android='Android benchmark chỉ dùng NEON/AdvSIMD.', WinUI='Chỉ các tập lệnh CPU đang hỗ trợ mới được hiển thị.', Default='Chỉ các tập lệnh CPU đang hỗ trợ mới được hiển thị.'}"
                                FontSize="11"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                                x:Name="ArmRuntimeSupportLabel"
                                IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextSecondaryColor}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label
                                    Text="Đa luồng"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Bật để benchmark Float, Double, Int32 và Int64 sử dụng nhiều luồng CPU."
                                    Style="{StaticResource HardwareDescriptionStyle}" />

                                <Label
                                    x:Name="MultithreadingStatusLabel"
                                    FontSize="12"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">

                                <Switch
                                    x:Name="MultithreadingSwitch"
                                    HorizontalOptions="Center"
                                    Toggled="OnMultithreadingToggled" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label
                                Text="Chế độ Float / Double"
                                Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="FloatingPointModeValueLabel"
                                Grid.Column="1"
                                Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label
                                Text="Chế độ Int32 / Int64"
                                Style="{StaticResource HardwareInfoNameStyle}" />
                            <Label
                                x:Name="IntegerModeValueLabel"
                                Grid.Column="1"
                                Style="{StaticResource HardwareInfoValueStyle}" />
                        </Grid>

                        <Label
                            Text="Float và Double dùng SIMD khi bật. Int32 và Int64 luôn dùng Scalar. Đa luồng chỉ áp dụng cho benchmark."
                            Style="{StaticResource HardwareDescriptionStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource HardwareSectionStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            x:Name="BenchmarkTestSectionTitleLabel"
                            Text="Bài kiểm tra hiệu năng"
                            Style="{StaticResource HardwareSectionTitleStyle}" />

                        <VerticalStackLayout Spacing="6">
                            <Label
                                x:Name="BenchmarkTestPickerLabel"
                                Text="Chọn bài kiểm tra"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Border
                                Padding="0"
                                BackgroundColor="{DynamicResource InputBackgroundColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Picker
                                        x:Name="BenchmarkTestPicker"
                                        SelectedIndex="0"
                                        HeightRequest="{OnPlatform Android=56, WinUI=46, Default=46}"
                                        Margin="{OnPlatform Android='0', WinUI='0', Default='12,0,0,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        SelectedIndexChanged="OnBenchmarkTestPickerSelectedIndexChanged" />

                                    <Path
                                        IsVisible="{OnPlatform Android=True, Default=False}"
                                        Data="M4,7 L10,13 L16,7 Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        WidthRequest="14"
                                        HeightRequest="14"
                                        Margin="0,0,18,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        InputTransparent="True" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource HardwareDividerStyle}" />

                        <VerticalStackLayout
                            x:Name="StandardBenchmarkPanel"
                            Spacing="12">
                            <Label
                                x:Name="StandardBenchmarkDescriptionLabel"
                                Text="Mỗi kiểu được đo liên tiếp trong 10 giây và lấy kết quả cao nhất. Float/Double hiển thị MFLOPS/GFLOPS; Int32/Int64 hiển thị MOPS/GOPS."
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Button
                                x:Name="RunBenchmarkButton"
                                Text="Chạy đo sức mạnh"
                                HeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                FontAttributes="Bold"
                                Clicked="OnRunBenchmarkClicked" />

                            <ActivityIndicator
                                x:Name="BenchmarkProgress"
                                IsVisible="False"
                                IsRunning="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="BenchmarkCountdownLabel"
                                IsVisible="False"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="BenchmarkStatusLabel"
                                Text="Chưa chạy đo sức mạnh."
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Border
                                x:Name="BenchmarkResultsBorder"
                                IsVisible="False"
                                Padding="14"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            Text="Điểm tham khảo"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />
                                        <Label
                                            x:Name="BenchmarkScoreValueLabel"
                                            Grid.Column="1"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </Grid>

                                    <BoxView Style="{StaticResource HardwareDividerStyle}" />

                                    <Label
                                        x:Name="BenchmarkFloatingModeResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="BenchmarkIntegerModeResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <BoxView Style="{StaticResource HardwareDividerStyle}" />

                                    <Label
                                        x:Name="Int32ResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="Int64ResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="FloatResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label
                                        x:Name="DoubleResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />

                                    <BoxView Style="{StaticResource HardwareDividerStyle}" />

                                    <Label
                                        x:Name="ElapsedResultLabel"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                </VerticalStackLayout>
                            </Border>

                            <Label
                                x:Name="StandardBenchmarkNoteLabel"
                                Text="Bài đo kéo dài khoảng 40 giây, chưa tính thời gian khởi động ngắn giữa các kiểu dữ liệu."
                                FontSize="11"
                                FontAttributes="Italic"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="ThreadComparisonPanel"
                            IsVisible="False"
                            Spacing="12">
                            <Label
                                x:Name="ThreadComparisonDescriptionLabel"
                                Text="Chạy cùng bài đo Scalar hai lần: một luồng và đa luồng. Điểm là trung bình nhân của Int32, Int64, Float và Double."
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Button
                                x:Name="RunThreadComparisonButton"
                                Text="Chạy so sánh đơn / đa luồng"
                                HeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                FontAttributes="Bold"
                                Clicked="OnRunThreadComparisonClicked" />

                            <ActivityIndicator
                                x:Name="ThreadComparisonProgress"
                                IsVisible="False"
                                IsRunning="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ThreadComparisonCountdownLabel"
                                IsVisible="False"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="ThreadComparisonStatusLabel"
                                Text="Chưa chạy so sánh đơn luồng / đa luồng."
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <GraphicsView
                                x:Name="ThreadComparisonChartView"
                                IsVisible="False"
                                HeightRequest="300"
                                HorizontalOptions="Fill"
                                InputTransparent="True" />

                            <Label
                                x:Name="ThreadComparisonResultLabel"
                                IsVisible="False"
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="ThreadComparisonNoteLabel"
                                Text="Bài đo chạy 2 lượt, mỗi lượt giữ nguyên chuẩn 4 kiểu dữ liệu × 10 giây."
                                FontSize="11"
                                FontAttributes="Italic"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="SimdComparisonPanel"
                            IsVisible="False"
                            Spacing="12">
                            <Label
                                x:Name="SimdComparisonDescriptionLabel"
                                Text="Đo Float và Double với SSE 128-bit, AVX 256-bit và AVX-512 512-bit; mỗi loại chạy một lần đơn luồng và một lần đa luồng."
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <Label
                                x:Name="SimdComparisonAvailabilityLabel"
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Button
                                x:Name="RunSimdComparisonButton"
                                Text="Chạy so sánh SIMD"
                                HeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                FontAttributes="Bold"
                                Clicked="OnRunSimdComparisonClicked" />

                            <ActivityIndicator
                                x:Name="SimdComparisonProgress"
                                IsVisible="False"
                                IsRunning="False"
                                Color="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="SimdComparisonCountdownLabel"
                                IsVisible="False"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="SimdComparisonStatusLabel"
                                Text="Chưa chạy so sánh SIMD."
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource HardwareDescriptionStyle}" />

                            <GraphicsView
                                x:Name="SimdComparisonChartView"
                                IsVisible="False"
                                HeightRequest="320"
                                HorizontalOptions="Fill"
                                InputTransparent="True" />

                            <Label
                                x:Name="SimdComparisonResultLabel"
                                IsVisible="False"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="SimdComparisonNoteLabel"
                                Text="Tối đa 6 lượt: 3 độ rộng SIMD × đơn luồng / đa luồng. Nhóm CPU không hỗ trợ sẽ hiển thị N/A và được bỏ qua."
                                FontSize="11"
                                FontAttributes="Italic"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <local:HardwareLlmBenchmarkView
                    x:Name="LlmBenchmarkView"
                    IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
