<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.FormulaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MathSolver.Models"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Tiêu đề trang -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="14,12,14,10"
            Spacing="3"
            HorizontalOptions="Center"
            MaximumWidthRequest="1280">

            <Label
                Text="CÔNG THỨC TOÁN"
                FontSize="27"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="{DynamicResource TextPrimaryColor}" />

            <Label
                Text="Tra cứu công thức hình học và quy tắc tìm thành phần chưa biết"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="{DynamicResource TextSecondaryColor}" />

        </VerticalStackLayout>

        <!-- Thanh tab con -->
        <Border
            Grid.Row="0"
            Margin="14,12,14,8"
            Padding="6"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource PrimaryBorderBrush}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="6">

                <Button
                    x:Name="UnknownComponentTabButton"
                    Grid.Column="0"
                    Text="𝑥  Tìm thành phần chưa biết"
                    HeightRequest="48"
                    Padding="10,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="{DynamicResource OnPrimaryColor}"
                    Clicked="OnUnknownComponentTabClicked" />

                <Button
                    x:Name="GeometryTabButton"
                    Grid.Column="1"
                    Text="△  Hình học"
                    HeightRequest="48"
                    Padding="10,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnGeometryTabClicked" />

            </Grid>

        </Border>

        <!-- Nội dung tab con -->
        <Grid
            Grid.Row="2"
            Margin="14,0,14,14"
            HorizontalOptions="Fill"
            MaximumWidthRequest="1280">

            <!-- TAB: TÌM THÀNH PHẦN CHƯA BIẾT -->
            <Grid
                x:Name="UnknownComponentContent"
                IsVisible="True">

                <!--
                    Chỉ có 6 thẻ nên dùng ScrollView + FlexLayout.
                    Cách này tránh GridItemsLayout để card cột cuối
                    bị scrollbar của CollectionView che khuất.
                -->
                <ScrollView
                    Orientation="Vertical"
                    HorizontalOptions="Fill"
                    VerticalScrollBarVisibility="Default">

                    <VerticalStackLayout
                        Padding="2,0,2,14"
                        Spacing="12"
                        HorizontalOptions="Fill">

                        <VerticalStackLayout
                            Padding="0,0,0,2"
                            Spacing="3">

                            <Label
                                Text="Tìm thành phần chưa biết"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                Text="Quan sát dạng tổng quát, quy tắc và ví dụ minh họa"
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                        </VerticalStackLayout>

                        <FlexLayout
                            x:Name="UnknownComponentFlexLayout"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"
                            HorizontalOptions="Fill"
                            SizeChanged="OnUnknownComponentFlexLayoutSizeChanged"
                            BindableLayout.ItemsSource="{Binding UnknownComponentItems}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UnknownComponentItem">

                                    <Border
                                        Margin="6"
                                        WidthRequest="220"
                                        Padding="13"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource BorderBrush}"
                                        StrokeThickness="1"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="13" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Start">

                                            <!-- Tiêu đề thẻ -->
                                            <Grid
                                                ColumnDefinitions="40,*"
                                                ColumnSpacing="10">

                                                <Border
                                                    Grid.Column="0"
                                                    Padding="0"
                                                    BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                                    StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding OperationSymbol}"
                                                        FontSize="20"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                </Border>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Title}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    VerticalTextAlignment="Center"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                            </Grid>

                                            <!-- Dạng tổng quát -->
                                            <Border
                                                Padding="9,7"
                                                BackgroundColor="{DynamicResource SurfaceColor}"
                                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="Dạng:"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource TextSecondaryColor}" />

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Structure}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                </Grid>

                                            </Border>

                                            <!-- Quy tắc -->
                                            <VerticalStackLayout
                                                Spacing="3"
                                                MinimumHeightRequest="48">

                                                <Label
                                                    Text="Quy tắc"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                                <Label
                                                    Text="{Binding Rule}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    LineHeight="1.1"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                            </VerticalStackLayout>

                                            <!-- Ví dụ -->
                                            <Border
                                                Padding="10"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="10">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="Ví dụ : "
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="2">

                                                        <Label
                                                            Text="{Binding Example}"
                                                            FontSize="14"
                                                            LineHeight="1.4"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                                        <Label
                                                            Text="{Binding ExampleSolution}"
                                                            FontSize="14"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                                    </VerticalStackLayout>

                                                </Grid>
                                            </Border>

                                        </VerticalStackLayout>
                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- TAB: HÌNH HỌC -->
            <Grid
                x:Name="GeometryContent"
                IsVisible="False">

                <!--
                    Không dùng CollectionView + GridItemsLayout ở đây.
                    GridItemsLayout có thể dùng chiều cao chung cho các item
                    cùng hàng, khiến card ngắn như Hình cầu giới hạn Hình trụ
                    và Hình nón. Chỉ có 12 hình nên ScrollView + FlexLayout
                    phù hợp hơn và cho phép mỗi Border tự cao theo nội dung.
                -->
                <ScrollView
                    Orientation="Vertical"
                    HorizontalOptions="Fill"
                    VerticalScrollBarVisibility="Default">

                    <VerticalStackLayout
                        Padding="2,0,2,14"
                        Spacing="12"
                        HorizontalOptions="Fill">

                        <VerticalStackLayout
                            Padding="0,0,0,2"
                            Spacing="3">

                            <Label
                                Text="Chu vi, diện tích và thể tích"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                Text="Hình minh họa, ký hiệu và công thức thường dùng"
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                        </VerticalStackLayout>

                        <FlexLayout
                            x:Name="GeometryFlexLayout"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"
                            HorizontalOptions="Fill"
                            SizeChanged="OnGeometryFlexLayoutSizeChanged"
                            BindableLayout.ItemsSource="{Binding GeometryItems}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GeometryFormulaItem">

                                    <!--
                                        Không đặt HeightRequest hoặc
                                        MinimumHeightRequest. Border ngoài sẽ
                                        tự mở rộng theo công thức và chú thích.
                                    -->
                                    <Border
                                        Margin="6"
                                        WidthRequest="220"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource BorderBrush}"
                                        StrokeThickness="1"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="13" />
                                        </Border.StrokeShape>

                                        <Grid
                                            RowDefinitions="Auto,190,1,Auto,Auto"
                                            RowSpacing="10">

                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding Name}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                TextColor="{DynamicResource PrimaryColor}" />

                                            <GraphicsView
                                                Grid.Row="1"
                                                Drawable="{Binding Diagram}"
                                                HeightRequest="190"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill"
                                                BackgroundColor="Transparent" />

                                            <BoxView
                                                Grid.Row="2"
                                                HeightRequest="1"
                                                BackgroundColor="{DynamicResource DividerColor}" />

                                            <VerticalStackLayout
                                                Grid.Row="3"
                                                BindableLayout.ItemsSource="{Binding Formulas}"
                                                Spacing="5"
                                                VerticalOptions="Start">

                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">

                                                        <Border
                                                            Padding="9,7"
                                                            BackgroundColor="{DynamicResource SurfaceColor}"
                                                            Stroke="{DynamicResource DividerBrush}"
                                                            StrokeThickness="1">

                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>

                                                            <Label
                                                                Text="{Binding .}"
                                                                FontSize="14"
                                                                FontAttributes="Bold"
                                                                LineBreakMode="WordWrap"
                                                                TextColor="{DynamicResource TextPrimaryColor}" />

                                                        </Border>

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>

                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Row="4"
                                                Padding="10"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                                StrokeThickness="1"
                                                MinimumHeightRequest="72"
                                                VerticalOptions="Start">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>

                                                <VerticalStackLayout
                                                    BindableLayout.ItemsSource="{Binding Symbols}"
                                                    Spacing="3"
                                                    VerticalOptions="Start">

                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">

                                                            <Label
                                                                Text="{Binding .}"
                                                                FontSize="12"
                                                                FontAttributes="Italic"
                                                                LineBreakMode="WordWrap"
                                                                TextColor="{DynamicResource PrimaryColor}" />

                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>

                                                </VerticalStackLayout>
                                            </Border>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
