<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.FormulaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MathSolver.Models"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid
        x:Name="FormulaPageContentRoot"
        RowDefinitions="Auto,*">


        <!-- Thanh tab con: đồng bộ với CalculationPage -->
        <Border
            x:Name="FormulaSubTabBar"
            Grid.Row="0"
            Margin="20,12,20,8"
            Padding="6"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource PrimaryBorderBrush}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid
                x:Name="FormulaSubTabGrid"
                ColumnDefinitions="*,*"
                ColumnSpacing="6">

                <Button
                    x:Name="UnknownComponentTabButton"
                    Grid.Column="0"
                    Text="𝑥  Tìm thành phần chưa biết"
                    HeightRequest="44"
                    Padding="8,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="{DynamicResource OnPrimaryColor}"
                    Clicked="OnUnknownComponentTabClicked" />

                <Button
                    x:Name="GeometryTabButton"
                    Grid.Column="1"
                    Text="△  Hình học"
                    HeightRequest="44"
                    Padding="8,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnGeometryTabClicked" />

            </Grid>
        </Border>

        <!-- Nội dung tab con -->
        <Grid
            Grid.Row="1"
            HorizontalOptions="Fill">

            <!-- TAB: TÌM THÀNH PHẦN CHƯA BIẾT -->
            <Grid
                x:Name="UnknownComponentContent"
                IsVisible="True">

                <!--
                    Chỉ có 6 thẻ nên dùng ScrollView + FlexLayout.
                    Cách này tránh GridItemsLayout để card cột cuối
                    bị scrollbar của CollectionView che khuất.
                -->
                <ScrollView
                    Orientation="Vertical"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Default">

                    <VerticalStackLayout
                        x:Name="UnknownComponentPageContent"
                        Padding="20,16"
                        Spacing="14"
                        HorizontalOptions="Fill">

                        <VerticalStackLayout
                            Margin="0,4,0,6"
                            Spacing="2">

                            <Label
                                Text="𝑥  + − × ÷"
                                FontSize="40"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="UnknownPageTitle"
                                Text="TÌM THÀNH PHẦN CHƯA BIẾT"
                                FontSize="27"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="UnknownPageSubtitle"
                                Text="Dạng tổng quát • Quy tắc • Ví dụ minh họa"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                        </VerticalStackLayout>

                        <FlexLayout
                            x:Name="UnknownComponentFlexLayout"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"
                            HorizontalOptions="Fill"
                            VerticalOptions="Start"
                            SizeChanged="OnUnknownComponentFlexLayoutSizeChanged"
                            BindableLayout.ItemsSource="{Binding UnknownComponentItems}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UnknownComponentItem">

                                    <Border
                                        Margin="7"
                                        WidthRequest="280"
                                        MinimumHeightRequest="330"
                                        FlexLayout.Shrink="0"
                                        Padding="18"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource BorderBrush}"
                                        StrokeThickness="1"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout
                                            Spacing="13"
                                            VerticalOptions="Start">

                                            <!-- Tiêu đề thẻ -->
                                            <Grid
                                                ColumnDefinitions="48,*"
                                                ColumnSpacing="12">

                                                <Border
                                                    Grid.Column="0"
                                                    Padding="0"
                                                    BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                                    StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding OperationSymbol}"
                                                        FontSize="24"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                </Border>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Title}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    VerticalTextAlignment="Center"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                            </Grid>

                                            <!-- Dạng tổng quát -->
                                            <Border
                                                Padding="12,9"
                                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="Dạng:"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        VerticalTextAlignment="Center"
                                                        TextColor="{DynamicResource TextSecondaryColor}" />

                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding Structure}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        HorizontalTextAlignment="Center"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                </Grid>

                                            </Border>

                                            <!-- Quy tắc -->
                                            <VerticalStackLayout
                                                Spacing="5"
                                                MinimumHeightRequest="66">

                                                <Label
                                                    Text="Quy tắc"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                                <Label
                                                    Text="{Binding Rule}"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    LineHeight="1.1"
                                                    LineBreakMode="WordWrap"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                            </VerticalStackLayout>

                                            <!-- Ví dụ -->
                                            <Border
                                                Padding="13"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="9" />
                                                </Border.StrokeShape>

                                                <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="10">

                                                    <Label
                                                        Grid.Column="0"
                                                        Text="Ví dụ : "
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource PrimaryColor}" />

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="2">

                                                        <Label
                                                            Text="{Binding Example}"
                                                            FontSize="15"
                                                            LineHeight="1.4"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                                        <Label
                                                            Text="{Binding ExampleSolution}"
                                                            FontSize="15"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                                    </VerticalStackLayout>

                                                </Grid>
                                            </Border>

                                        </VerticalStackLayout>
                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>

                        <!-- Ghi nhớ tính chất bốn phép tính -->
                        <Border
                            Margin="7,10,7,20"
                            Padding="20"
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1"
                            HorizontalOptions="Fill">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="14">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="LƯU Ý VỀ TÍNH CHẤT BỐN PHÉP TÍNH"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource PrimaryColor}" />

                                    <Label
                                        Text="Khi tìm thành phần chưa biết, cần xác định đúng vai trò của x, dùng phép tính ngược phù hợp và luôn kiểm tra lại kết quả trong phép tính ban đầu."
                                        FontSize="15"
                                        LineHeight="1.25"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource TextSecondaryColor}" />
                                </VerticalStackLayout>

                                <!-- Phép cộng -->
                                <Border
                                    Padding="16"
                                    BackgroundColor="{DynamicResource PrimarySoftColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="7">
                                        <Label
                                            Text="+  PHÉP CỘNG"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            Text="• Giao hoán: a + b = b + a. Đổi chỗ hai số hạng thì tổng không thay đổi."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Kết hợp: (a + b) + c = a + (b + c). Có thể nhóm các số hạng theo cách thuận tiện."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Phần tử trung hòa: a + 0 = 0 + a = a."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Tìm số hạng chưa biết: x + b = c thì x = c − b."
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="Ví dụ: x + 18 = 45 ⇒ x = 45 − 18 = 27. Kiểm tra: 27 + 18 = 45."
                                            FontSize="15"
                                            FontAttributes="Italic"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Phép trừ -->
                                <Border
                                    Padding="16"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="7">
                                        <Label
                                            Text="−  PHÉP TRỪ"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            Text="• Không giao hoán: a − b thường khác b − a. Vì vậy không được tự ý đổi chỗ số bị trừ và số trừ."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Không kết hợp: (a − b) − c thường khác a − (b − c). Cần thực hiện đúng thứ tự."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Tính chất cơ bản: a − 0 = a và a − a = 0."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Tìm số bị trừ: x − b = c thì x = c + b. Tìm số trừ: a − x = c thì x = a − c."
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="Ví dụ: 52 − x = 19 ⇒ x = 52 − 19 = 33. Kiểm tra: 52 − 33 = 19."
                                            FontSize="15"
                                            FontAttributes="Italic"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Phép nhân -->
                                <Border
                                    Padding="16"
                                    BackgroundColor="{DynamicResource PrimarySoftColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="7">
                                        <Label
                                            Text="×  PHÉP NHÂN"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            Text="• Giao hoán: a × b = b × a. Đổi chỗ hai thừa số thì tích không thay đổi."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Kết hợp: (a × b) × c = a × (b × c). Có thể nhóm các thừa số theo cách thuận tiện."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Phần tử đơn vị và phần tử hấp thụ: a × 1 = a; a × 0 = 0."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Tìm thừa số chưa biết: x × b = c thì x = c ÷ b, với b ≠ 0."
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="Ví dụ: x × 7 = 56 ⇒ x = 56 ÷ 7 = 8. Kiểm tra: 8 × 7 = 56."
                                            FontSize="15"
                                            FontAttributes="Italic"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Phép chia -->
                                <Border
                                    Padding="16"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="7">
                                        <Label
                                            Text="÷  PHÉP CHIA"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource PrimaryColor}" />

                                        <Label
                                            Text="• Không giao hoán: a ÷ b thường khác b ÷ a. Phép chia cũng không có tính kết hợp."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Tính chất cơ bản: a ÷ 1 = a; a ÷ a = 1 với a ≠ 0; 0 ÷ a = 0 với a ≠ 0."
                                            FontSize="15"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="• Không bao giờ được chia cho 0. Mọi giá trị làm số chia hoặc mẫu số bằng 0 đều không hợp lệ."
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource ErrorColor}" />

                                        <Label
                                            Text="• Tìm số bị chia: x ÷ b = c thì x = c × b, với b ≠ 0. Tìm số chia trong dạng cơ bản a ÷ x = c thì x = a ÷ c, đồng thời x ≠ 0 và c ≠ 0."
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                        <Label
                                            Text="Ví dụ: 72 ÷ x = 9 ⇒ x = 72 ÷ 9 = 8. Kiểm tra: 72 ÷ 8 = 9."
                                            FontSize="15"
                                            FontAttributes="Italic"
                                            LineHeight="1.25"
                                            LineBreakMode="WordWrap"
                                            TextColor="{DynamicResource PrimaryColor}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border
                                    Padding="14"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>

                                    <Label
                                        Text="Ghi nhớ: Phép cộng và phép trừ là hai phép tính ngược nhau; phép nhân và phép chia cũng là hai phép tính ngược nhau. Sau khi tìm được x, luôn thay x vào phép tính ban đầu để kiểm tra và loại mọi giá trị vi phạm điều kiện chia cho 0."
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        LineHeight="1.25"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource PrimaryColor}" />
                                </Border>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- TAB: HÌNH HỌC -->
            <Grid
                x:Name="GeometryContent"
                IsVisible="False">

                <!--
                    Không dùng CollectionView + GridItemsLayout ở đây.
                    GridItemsLayout có thể dùng chiều cao chung cho các item
                    cùng hàng, khiến card ngắn như Hình cầu giới hạn Hình trụ
                    và Hình nón. Chỉ có 12 hình nên ScrollView + FlexLayout
                    phù hợp hơn và cho phép mỗi Border tự cao theo nội dung.
                -->
                <ScrollView
                    Orientation="Vertical"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    VerticalScrollBarVisibility="Default">

                    <VerticalStackLayout
                        x:Name="GeometryPageContent"
                        Padding="20,16"
                        Spacing="14"
                        HorizontalOptions="Fill">

                        <VerticalStackLayout
                            Margin="0,4,0,6"
                            Spacing="2">

                            <Label
                                Text="□  △  ○"
                                FontSize="40"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="GeometryPageTitle"
                                Text="CHU VI, DIỆN TÍCH VÀ THỂ TÍCH"
                                FontSize="27"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="GeometryPageSubtitle"
                                Text="Hình minh họa • Ký hiệu • Công thức thường dùng"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                        </VerticalStackLayout>

                        <FlexLayout
                            x:Name="GeometryFlexLayout"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"
                            HorizontalOptions="Fill"
                            SizeChanged="OnGeometryFlexLayoutSizeChanged"
                            BindableLayout.ItemsSource="{Binding GeometryItems}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GeometryFormulaItem">

                                    <!--
                                        Không đặt HeightRequest hoặc
                                        MinimumHeightRequest. Border ngoài sẽ
                                        tự mở rộng theo công thức và chú thích.
                                    -->
                                    <Border
                                        Margin="5"
                                        WidthRequest="180"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource BorderBrush}"
                                        StrokeThickness="1"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Grid
                                            RowDefinitions="Auto,Auto,1,Auto,Auto"
                                            RowSpacing="9">

                                            <Label
                                                Grid.Row="0"
                                                Text="{Binding Name}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center"
                                                TextColor="{DynamicResource PrimaryColor}" />

                                            <GraphicsView
                                                Grid.Row="1"
                                                Drawable="{Binding Diagram}"
                                                HeightRequest="170"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill"
                                                BackgroundColor="Transparent" />

                                            <BoxView
                                                Grid.Row="2"
                                                HeightRequest="1"
                                                BackgroundColor="{DynamicResource DividerColor}" />

                                            <VerticalStackLayout
                                                Grid.Row="3"
                                                BindableLayout.ItemsSource="{Binding Formulas}"
                                                Spacing="5"
                                                VerticalOptions="Start">

                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">

                                                        <Border
                                                            Padding="9,7"
                                                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                                                            Stroke="{DynamicResource DividerBrush}"
                                                            StrokeThickness="1">

                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>

                                                            <Label
                                                                Text="{Binding .}"
                                                                FontSize="14"
                                                                FontAttributes="Bold"
                                                                LineBreakMode="WordWrap"
                                                                TextColor="{DynamicResource TextPrimaryColor}" />

                                                        </Border>

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>

                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Row="4"
                                                Padding="10"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBorderBrush}"
                                                StrokeThickness="1"
                                                MinimumHeightRequest="72"
                                                VerticalOptions="Start">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>

                                                <VerticalStackLayout
                                                    BindableLayout.ItemsSource="{Binding Symbols}"
                                                    Spacing="3"
                                                    VerticalOptions="Start">

                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">

                                                            <Label
                                                                Text="{Binding .}"
                                                                FontSize="12"
                                                                FontAttributes="Italic"
                                                                LineBreakMode="WordWrap"
                                                                TextColor="{DynamicResource PrimaryColor}" />

                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>

                                                </VerticalStackLayout>
                                            </Border>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
