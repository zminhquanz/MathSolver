<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.MultiplicationTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F7FB">

    <Grid RowDefinitions="Auto,*">

        <!-- Thanh chọn loại bảng -->
        <Border
            Grid.Row="0"
            Margin="14,14,14,8"
            Padding="14"
            BackgroundColor="White"
            Stroke="#D7E2EE"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="BẢNG CỬU CHƯƠNG"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="#1E3A5F" />

                    <Label
                        Text="Hiển thị đầy đủ từ bảng 1 đến bảng 10"
                        FontSize="14"
                        TextColor="#60758A" />

                </VerticalStackLayout>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                    <Button
                        x:Name="MultiplicationButton"
                        Grid.Column="0"
                        Text="×  Bảng nhân"
                        HeightRequest="46"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        Clicked="OnMultiplicationClicked" />

                    <Button
                        x:Name="DivisionButton"
                        Grid.Column="1"
                        Text="÷  Bảng chia"
                        HeightRequest="46"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        BackgroundColor="#E8EEF6"
                        TextColor="#334155"
                        Clicked="OnDivisionClicked" />

                </Grid>

            </VerticalStackLayout>

        </Border>

        <!-- Danh sách toàn bộ bảng -->
        <CollectionView
        x:Name="TablesCollectionView"
        Grid.Row="1"
        Margin="14,0,14,14"
        SelectionMode="None">

            <CollectionView.ItemsLayout>

                <GridItemsLayout
                Orientation="Vertical"
                Span="5"
                HorizontalItemSpacing="10"
                VerticalItemSpacing="10" />

            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                    Padding="10"
                    BackgroundColor="White"
                    Stroke="#D7E2EE"
                    StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label
                        Text="{Binding Title}"
                        FontSize="17"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#1D4ED8" />
                            <BoxView
                        HeightRequest="1"
                        BackgroundColor="#E2E8F0" />
                            <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Rows}"
                        Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                    Padding="5,4"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>

                                            <Label
                                        Text="{Binding}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="NoWrap"
                                        TextColor="#334155" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>