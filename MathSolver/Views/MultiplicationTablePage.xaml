<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.MultiplicationTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cửu chương"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="TableLineBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceAltColor}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="TitleLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        </Style>

        <Style x:Key="SubLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
        </Style>

        <Style x:Key="TableLineStyle" TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20,16">
        <CollectionView
            x:Name="TablesCollectionView"
            ItemsSource="{Binding TableCards}"
            SelectionMode="None"
            BackgroundColor="Transparent">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16">

                    <!-- Hero -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label
                            Text="×  ÷"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />

                        <Label
                            Text="BẢNG CỬU CHƯƠNG"
                            FontSize="30"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            Text="Bảng nhân và bảng chia từ 1 đến 20"
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>

                    <!-- Control panel -->
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <VerticalStackLayout Spacing="18">

                            <!-- 1. Chọn loại bảng -->
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="1. Chọn loại bảng"
                                    Style="{StaticResource TitleLabelStyle}" />

                                <Label
                                    Text="Chọn bảng nhân hoặc bảng chia."
                                    Style="{StaticResource SubLabelStyle}" />

                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="12">

                                    <Button
                                        x:Name="MultiplyButton"
                                        Grid.Column="0"
                                        HeightRequest="50"
                                        CornerRadius="12"
                                        Clicked="OnMultiplyClicked"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="×  Bảng nhân" 
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="{DynamicResource OnPrimaryColor}" />

                                    <Button
                                        x:Name="DivideButton"
                                        Grid.Column="1"
                                        HeightRequest="50"
                                        CornerRadius="12"
                                        Clicked="OnDivideClicked"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="÷  Bảng chia"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="{DynamicResource OnPrimaryColor}" />

                                </Grid>
                            </VerticalStackLayout>

                            <BoxView
                                Margin="0,2"
                                HeightRequest="1"
                                BackgroundColor="{DynamicResource DividerColor}" />

                            <!-- 2. Chọn phạm vi -->
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    Text="2. Phạm vi hiển thị"
                                    Style="{StaticResource TitleLabelStyle}" />

                                <Label
                                    Text="Chọn nhóm cơ bản, nâng cao hoặc hiển thị toàn bộ."
                                    Style="{StaticResource SubLabelStyle}" />

                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="12">

                                    <Border
                                        x:Name="Range1To10Border"
                                        Grid.Column="0"
                                        Style="{StaticResource CardBorderStyle}"
                                        Padding="14,12">

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Center">

                                            <RadioButton
                                                x:Name="Range1To10Radio"
                                                GroupName="RangeGroup"
                                                CheckedChanged="OnRangeChanged"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="Bảng 1 – 10"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                                <Label
                                                    Text="10 bảng cơ bản"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                            </VerticalStackLayout>

                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border
                                        x:Name="Range11To20Border"
                                        Grid.Column="1"
                                        Style="{StaticResource CardBorderStyle}"
                                        Padding="14,12">

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Center">

                                            <RadioButton
                                                x:Name="Range11To20Radio"
                                                GroupName="RangeGroup"
                                                CheckedChanged="OnRangeChanged"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="Bảng 11 – 20"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                                <Label
                                                    Text="10 bảng nâng cao"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                            </VerticalStackLayout>

                                        </HorizontalStackLayout>
                                    </Border>

                                    <Border
                                        x:Name="RangeAllBorder"
                                        Grid.Column="2"
                                        Style="{StaticResource CardBorderStyle}"
                                        Padding="14,12">

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            VerticalOptions="Center">

                                            <RadioButton
                                                x:Name="RangeAllRadio"
                                                GroupName="RangeGroup"
                                                CheckedChanged="OnRangeChanged"
                                                VerticalOptions="Center" />

                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="Tất cả 1 – 20"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                                <Label
                                                    Text="Hiển thị đầy đủ 20 bảng"
                                                    FontSize="12"
                                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                            </VerticalStackLayout>

                                        </HorizontalStackLayout>
                                    </Border>

                                </Grid>
                            </VerticalStackLayout>

                            <Border
                                x:Name="StatusBorder"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{DynamicResource PrimaryColor}"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Padding="14,10">
                                <Label
                                    x:Name="StatusLabel"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Title list -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="3. Danh sách bảng cửu chương"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            Text="Mỗi ô hiển thị đầy đủ 10 phép tính."
                            FontSize="13"
                            TextColor="{DynamicResource TextSecondaryColor}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="5"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="{Binding Title}"
                                HorizontalTextAlignment="Center"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource DividerColor}" />

                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding Lines}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Style="{StaticResource TableLineBorderStyle}">
                                            <Label
                                                Style="{StaticResource TableLineStyle}"
                                                Text="{Binding .}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>