<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.QuadraticEquationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        x:Name="QuadraticScrollView"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            x:Name="QuadraticContent"
            Style="{StaticResource SolverContentStyle}">

            <!-- Chọn dạng phương trình -->
            <Border Style="{StaticResource SolverCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Equation.ChooseType}"
                        Style="{StaticResource SolverSectionTitleStyle}" />

                    <Grid
                        ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*', Default='*,*'}"
                        RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                        ColumnSpacing="{OnPlatform Android=0, WinUI=10, Default=10}"
                        RowSpacing="{OnPlatform Android=8, WinUI=0, Default=0}">

                        <Button
                            x:Name="LinearModeButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{localization:Translate Equation.Mode.Linear}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                            Clicked="OnLinearModeClicked" />

                        <Button
                            x:Name="QuadraticModeButton"
                            Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                            Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                            Text="{localization:Translate Equation.Mode.Quadratic}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource OnPrimaryColor}"
                            Clicked="OnQuadraticModeClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Tiêu đề đồng bộ với Cơ bản, Phân số và Tìm x -->
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    x:Name="HeroSymbolLabel"
                    Text="ax² + bx + c = 0"
                    Style="{StaticResource SolverHeroSymbolStyle}"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    />

                <Label
                    x:Name="HeroTitleLabel"
                    Text="PHƯƠNG TRÌNH BẬC HAI"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    x:Name="HeroSubtitleLabel"
                    Text="Tính biệt thức Δ • Xét số nghiệm • Trình bày lời giải chi tiết"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <!-- 1. Nhập hệ số -->
            <Border
                Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="1. Nhập các hệ số"
                        Style="{StaticResource SolverSectionTitleStyle}" />


                    <Grid
                        x:Name="CoefficientGrid"
                        ColumnDefinitions="{OnPlatform Android='*', WinUI='*,*,*', Default='*,*,*'}"
                        RowDefinitions="{OnPlatform Android='Auto,Auto,Auto', WinUI='Auto', Default='Auto'}"
                        ColumnSpacing="12"
                        RowSpacing="10">

                        <!-- Hệ số a -->
                        <Border
                            x:Name="CoefficientAPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="{OnPlatform Android=10, WinUI=12, Default=12}"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            Stroke="{DynamicResource WallpaperBorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số a"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <Label
                                    x:Name="CoefficientADescriptionLabel"
                                    Text="Hệ số của x²"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="CoefficientAEntry"
                                        Placeholder="Ví dụ: 1"
                                        PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="52"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Hệ số b -->
                        <Border
                            x:Name="CoefficientBPanel"
                            Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                            Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                            Padding="{OnPlatform Android=10, WinUI=12, Default=12}"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            Stroke="{DynamicResource WallpaperBorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số b"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <Label
                                    x:Name="CoefficientBDescriptionLabel"
                                    Text="Hệ số của x"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="CoefficientBEntry"
                                        Placeholder="Ví dụ: −3"
                                        PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="52"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Hệ số c -->
                        <Border
                            x:Name="CoefficientCPanel"
                            Grid.Row="{OnPlatform Android=2, WinUI=0, Default=0}"
                            Grid.Column="{OnPlatform Android=0, WinUI=2, Default=2}"
                            Padding="{OnPlatform Android=10, WinUI=12, Default=12}"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            Stroke="{DynamicResource WallpaperBorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số c"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <Label
                                    Text="Hệ số tự do"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                    Stroke="{DynamicResource WallpaperBorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="CoefficientCEntry"
                                        Placeholder="Ví dụ: 2"
                                        PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="52"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <!-- Xem trước phương trình -->
                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Phương trình đang nhập"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                            <Label
                                x:Name="EquationPreviewLabel"
                                Text="ax² + bx + c = 0"
                                FontSize="{OnPlatform Android=21, WinUI=25, Default=25}"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="CalculateQuadraticButton"
                            Grid.Column="0"
                            Text="{localization:Translate Equation.Action}"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            Grid.Column="1"
                            Text="{localization:Translate Actions.Clear}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource WallpaperDividerColor}"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Thông báo lỗi, giống tab Phân số -->
            <Border
                x:Name="ErrorBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                Stroke="{DynamicResource DangerBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                    Grid.Column="0"
                    Text="❌"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource DangerColor}" />

                    <Label
                    Grid.Column="1"
                    x:Name="ErrorLabel"
                    FontSize="17"
                    TextColor="{DynamicResource DangerColor}"
                    LineBreakMode="WordWrap" />
                    
                </Grid>

            </Border>

            <!-- 2. Kết quả -->
            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="2. Kết quả"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                    <Label
                        x:Name="ResultEquationLabel"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="ResultMetricCaptionLabel"
                                Text="Biệt thức"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                            <Label
                                x:Name="DeltaValueLabel"
                                Text="Δ = 0"
                                FontSize="27"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                                HeightRequest="1"
                                Margin="0,2"
                                BackgroundColor="{DynamicResource WallpaperDividerColor}" />

                            <Label
                                x:Name="ClassificationLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource SuccessColor}" />

                            <Label
                                x:Name="RootsLabel"
                                FontSize="32"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Grid HeightRequest="48">

                        <Button
                            x:Name="QuadraticCopyResultButton"
                            Text="{localization:Translate PowerRoot.CopyResult}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource WallpaperDividerColor}"
                            TextColor="Transparent"
                            Clicked="OnQuadraticCopyResultClicked" />

                        <HorizontalStackLayout
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">

                            <controls:ThemedCopyIcon
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="{Binding Text, Source={x:Reference QuadraticCopyResultButton}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            

            <!-- 3. Lời giải chi tiết -->
            <Border
                x:Name="SolutionBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                Stroke="{DynamicResource WallpaperBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="3. Lời giải chi tiết"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step1TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step1BodyLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step2TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step2BodyLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        x:Name="Step3Border"
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step3TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step3BodyLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        x:Name="Step4Border"
                        Padding="14"
                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step4TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <VerticalStackLayout
                                x:Name="Step4ContentLayout"
                                Spacing="10">

                                <Label
                                    x:Name="Step4BodyLabel"
                                    FontSize="16"
                                    LineHeight="1.3"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                <ScrollView
                                    x:Name="Step4MathScrollView"
                                    IsVisible="False"
                                    Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">

                                    <VerticalStackLayout
                                        x:Name="Step4MathLayout"
                                        Spacing="10" />

                                </ScrollView>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

<!-- Đồ thị parabol sau khi có kết quả -->
            <Border
                x:Name="GraphBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                Stroke="{DynamicResource WallpaperBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Grid
                        ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2"
                            VerticalOptions="Center">

                            <Label
                                x:Name="GraphTitleLabel"
                                Text="Đồ thị parabol"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                            <Label
                                x:Name="GraphStatusLabel"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="−"
                            WidthRequest="46"
                            HeightRequest="42"
                            Padding="0"
                            CornerRadius="10"
                            FontSize="24"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                            SemanticProperties.Description="Thu nhỏ đồ thị"
                            Clicked="OnGraphZoomOutClicked" />

                        <Button
                            x:Name="GraphResetZoomButton"
                            Grid.Column="2"
                            Text="100%"
                            MinimumWidthRequest="74"
                            HeightRequest="42"
                            Padding="10,0"
                            CornerRadius="10"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                            TextColor="{DynamicResource PrimaryColor}"
                            SemanticProperties.Description="Đặt lại mức thu phóng"
                            Clicked="OnGraphResetZoomClicked" />

                        <Button
                            Grid.Column="3"
                            Text="+"
                            WidthRequest="46"
                            HeightRequest="42"
                            Padding="0"
                            CornerRadius="10"
                            FontSize="22"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                            SemanticProperties.Description="Phóng to đồ thị"
                            Clicked="OnGraphZoomInClicked" />

                    </Grid>

                    <Border
                        Padding="6"
                        BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                        Stroke="{DynamicResource WallpaperBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <GraphicsView
                            x:Name="ParabolaGraphicsView"
                            HeightRequest="960"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="False"
                            StartInteraction="OnGraphStartInteraction"
                            DragInteraction="OnGraphDragInteraction"
                            EndInteraction="OnGraphEndInteraction"
                            CancelInteraction="OnGraphCancelInteraction" />

                    </Border>

                    <Label
                        x:Name="GraphHelpLabel"
                        Text="Đồ thị trình bày theo dạng SGK: có trục tọa độ, trục đối xứng, đỉnh và nghiệm thực. Kéo chuột để di chuyển; cuộn con lăn lên để phóng to, xuống để thu nhỏ; hoặc dùng −, + và 100%."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                </VerticalStackLayout>

            </Border>
</VerticalStackLayout>

    </ScrollView>

</base:LocalizedSolverView>
