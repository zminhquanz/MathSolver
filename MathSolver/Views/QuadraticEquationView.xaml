<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.QuadraticEquationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        x:Name="QuadraticScrollView"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            x:Name="QuadraticContent"
            Style="{StaticResource SolverContentStyle}">

            <!-- Tiêu đề đồng bộ với Cơ bản, Phân số và Tìm x -->
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="ax² + bx + c = 0"
                    Style="{StaticResource SolverHeroSymbolStyle}"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    />

                <Label
                    Text="PHƯƠNG TRÌNH BẬC HAI"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    Text="Tính biệt thức Δ • Xét số nghiệm • Trình bày lời giải chi tiết"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <!-- 1. Nhập hệ số -->
            <Border
                Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="1. Nhập các hệ số"
                        Style="{StaticResource SolverSectionTitleStyle}" />


                    <Grid
                        x:Name="CoefficientGrid"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="Auto"
                        ColumnSpacing="12"
                        RowSpacing="10">

                        <!-- Hệ số a -->
                        <Border
                            x:Name="CoefficientAPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số a"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Hệ số của x²"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="CoefficientAEntry"
                                        Placeholder="Ví dụ: 1"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="52"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Hệ số b -->
                        <Border
                            x:Name="CoefficientBPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số b"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Hệ số của x"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="CoefficientBEntry"
                                        Placeholder="Ví dụ: −3"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="52"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Hệ số c -->
                        <Border
                            x:Name="CoefficientCPanel"
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số c"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Hệ số tự do"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="CoefficientCEntry"
                                        Placeholder="Ví dụ: 2"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="52"
                                        FontSize="19"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <!-- Xem trước phương trình -->
                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Phương trình đang nhập"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                            <Label
                                x:Name="EquationPreviewLabel"
                                Text="ax² + bx + c = 0"
                                FontSize="25"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="CalculateQuadraticButton"
                            Grid.Column="0"
                            Text="{localization:Translate Quadratic.Action}"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            Grid.Column="1"
                            Text="{localization:Translate Actions.Clear}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource DividerColor}"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Thông báo lỗi, giống tab Phân số -->
            <Border
                x:Name="ErrorBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource DangerSoftColor}"
                Stroke="{DynamicResource DangerBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                    Grid.Column="0"
                    Text="!"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource DangerColor}" />

                    <Label
                    Grid.Column="1"
                    x:Name="ErrorLabel"
                    FontSize="17"
                    TextColor="{DynamicResource DangerColor}"
                    LineBreakMode="WordWrap" />
                    
                </Grid>

            </Border>

            <!-- 2. Kết quả -->
            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="2. Kết quả"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Label
                        x:Name="ResultEquationLabel"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="Biệt thức"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                                x:Name="DeltaValueLabel"
                                Text="Δ = 0"
                                FontSize="27"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                                HeightRequest="1"
                                Margin="0,2"
                                BackgroundColor="{DynamicResource DividerColor}" />

                            <Label
                                x:Name="ClassificationLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource SuccessColor}" />

                            <Label
                                x:Name="RootsLabel"
                                FontSize="32"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Grid HeightRequest="48">

                        <Button
                            x:Name="QuadraticCopyResultButton"
                            Text="{localization:Translate PowerRoot.CopyResult}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource DividerColor}"
                            TextColor="Transparent"
                            Clicked="OnQuadraticCopyResultClicked" />

                        <HorizontalStackLayout
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">

                            <controls:ThemedCopyIcon
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="{Binding Text, Source={x:Reference QuadraticCopyResultButton}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            

            <!-- 3. Lời giải chi tiết -->
            <Border
                x:Name="SolutionBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="3. Lời giải chi tiết"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step1TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step1BodyLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step2TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step2BodyLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        x:Name="Step3Border"
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step3TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step3BodyLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        x:Name="Step4Border"
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step4TitleLabel"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <VerticalStackLayout
                                x:Name="Step4ContentLayout"
                                Spacing="10">

                                <Label
                                    x:Name="Step4BodyLabel"
                                    FontSize="16"
                                    LineHeight="1.3"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <ScrollView
                                    x:Name="Step4MathScrollView"
                                    IsVisible="False"
                                    Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">

                                    <VerticalStackLayout
                                        x:Name="Step4MathLayout"
                                        Spacing="10" />

                                </ScrollView>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

<!-- Đồ thị parabol sau khi có kết quả -->
            <Border
                x:Name="GraphBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Grid
                        ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="8">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2"
                            VerticalOptions="Center">

                            <Label
                                Text="Đồ thị parabol"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="GraphStatusLabel"
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="−"
                            WidthRequest="46"
                            HeightRequest="42"
                            Padding="0"
                            CornerRadius="10"
                            FontSize="24"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            SemanticProperties.Description="Thu nhỏ đồ thị"
                            Clicked="OnGraphZoomOutClicked" />

                        <Button
                            x:Name="GraphResetZoomButton"
                            Grid.Column="2"
                            Text="100%"
                            MinimumWidthRequest="74"
                            HeightRequest="42"
                            Padding="10,0"
                            CornerRadius="10"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            TextColor="{DynamicResource PrimaryColor}"
                            SemanticProperties.Description="Đặt lại mức thu phóng"
                            Clicked="OnGraphResetZoomClicked" />

                        <Button
                            Grid.Column="3"
                            Text="+"
                            WidthRequest="46"
                            HeightRequest="42"
                            Padding="0"
                            CornerRadius="10"
                            FontSize="22"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            SemanticProperties.Description="Phóng to đồ thị"
                            Clicked="OnGraphZoomInClicked" />

                    </Grid>

                    <Border
                        Padding="6"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <GraphicsView
                            x:Name="ParabolaGraphicsView"
                            HeightRequest="960"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="False"
                            StartInteraction="OnGraphStartInteraction"
                            DragInteraction="OnGraphDragInteraction"
                            EndInteraction="OnGraphEndInteraction"
                            CancelInteraction="OnGraphCancelInteraction" />

                    </Border>

                    <Label
                        Text="Đồ thị trình bày theo dạng SGK: có trục tọa độ, trục đối xứng, đỉnh và nghiệm thực. Kéo chuột để di chuyển; cuộn con lăn lên để phóng to, xuống để thu nhỏ; hoặc dùng −, + và 100%."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                </VerticalStackLayout>

            </Border>


            <!-- Lưu ý khi sử dụng -->
            <Border
                Padding="16"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="⚠"
                        FontSize="26"
                        VerticalOptions="Start"
                        TextColor="{DynamicResource WarningColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Lưu ý khi sử dụng"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                            FontSize="16"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                            FontSize="16"
                            FontAttributes="Italic"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>

    </ScrollView>

</base:LocalizedSolverView>
