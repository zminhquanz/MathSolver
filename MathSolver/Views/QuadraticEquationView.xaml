<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MathSolver.Views.QuadraticEquationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            x:Name="QuadraticContent"
            Padding="16"
            Spacing="14"
            HorizontalOptions="Center"
            MaximumWidthRequest="1120">

            <!-- Tiêu đề đồng bộ với Cơ bản, Phân số và Tìm x -->
            <VerticalStackLayout
                Margin="0,4,0,6"
                Spacing="2">

                <Label
                    Text="ax² + bx + c = 0"
                    FontSize="40"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="NoWrap"
                    TextColor="{DynamicResource PrimaryColor}" />

                <Label
                    Text="PHƯƠNG TRÌNH BẬC HAI"
                    FontSize="27"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="Tính biệt thức Δ • Xét số nghiệm • Trình bày lời giải chi tiết"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    TextColor="{DynamicResource TextSecondaryColor}" />

            </VerticalStackLayout>

            <!-- 1. Nhập hệ số -->
            <Border
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="1. Nhập các hệ số"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Label
                        Text="Chỉ nhập số nguyên, tối đa 15 chữ số cho mỗi hệ số. Hệ số a phải khác 0."
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <Grid
                        x:Name="CoefficientGrid"
                        ColumnDefinitions="*,*,*"
                        RowDefinitions="Auto"
                        ColumnSpacing="12"
                        RowSpacing="10">

                        <!-- Hệ số a -->
                        <Border
                            x:Name="CoefficientAPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số a"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Hệ số của x²"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="CoefficientAEntry"
                                        Placeholder="Ví dụ: 1"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="20"
                                        FontSize="17"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Hệ số b -->
                        <Border
                            x:Name="CoefficientBPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số b"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Hệ số của x"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="CoefficientBEntry"
                                        Placeholder="Ví dụ: −3"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="20"
                                        FontSize="17"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                        <!-- Hệ số c -->
                        <Border
                            x:Name="CoefficientCPanel"
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Hệ số c"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                <Label
                                    Text="Hệ số tự do"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource InputBackgroundColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="CoefficientCEntry"
                                        Placeholder="Ví dụ: 2"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        Keyboard="Text"
                                        MaxLength="20"
                                        FontSize="17"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        TextChanged="OnCoefficientEntryTextChanged"
                                        Focused="OnCoefficientEntryFocused"
                                        Unfocused="OnCoefficientEntryUnfocused" />

                                </Border>

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <!-- Xem trước phương trình -->
                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Phương trình đang nhập"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                            <Label
                                x:Name="EquationPreviewLabel"
                                Text="ax² + bx + c = 0"
                                FontSize="23"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Tính nghiệm"
                            HeightRequest="50"
                            Padding="10,0"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="{DynamicResource OnPrimaryColor}"
                            Clicked="OnCalculateClicked" />

                        <Button
                            Grid.Column="1"
                            Text="Xóa"
                            HeightRequest="50"
                            Padding="10,0"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnClearClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Thông báo lỗi -->
            <Border
                x:Name="ErrorBorder"
                IsVisible="False"
                Padding="12"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource ErrorColor}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Label
                    x:Name="ErrorLabel"
                    FontSize="14"
                    LineHeight="1.2"
                    LineBreakMode="WordWrap"
                    TextColor="{DynamicResource ErrorColor}" />

            </Border>

            <!-- 2. Kết quả -->
            <Border
                x:Name="ResultBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="2. Kết quả"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Label
                        x:Name="ResultEquationLabel"
                        FontSize="21"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="Biệt thức"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                                x:Name="DeltaValueLabel"
                                Text="Δ = 0"
                                FontSize="25"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                                HeightRequest="1"
                                Margin="0,2"
                                BackgroundColor="{DynamicResource DividerColor}" />

                            <Label
                                x:Name="ClassificationLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource SuccessColor}" />

                            <Label
                                x:Name="RootsLabel"
                                FontSize="30"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Padding="10,8"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="CalculationPathLabel"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- 3. Lời giải chi tiết -->
            <Border
                x:Name="SolutionBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="3. Lời giải chi tiết"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step1TitleLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step1BodyLabel"
                                FontSize="14"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step2TitleLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step2BodyLabel"
                                FontSize="14"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        x:Name="Step3Border"
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step3TitleLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step3BodyLabel"
                                FontSize="14"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        x:Name="Step4Border"
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="Step4TitleLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                x:Name="Step4BodyLabel"
                                FontSize="14"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- Ghi chú kỹ thuật -->
            <Border
                Padding="12"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8">

                    <Label
                        Grid.Column="0"
                        Text="ⓘ"
                        FontSize="16"
                        VerticalTextAlignment="Start"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Label
                        Grid.Column="1"
                        Text="FMA3 được dùng để tính Δ trên CPU x86/64 có hỗ trợ; các thiết bị còn lại tự động dùng nhánh scalar."
                        FontSize="13"
                        LineHeight="1.2"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentView>
