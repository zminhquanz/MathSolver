<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.CalculationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MathSolver.Views"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid
        x:Name="CalculationPageContentRoot"
        RowDefinitions="Auto,*">

        <!-- Thanh tab con -->
        <Border
            Grid.Row="0"
            Margin="20,12,20,8"
            Padding="6"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource PrimaryBorderBrush}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Grid
                x:Name="CalculationSubTabGrid"
                ColumnDefinitions="*,*,*,*,*"
                ColumnSpacing="6">

                <Button
                    x:Name="BasicTabButton"
                    Grid.Column="0"
                    Text="+ Cơ bản"
                    HeightRequest="44"
                    Padding="8,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="{DynamicResource OnPrimaryColor}"
                    Clicked="OnBasicTabClicked" />

                <Button
                    x:Name="FractionTabButton"
                    Grid.Column="1"
                    Text="½ Phân số"
                    HeightRequest="44"
                    Padding="8,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnFractionTabClicked" />

                <Button
                    x:Name="FindXTabButton"
                    Grid.Column="2"
                    Text="𝑥 Tìm x"
                    HeightRequest="44"
                    Padding="8,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnFindXTabClicked" />

                <Button
                    x:Name="QuadraticTabButton"
                    Grid.Column="3"
                    Text="x² Phương trình bậc 2"
                    HeightRequest="44"
                    Padding="6,0"
                    FontSize="13"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnQuadraticTabClicked" />

                <Button
                    x:Name="GeometryTabButton"
                    Grid.Column="4"
                    Text="△ Hình học"
                    HeightRequest="44"
                    Padding="8,0"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnGeometryTabClicked" />

            </Grid>

        </Border>

        <Grid Grid.Row="1">
            <ScrollView
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <VerticalStackLayout
                    x:Name="BasicTabContent"
                    Padding="20,16"
                    Spacing="14"
                    HorizontalOptions="Fill">

                    <!-- Tiêu đề -->
                    <VerticalStackLayout Spacing="2" Margin="0,4,0,6">

                        <Label
                        Text="+ − × ÷"
                        FontSize="42"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource PrimaryColor}" />

                        <Label
                        x:Name="PageTitle"
                        Text="PHÉP TÍNH CƠ BẢN"
                        FontSize="27"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                        x:Name="PageSubtitle"
                        Text="Cộng • Trừ • Nhân • Chia"
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    </VerticalStackLayout>

                    <!-- Khung chọn phép tính -->
                    <Border
                    Padding="14"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">

                            <Label
                            Text="1. Chọn phép tính"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                            <Grid
                            x:Name="OperationButtonsGrid"
                            ColumnDefinitions="*,*,*,*"
                            ColumnSpacing="8">

                                <Button
                                x:Name="AddButton"
                                Grid.Column="0"
                                Text="+"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                Padding="8,0"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnAddClicked" />

                                <Button
                                x:Name="SubtractButton"
                                Grid.Column="1"
                                Text="−"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                Padding="8,0"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnSubtractClicked" />

                                <Button
                                x:Name="MultiplyButton"
                                Grid.Column="2"
                                Text="×"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                Padding="8,0"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnMultiplyClicked" />

                                <Button
                                x:Name="DivideButton"
                                Grid.Column="3"
                                Text="÷"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                Padding="8,0"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                Clicked="OnDivideClicked" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Khung nhập số -->
                    <!-- Khung nhập số và chọn loại số -->
                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="2. Nhập các số"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <!-- Chọn số nguyên hoặc số thập phân -->
                            <Grid
                                x:Name="NumberTypeButtonsGrid"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="IntegerTypeButton"
                                    Grid.Column="0"
                                    Text="Số nguyên"
                                    HeightRequest="48"
                                    Padding="8,0"
                                    CornerRadius="12"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnIntegerTypeClicked" />

                                <Button
                                    x:Name="DecimalTypeButton"
                                    Grid.Column="1"
                                    Text="Số thập phân"
                                    HeightRequest="48"
                                    Padding="8,0"
                                    CornerRadius="12"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    Clicked="OnDecimalTypeClicked" />

                            </Grid>


                            <!-- Hai ô nhập số -->
                            <Grid
                                x:Name="NumberInputGrid"
                                ColumnDefinitions="*,Auto,*"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="6">

                                <Label
                                    x:Name="FirstNumberLabel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Số thứ nhất"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    x:Name="FirstNumberBorder"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                        x:Name="FirstNumberEntry"
                                        Placeholder="Ví dụ: 25"
                                        PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                        Keyboard="Numeric"
                                        FontSize="17"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        ClearButtonVisibility="WhileEditing"
                                        TextChanged="OnNumberEntryTextChanged" />

                                </Border>

                                <Label
                                    x:Name="OperatorLabel"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    WidthRequest="40"
                                    Text="+"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />

                                <Label
                                    x:Name="SecondNumberLabel"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Text="Số thứ hai"
                                    FontSize="14"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    x:Name="SecondNumberBorder"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <controls:BorderlessEntry
                                    x:Name="SecondNumberEntry"
                                    Placeholder="Ví dụ: 15"
                                    PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                    Keyboard="Numeric"
                                    FontSize="17"
                                    VerticalTextAlignment="Center"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    ClearButtonVisibility="WhileEditing"
                                    TextChanged="OnNumberEntryTextChanged" />
                                </Border>
                            </Grid>
                            <Grid
                                Margin="0,8,0,0"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12">

                                <Button
                                    Grid.Column="0"
                                    Text="Tính kết quả"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HeightRequest="54"
                                    CornerRadius="14"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnCalculateClicked" />

                                <Button
                                    Grid.Column="1"
                                    Text="Xóa"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HeightRequest="54"
                                    CornerRadius="14"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    Clicked="OnClearClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Thông báo lỗi -->
                    <Border
                    x:Name="ErrorBorder"
                    IsVisible="False"
                    Padding="14"
                    BackgroundColor="{DynamicResource DangerSoftColor}"
                    Stroke="{DynamicResource DangerBorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label
                        x:Name="ErrorLabel"
                        FontSize="15"
                        TextColor="{DynamicResource DangerColor}" />

                    </Border>

                    <!-- Kết quả -->
                    <Border
                    x:Name="ResultBorder"
                    IsVisible="False"
                    Padding="14"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <Label
                            Text="3. Kết quả"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                            x:Name="ExpressionLabel"
                            FontSize="21"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource DividerColor}" />

                            <Label
                            Text="Đáp số"
                            FontSize="13"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                            x:Name="ResultLabel"
                            FontSize="30"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                            <!-- Chi tiết phép chia -->
                            <Border
                            x:Name="DivisionDetailBorder"
                            IsVisible="False"
                            Padding="12"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                    x:Name="DivisionTypeLabel"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource SuccessColor}" />

                                    <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                        <!-- Thương -->
                                        <Border
                                        Grid.Column="0"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource SuccessSoftBrush}"
                                        StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                                Text="Thương"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{DynamicResource TextSecondaryColor}" />

                                                <Label
                                                x:Name="QuotientLabel"
                                                FontSize="28"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{DynamicResource SuccessColor}" />

                                            </VerticalStackLayout>

                                        </Border>
                                        <!-- Số dư -->
                                        <Border
                                        Grid.Column="1"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource SuccessSoftBrush}"
                                        StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                        Text="Số dư"
                                        FontSize="14"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource TextSecondaryColor}" />

                                                <Label
                                        x:Name="RemainderLabel"
                                        FontSize="28"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource WarningColor}" />

                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="14">

                                    <Label
                                Text="Lời giải"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                                    <Label
                                x:Name="ExplanationLabel"
                                FontSize="16"
                                LineHeight="1.3"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- Phép chia đặt tính -->
                            <Border
                            x:Name="LongDivisionBorder"
                            IsVisible="False"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="10">

                                    <Label
                                    Text="Phép chia đặt tính"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label
                                    Text="Các bước thực hiện phép chia theo cách trình bày ở tiểu học."
                                    FontSize="13"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                    <!-- Chọn cách hiển thị riêng cho phép chia đặt tính -->
                                    <Border
                                    Padding="12"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource DividerBrush}"
                                    StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="10">

                                            <Label
                                            Text="Hiển thị phép chia"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                            <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="12">

                                                <Border
                                                x:Name="ElementaryDivisionModeBorder"
                                                Grid.Column="0"
                                                Padding="12"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBrush}"
                                                StrokeThickness="1.5">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>

                                                    <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                        <RadioButton
                                                        x:Name="ElementaryDivisionModeRadioButton"
                                                        Grid.Column="0"
                                                        GroupName="LongDivisionDisplayMode"
                                                        IsChecked="True"
                                                        CheckedChanged="OnLongDivisionDisplayModeChanged"
                                                        VerticalOptions="Start" />

                                                        <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="3">

                                                            <Label
                                                            Text="Theo chương trình Tiểu học"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource PrimaryColor}" />

                                                            <Label
                                                            Text="Thương và số dư"
                                                            FontSize="12"
                                                            TextColor="{DynamicResource TextSecondaryColor}" />

                                                        </VerticalStackLayout>

                                                    </Grid>

                                                </Border>

                                                <Border
                                                x:Name="DecimalDivisionModeBorder"
                                                Grid.Column="1"
                                                Padding="12"
                                                BackgroundColor="{DynamicResource SurfaceColor}"
                                                Stroke="{DynamicResource BorderBrush}"
                                                StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>

                                                    <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                        <RadioButton
                                                        x:Name="DecimalDivisionModeRadioButton"
                                                        Grid.Column="0"
                                                        GroupName="LongDivisionDisplayMode"
                                                        CheckedChanged="OnLongDivisionDisplayModeChanged"
                                                        VerticalOptions="Start" />

                                                        <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="3">

                                                            <Label
                                                            Text="Theo số thập phân"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                                            <Label
                                                            Text="Tiếp tục chia đến kết quả thập phân"
                                                            FontSize="12"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextSecondaryColor}" />

                                                        </VerticalStackLayout>

                                                    </Grid>

                                                </Border>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                    <Border
                                        Padding="8"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource DividerBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <GraphicsView
                                        x:Name="LongDivisionGraphicsView"
                                        HeightRequest="620"
                                        MinimumHeightRequest="180"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}" />

                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                            x:Name="AdditionalBorder"    
                            IsVisible="True"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="10">
                                    <Label
                                    Text="Thông tin thêm"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryDarkColor}" />

                                    <Label
                                        x:Name="AdditionalLabel"
                                        FontSize="16"
                                        LineHeight="1.3"
                                        TextColor="{DynamicResource TextPrimaryColor}"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lưu ý khi sử dụng -->
                    <Border
                    Padding="16"
                    BackgroundColor="{DynamicResource WarningSoftColor}"
                    Stroke="{DynamicResource WarningBorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">

                            <Label
                            Grid.Column="0"
                            Text="⚠"
                            FontSize="24"
                            VerticalOptions="Start"
                            TextColor="{DynamicResource WarningColor}" />

                            <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6">

                                <Label
                                Text="Lưu ý khi sử dụng"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WarningColor}" />

                                <Label
                                Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                                FontSize="14"
                                LineHeight="1.25"
                                TextColor="{DynamicResource WarningColor}" />

                                <Label
                                Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                                FontSize="14"
                                FontAttributes="Italic"
                                LineHeight="1.25"
                                TextColor="{DynamicResource WarningColor}" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
            <!-- Tab Phân số -->
            <Grid
                x:Name="FractionTabContent"
                IsVisible="False">
                <views:FractionView />
            </Grid>

            <!-- Tab tìm x -->
            <Grid
                x:Name="FindXTabContent"
                IsVisible="False">
                <views:FindXView />

            </Grid>

            <!-- Tab phương trình bậc hai -->
            <Grid
                x:Name="QuadraticTabContent"
                IsVisible="False">
                <views:QuadraticEquationView />
            </Grid>

            <!-- Tab hình học -->
            <ScrollView
                x:Name="GeometryTabContent"
                IsVisible="False"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">

                <VerticalStackLayout
                    Padding="20,16,20,18"
                    Spacing="12"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="HÌNH HỌC"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            Text="Tính chu vi và diện tích các hình"
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                    </VerticalStackLayout>

                    <Border
                        Padding="22"
                        BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout
                            Spacing="12"
                            HorizontalOptions="Center">

                            <Label
                                Text="□  △  ○"
                                FontSize="40"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />

                            <Label
                                Text="Chu vi và diện tích"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                Text="Khu vực này sẽ hỗ trợ hình vuông, hình chữ nhật, tam giác, hình tròn, hình thang và các hình học khác."
                                FontSize="14"
                                LineHeight="1.25"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Border
                                Padding="10,6"
                                BackgroundColor="{DynamicResource PrimarySoftColor}"
