<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MathSolver.Views.CalculationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:MathSolver.Views"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid
        x:Name="CalculationPageContentRoot"
        RowDefinitions="Auto,*">

        <!-- Thanh tab con -->
        <!-- Android: Material-style scrolling tab row, không dùng pill/card desktop. -->
        <Grid
            x:Name="AndroidCalculationSubTabBar"
            Grid.Row="0"
            IsVisible="{OnPlatform Android=True, WinUI=False, Default=False}"
            RowDefinitions="Auto,1"
            Margin="0,0,0,4"
            BackgroundColor="{DynamicResource SurfaceColor}">

            <ScrollView
                x:Name="AndroidCalculationSubTabScrollView"
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalOptions="Fill"
                HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout Spacing="0" Padding="6,0">
                    <Grid MinimumWidthRequest="92" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidBasicTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.Basic}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            TextColor="{DynamicResource PrimaryColor}"
                            Clicked="OnBasicTabClicked" />
                        <BoxView
                            x:Name="AndroidBasicTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="{DynamicResource PrimaryColor}" />
                    </Grid>

                    <Grid MinimumWidthRequest="118" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidAverageTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.Average}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            Clicked="OnAverageTabClicked" />
                        <BoxView
                            x:Name="AndroidAverageTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="Transparent" />
                    </Grid>

                    <Grid MinimumWidthRequest="144" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidPowerRootTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.PowerRoot}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            Clicked="OnPowerRootTabClicked" />
                        <BoxView
                            x:Name="AndroidPowerRootTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="Transparent" />
                    </Grid>

                    <Grid MinimumWidthRequest="92" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidFractionTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.Fraction}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            Clicked="OnFractionTabClicked" />
                        <BoxView
                            x:Name="AndroidFractionTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="Transparent" />
                    </Grid>

                    <Grid MinimumWidthRequest="84" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidFindXTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.FindX}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            Clicked="OnFindXTabClicked" />
                        <BoxView
                            x:Name="AndroidFindXTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="Transparent" />
                    </Grid>

                    <Grid MinimumWidthRequest="140" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidQuadraticTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.Quadratic}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            Clicked="OnQuadraticTabClicked" />
                        <BoxView
                            x:Name="AndroidQuadraticTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="Transparent" />
                    </Grid>

                    <Grid MinimumWidthRequest="96" RowDefinitions="44,3">
                        <Button
                            x:Name="AndroidGeometryTabButton"
                            Grid.Row="0"
                            Text="{localization:Translate Calculation.Tabs.Geometry}"
                            Style="{StaticResource AndroidNativeSubTabButtonStyle}"
                            Clicked="OnGeometryTabClicked" />
                        <BoxView
                            x:Name="AndroidGeometryTabIndicator"
                            Grid.Row="1"
                            HeightRequest="3"
                            Margin="10,0"
                            BackgroundColor="Transparent" />
                    </Grid>
                </HorizontalStackLayout>
            </ScrollView>

            <BoxView
                Grid.Row="1"
                HeightRequest="1"
                BackgroundColor="{DynamicResource DividerColor}" />
        </Grid>

        <Border
            Grid.Row="0"
            IsVisible="{OnPlatform Android=False, WinUI=True, Default=True}"
            Margin="{OnPlatform Android='10,8,10,6', WinUI='20,12,20,8', Default='20,12,20,8'}"
            Padding="{OnPlatform Android=4, WinUI=6, Default=6}"
            BackgroundColor="{DynamicResource SurfaceColor}"
            Stroke="{DynamicResource PrimaryBorderBrush}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{OnPlatform Android=12, WinUI=14, Default=14}" />
            </Border.StrokeShape>

            <ScrollView
                x:Name="CalculationSubTabScrollView"
                Orientation="Horizontal"
                HorizontalOptions="Fill"
                HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout
                    x:Name="CalculationSubTabGrid"
                    Spacing="6">

                <Button
                    x:Name="BasicTabButton"
                    Text="{localization:Translate Calculation.Tabs.Basic}"
                    MinimumWidthRequest="{OnPlatform Android=104, WinUI=146, Default=146}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="{DynamicResource OnPrimaryColor}"
                    Clicked="OnBasicTabClicked" />

                <Button
                    x:Name="AverageTabButton"
                    Text="{localization:Translate Calculation.Tabs.Average}"
                    MinimumWidthRequest="{OnPlatform Android=126, WinUI=180, Default=180}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnAverageTabClicked" />

                <Button
                    x:Name="PowerRootTabButton"
                    Text="{localization:Translate Calculation.Tabs.PowerRoot}"
                    MinimumWidthRequest="{OnPlatform Android=154, WinUI=214, Default=214}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    FontSize="15"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnPowerRootTabClicked" />

                <Button
                    x:Name="FractionTabButton"
                    Text="{localization:Translate Calculation.Tabs.Fraction}"
                    MinimumWidthRequest="{OnPlatform Android=98, WinUI=132, Default=132}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnFractionTabClicked" />

                <Button
                    x:Name="FindXTabButton"
                    Text="{localization:Translate Calculation.Tabs.FindX}"
                    MinimumWidthRequest="{OnPlatform Android=92, WinUI=126, Default=126}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnFindXTabClicked" />

                <Button
                    x:Name="QuadraticTabButton"
                    Text="{localization:Translate Calculation.Tabs.Quadratic}"
                    MinimumWidthRequest="{OnPlatform Android=150, WinUI=206, Default=206}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    Padding="6,0"
                    FontSize="15"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnQuadraticTabClicked" />

                <Button
                    x:Name="GeometryTabButton"
                    Text="{localization:Translate Calculation.Tabs.Geometry}"
                    MinimumWidthRequest="{OnPlatform Android=102, WinUI=138, Default=138}"
                    Style="{StaticResource SolverSubTabButtonStyle}"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    Clicked="OnGeometryTabClicked" />

                </HorizontalStackLayout>

            </ScrollView>

        </Border>

        <Grid Grid.Row="1">
            <ScrollView
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <VerticalStackLayout
                    x:Name="BasicTabContent"
                    Style="{StaticResource SolverContentStyle}">

                    <!-- Tiêu đề -->
                    <VerticalStackLayout Style="{StaticResource SolverHeroStyle}">

                        <Label
                        Text="+ − × ÷"
                        Style="{StaticResource SolverHeroSymbolStyle}" />

                        <Label
                        x:Name="PageTitle"
                        Text="{localization:Translate Calculation.Arithmetic.Title}"
                        Style="{StaticResource SolverHeroTitleStyle}" />

                        <Label
                        x:Name="PageSubtitle"
                        Text="{localization:Translate Calculation.Arithmetic.Subtitle}"
                        Style="{StaticResource SolverHeroSubtitleStyle}" />

                    </VerticalStackLayout>

                    <!-- Khung chọn phép tính -->
                    <Border
                    Style="{StaticResource SolverCardStyle}">

                        <VerticalStackLayout Spacing="14">

                            <Label
                            Text="1. Chọn phép tính"
                            Style="{StaticResource SolverSectionTitleStyle}" />

                            <Grid
                            x:Name="OperationButtonsGrid"
                            ColumnDefinitions="{OnPlatform Android='*,*,*,*', WinUI='*,*,*,*,1.35*', Default='*,*,*,*,1.35*'}"
                            RowDefinitions="{OnPlatform Android='Auto,Auto', WinUI='Auto', Default='Auto'}"
                            ColumnSpacing="8"
                            RowSpacing="8">

                                <Button
                                x:Name="AddButton"
                                Grid.Column="0"
                                Text="+"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnAddClicked" />

                                <Button
                                x:Name="SubtractButton"
                                Grid.Column="1"
                                Text="−"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnSubtractClicked" />

                                <Button
                                x:Name="MultiplyButton"
                                Grid.Column="2"
                                Text="×"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnMultiplyClicked" />

                                <Button
                                x:Name="DivideButton"
                                Grid.Column="3"
                                Text="÷"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                TextColor="{DynamicResource OnPrimaryColor}"
                                Clicked="OnDivideClicked" />

                                <Button
                                x:Name="ExpressionButton"
                                Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                Grid.Column="{OnPlatform Android=0, WinUI=4, Default=4}"
                                Grid.ColumnSpan="{OnPlatform Android=4, WinUI=1, Default=1}"
                                Text="{localization:Translate Calculation.Expression.Option}"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                FontSize="15"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                Clicked="OnExpressionClicked" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <!-- Khung nhập số -->
                    <!-- Khung nhập số và chọn loại số -->
                    <Border Style="{StaticResource SolverCardStyle}">

                        <VerticalStackLayout Spacing="14">

                            <Label
                                x:Name="NumberInputTitleLabel"
                                Text="{localization:Translate Calculation.Arithmetic.InputNumbersTitle}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <Label
                                x:Name="ExpressionInputTitleLabel"
                                IsVisible="False"
                                Text="{localization:Translate Calculation.Expression.InputTitle}"
                                Style="{StaticResource SolverSectionTitleStyle}" />

                            <!-- Chọn số nguyên hoặc số thập phân -->
                            <Grid
                                x:Name="NumberTypeButtonsGrid"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    x:Name="IntegerTypeButton"
                                    Grid.Column="0"
                                    Text="{localization:Translate Numbers.Integer}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="{DynamicResource OnPrimaryColor}"
                                    Clicked="OnIntegerTypeClicked" />

                                <Button
                                    x:Name="DecimalTypeButton"
                                    Grid.Column="1"
                                    Text="{localization:Translate Numbers.Decimal}"
                                    Style="{StaticResource SolverChoiceButtonStyle}"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    Clicked="OnDecimalTypeClicked" />

                            </Grid>


                            <!-- Hai ô nhập số -->
                            <Grid
                                x:Name="NumberInputGrid"
                                ColumnDefinitions="{OnPlatform Android='*', WinUI='*,Auto,*', Default='*,Auto,*'}"
                                RowDefinitions="{OnPlatform Android='Auto,Auto,Auto,Auto,Auto', WinUI='Auto,Auto', Default='Auto,Auto'}"
                                ColumnSpacing="12"
                                RowSpacing="6">

                                <Label
                                    x:Name="FirstNumberLabel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Số thứ nhất"
                                    FontSize="16"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    x:Name="FirstNumberBorder"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Entry
                                        x:Name="FirstNumberEntry"
                                        Placeholder="Ví dụ: 25"
                                        PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                        Keyboard="Numeric"
                                        FontSize="19"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        ClearButtonVisibility="WhileEditing"
                                        TextChanged="OnNumberEntryTextChanged" />

                                </Border>

                                <Label
                                    x:Name="OperatorLabel"
                                    Grid.Row="{OnPlatform Android=2, WinUI=1, Default=1}"
                                    Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                    WidthRequest="{OnPlatform Android='36', WinUI='40', Default='40'}"
                                    Text="+"
                                    FontSize="27"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    TextColor="{DynamicResource PrimaryColor}" />

                                <Label
                                    x:Name="SecondNumberLabel"
                                    Grid.Row="{OnPlatform Android=3, WinUI=0, Default=0}"
                                    Grid.Column="{OnPlatform Android=0, WinUI=2, Default=2}"
                                    Text="Số thứ hai"
                                    FontSize="16"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    x:Name="SecondNumberBorder"
                                    Grid.Row="{OnPlatform Android=4, WinUI=1, Default=1}"
                                    Grid.Column="{OnPlatform Android=0, WinUI=2, Default=2}"
                                    HeightRequest="48"
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Entry
                                    x:Name="SecondNumberEntry"
                                    Placeholder="Ví dụ: 15"
                                    PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                    Keyboard="Numeric"
                                    FontSize="19"
                                    VerticalTextAlignment="Center"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    ClearButtonVisibility="WhileEditing"
                                    TextChanged="OnNumberEntryTextChanged" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout
                                x:Name="ExpressionInputPanel"
                                IsVisible="False"
                                Spacing="10">

                                <Label
                                    Text="{localization:Translate Calculation.Expression.InputHelp}"
                                    FontSize="15"
                                    LineHeight="1.25"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                <Border
                                    Padding="12,8"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Editor
                                        x:Name="ArithmeticExpressionEditor"
                                        Placeholder="{localization:Translate Calculation.Expression.Placeholder}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="132"
                                        FontSize="19"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource TextSecondaryColor}"
                                        BackgroundColor="Transparent"
                                        Focused="OnArithmeticExpressionFocused"
                                        Unfocused="OnArithmeticExpressionUnfocused"
                                        TextChanged="OnArithmeticExpressionTextChanged" />
                                </Border>

                                <Border
                                    Padding="12,10"
                                    BackgroundColor="{DynamicResource PrimarySoftColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label
                                        Text="{localization:Translate Calculation.Expression.PriorityHint}"
                                        FontSize="14"
                                        LineHeight="1.25"
                                        LineBreakMode="WordWrap"
                                        TextColor="{DynamicResource TextPrimaryColor}" />
                                </Border>

                            </VerticalStackLayout>

                            <Grid
                                Margin="0,8,0,0"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12">

                                <Button
                                    Grid.Column="0"
                                    Text="{localization:Translate Actions.Calculate}"
                                    Style="{StaticResource SolverPrimaryActionStyle}"
                                    Clicked="OnCalculateClicked" />

                                <Button
                                    Grid.Column="1"
                                    Text="{localization:Translate Actions.Clear}"
                                    Style="{StaticResource SolverSecondaryActionStyle}"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    Clicked="OnClearClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Thông báo lỗi -->
                    <Border
                    x:Name="ErrorBorder"
                    IsVisible="False"
                    Padding="14"
                    BackgroundColor="{DynamicResource DangerSoftColor}"
                    Stroke="{DynamicResource DangerBorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">
                            
                            <Label
                            Grid.Column="0"
                            Text="❌"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource DangerColor}" />
                            
                            <Label
                            Grid.Column="1"
                            x:Name="ErrorLabel"
                            FontSize="17"
                            TextColor="{DynamicResource DangerColor}" />
                        </Grid>

                    </Border>

                    <!-- Kết quả -->
                    <Border
                    x:Name="ResultBorder"
                    IsVisible="False"
                    Padding="14"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource PrimaryBorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <Label
                            Text="3. Kết quả"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                            x:Name="ExpressionLabel"
                            FontSize="23"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource PrimaryColor}" />

                            <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource DividerColor}" />

                            <Label
                            Text="Đáp số"
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                            x:Name="ResultLabel"
                            FontSize="32"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                            <Grid HeightRequest="48">

                                <Button
                                    x:Name="BasicCopyResultButton"
                                    Text="{localization:Translate PowerRoot.CopyResult}"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    TextColor="Transparent"
                                    Clicked="OnBasicCopyResultClicked" />

                                <HorizontalStackLayout
                                    InputTransparent="True"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="8">

                                    <controls:ThemedCopyIcon
                                        WidthRequest="20"
                                        HeightRequest="20" />

                                    <Label
                                        Text="{Binding Text, Source={x:Reference BasicCopyResultButton}}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Grid>

                            <!-- Chi tiết phép chia -->
                            <Border
                            x:Name="DivisionDetailBorder"
                            IsVisible="False"
                            Padding="12"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                    x:Name="DivisionTypeLabel"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource SuccessColor}" />

                                    <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10">
                                        <!-- Thương -->
                                        <Border
                                        Grid.Column="0"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource SuccessSoftBrush}"
                                        StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                                Text="Thương"
                                                FontSize="16"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{DynamicResource TextSecondaryColor}" />

                                                <Label
                                                x:Name="QuotientLabel"
                                                FontSize="30"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{DynamicResource SuccessColor}" />

                                            </VerticalStackLayout>

                                        </Border>
                                        <!-- Số dư -->
                                        <Border
                                        Grid.Column="1"
                                        Padding="12"
                                        BackgroundColor="{DynamicResource SurfaceColor}"
                                        Stroke="{DynamicResource SuccessSoftBrush}"
                                        StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="4">

                                                <Label
                                        Text="Số dư"
                                        FontSize="16"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource TextSecondaryColor}" />

                                                <Label
                                        x:Name="RemainderLabel"
                                        FontSize="30"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource WarningColor}" />

                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="14">

                                    <Label
                                Text="Lời giải"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                                    <Label
                                x:Name="ExplanationLabel"
                                FontSize="18"
                                LineHeight="1.3"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- Phép chia đặt tính -->
                            <Border
                            x:Name="LongDivisionBorder"
                            IsVisible="False"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="10">

                                    <Label
                                    Text="Phép chia đặt tính"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />

                                    <Label
                                    Text="Các bước thực hiện phép chia theo cách trình bày ở tiểu học."
                                    FontSize="15"
                                    TextColor="{DynamicResource TextSecondaryColor}" />

                                    <!-- Chọn cách hiển thị riêng cho phép chia đặt tính -->
                                    <Border
                                    Padding="12"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource DividerBrush}"
                                    StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="10">

                                            <Label
                                            Text="Hiển thị phép chia"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                            <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="12">

                                                <Border
                                                x:Name="ElementaryDivisionModeBorder"
                                                Grid.Column="0"
                                                Padding="12"
                                                BackgroundColor="{DynamicResource PrimarySoftColor}"
                                                Stroke="{DynamicResource PrimaryBrush}"
                                                StrokeThickness="1.5">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>

                                                    <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                        <RadioButton
                                                        x:Name="ElementaryDivisionModeRadioButton"
                                                        Grid.Column="0"
                                                        GroupName="LongDivisionDisplayMode"
                                                        IsChecked="True"
                                                        CheckedChanged="OnLongDivisionDisplayModeChanged"
                                                        VerticalOptions="Start" />

                                                        <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="3">

                                                            <Label
                                                            Text="Theo chương trình Tiểu học"
                                                            FontSize="16"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource PrimaryColor}" />

                                                            <Label
                                                            Text="Thương và số dư"
                                                            FontSize="14"
                                                            TextColor="{DynamicResource TextSecondaryColor}" />

                                                        </VerticalStackLayout>

                                                    </Grid>

                                                </Border>

                                                <Border
                                                x:Name="DecimalDivisionModeBorder"
                                                Grid.Column="1"
                                                Padding="12"
                                                BackgroundColor="{DynamicResource SurfaceColor}"
                                                Stroke="{DynamicResource BorderBrush}"
                                                StrokeThickness="1">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>

                                                    <Grid
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8">

                                                        <RadioButton
                                                        x:Name="DecimalDivisionModeRadioButton"
                                                        Grid.Column="0"
                                                        GroupName="LongDivisionDisplayMode"
                                                        CheckedChanged="OnLongDivisionDisplayModeChanged"
                                                        VerticalOptions="Start" />

                                                        <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="3">

                                                            <Label
                                                            Text="Theo số thập phân"
                                                            FontSize="16"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource TextPrimaryColor}" />

                                                            <Label
                                                            Text="Tiếp tục chia đến kết quả thập phân"
                                                            FontSize="14"
                                                            LineBreakMode="WordWrap"
                                                            TextColor="{DynamicResource TextSecondaryColor}" />

                                                        </VerticalStackLayout>

                                                    </Grid>

                                                </Border>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </Border>

                                    <Border
                                        Padding="8"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                                        Stroke="{DynamicResource DividerBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <GraphicsView
                                        x:Name="LongDivisionGraphicsView"
                                        HeightRequest="620"
                                        MinimumHeightRequest="180"
                                        HorizontalOptions="Fill"
                                        BackgroundColor="{DynamicResource SurfaceAltColor}" />

                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                            x:Name="AdditionalBorder"    
                            IsVisible="True"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="10">
                                    <Label
                                    Text="Thông tin thêm"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryDarkColor}" />

                                    <Label
                                        x:Name="AdditionalLabel"
                                        FontSize="18"
                                        LineHeight="1.3"
                                        TextColor="{DynamicResource TextPrimaryColor}"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lưu ý khi sử dụng -->
                    <Border
                    Padding="16"
                    BackgroundColor="{DynamicResource WarningSoftColor}"
                    Stroke="{DynamicResource WarningBorderBrush}"
                    StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12">

                            <Label
                            Grid.Column="0"
                            Text="⚠"
                            FontSize="26"
                            VerticalOptions="Start"
                            TextColor="{DynamicResource WarningColor}" />

                            <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6">

                                <Label
                                Text="Lưu ý khi sử dụng"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WarningColor}" />

                                <Label
                                Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                                FontSize="16"
                                LineHeight="1.25"
                                TextColor="{DynamicResource WarningColor}" />

                                <Label
                                Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                                FontSize="16"
                                FontAttributes="Italic"
                                LineHeight="1.25"
                                TextColor="{DynamicResource WarningColor}" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
            <!-- Tab trung bình cộng -->
            <Grid
                x:Name="AverageTabContent"
                IsVisible="False">
                <views:AverageView x:Name="AverageSolverView" />
            </Grid>

            <!-- Tab lũy thừa - căn bậc -->
            <Grid
                x:Name="PowerRootTabContent"
                IsVisible="False">
                <views:PowerRootView x:Name="PowerRootSolverView" />
            </Grid>

            <!-- Tab Phân số -->
            <Grid
                x:Name="FractionTabContent"
                IsVisible="False">
                <views:FractionView x:Name="FractionSolverView" />
            </Grid>

            <!-- Tab tìm x -->
            <Grid
                x:Name="FindXTabContent"
                IsVisible="False">
                <views:FindXView x:Name="FindXSolverView" />

            </Grid>

            <!-- Tab phương trình bậc hai -->
            <Grid
                x:Name="QuadraticTabContent"
                IsVisible="False">
                <views:QuadraticEquationView x:Name="QuadraticSolverView" />
            </Grid>

            <!-- Tab hình học -->
            <Grid
                x:Name="GeometryTabContent"
                IsVisible="False">

                <views:GeometryCalculatorView x:Name="GeometrySolverView" />

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
