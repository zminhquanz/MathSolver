<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MathSolver.Views.MotionFormulaView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Padding="{OnPlatform Android='12,10,12,20', WinUI='20,16,20,28', Default='20,16,20,28'}"
            Spacing="{OnPlatform Android=10, WinUI=14, Default=14}"
            HorizontalOptions="Fill">

            <VerticalStackLayout
                Margin="{OnPlatform Android='0,2,0,3', WinUI='0,4,0,6', Default='0,4,0,6'}"
                Spacing="2">

                <Label
                    Text="➜  ⏱  📍"
                    FontSize="36"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource PrimaryColor}" />

                <Label
                    Text="{localization:Translate Formula.Motion.Title}"
                    FontSize="{OnPlatform Android=23, WinUI=27, Default=27}"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="{localization:Translate Formula.Motion.Subtitle}"
                    FontSize="{OnPlatform Android=14, WinUI=17, Default=17}"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextSecondaryColor}" />

            </VerticalStackLayout>

            <!-- 1. Mối quan hệ -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.Relationship}"
                        FontSize="{OnPlatform Android=19, WinUI=22, Default=22}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Relationship}"
                        FontSize="17"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Border
                        Padding="15,12"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="10">
                            <Label
                                Grid.Column="0"
                                Text="d = v × t"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                Grid.Column="1"
                                Text="v = d ÷ t"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                Grid.Column="2"
                                Text="t = d ÷ v"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="12"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="{localization:Translate Formula.Motion.SymbolLegend}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Padding="10,8" BackgroundColor="{DynamicResource PrimarySoftColor}" Stroke="{DynamicResource PrimaryBorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <Label Text="{localization:Translate Formula.Motion.Symbol.Distance}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource PrimaryColor}" />
                                </Border>
                                <Border Grid.Column="1" Padding="10,8" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <Label Text="{localization:Translate Formula.Motion.Symbol.Speed}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextPrimaryColor}" />
                                </Border>
                                <Border Grid.Column="2" Padding="10,8" BackgroundColor="{DynamicResource SurfaceColor}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9" />
                                    </Border.StrokeShape>
                                    <Label Text="{localization:Translate Formula.Motion.Symbol.Time}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextPrimaryColor}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label
                        Text="{localization:Translate Formula.Motion.Symbols}"
                        FontSize="15"
                        FontAttributes="Italic"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Minh họa tương tác -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Motion.Graph.Title}"
                        FontSize="{OnPlatform Android=19, WinUI=22, Default=22}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Graph.Subtitle}"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <Grid
                        x:Name="MotionInteractiveGrid"
                        ColumnDefinitions="3*,7*"
                        ColumnSpacing="16">

                        <Border
                            x:Name="MotionExplanationPanel"
                            Grid.Column="0"
                            Padding="16"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="12"
                                VerticalOptions="Center">
                                <Label
                                    Text="v = d ÷ t"
                                    FontSize="28"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    x:Name="MotionAverageFormulaLabel"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextSecondaryColor}" />
                                <BoxView
                                    HeightRequest="1"
                                    Color="{DynamicResource PrimaryBorderColor}" />

                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="d" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Grid.Column="1" x:Name="MotionDistanceValueLabel" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                    <Label Grid.Column="2" Text="m" FontSize="18" TextColor="{DynamicResource TextSecondaryColor}" />
                                </Grid>
                                <Border
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Slider
                                        x:Name="MotionDistanceSlider"
                                        Minimum="10"
                                        Maximum="120"
                                        Value="40"
                                        HeightRequest="{OnPlatform Android=48, WinUI=36, Default=36}"
                                        ValueChanged="OnMotionSliderValueChanged" />
                                </Border>

                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="t" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                    <Label Grid.Column="1" x:Name="MotionTimeValueLabel" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                    <Label Grid.Column="2" Text="s" FontSize="18" TextColor="{DynamicResource TextSecondaryColor}" />
                                </Grid>
                                <Border
                                    Padding="10,0"
                                    BackgroundColor="{DynamicResource SurfaceAltColor}"
                                    Stroke="{DynamicResource PrimaryBorderBrush}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Slider
                                        x:Name="MotionTimeSlider"
                                        Minimum="1"
                                        Maximum="6"
                                        Value="1"
                                        HeightRequest="{OnPlatform Android=48, WinUI=36, Default=36}"
                                        ValueChanged="OnMotionSliderValueChanged" />
                                </Border>

                                <Label
                                    x:Name="MotionSpeedValueLabel"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="MotionGraphPanel"
                            Grid.Column="1"
                            Padding="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <GraphicsView
                                x:Name="MotionGraphicsView"
                                HeightRequest="390"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Các dạng chuyển động -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Motion.Types.Title}"
                        FontSize="{OnPlatform Android=19, WinUI=22, Default=22}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Types.Subtitle}"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="12">

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate Formula.Motion.Types.Basic.Title}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                <Label Text="{localization:Translate Formula.Motion.Types.Basic.Body}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate Formula.Motion.Types.Chasing.Title}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label Text="{localization:Translate Formula.Motion.Types.Chasing.Body}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate Formula.Motion.Types.Meeting.Title}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label Text="{localization:Translate Formula.Motion.Types.Meeting.Body}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate Formula.Motion.Types.River.Title}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label Text="{localization:Translate Formula.Motion.Types.River.Body}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate Formula.Motion.Types.Advanced.Title}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label Text="{localization:Translate Formula.Motion.Types.Advanced.Body}" FontSize="16" LineHeight="1.3" LineBreakMode="WordWrap" TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Công thức -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="11">
                    <Label
                        Text="{localization:Translate Formula.Common.Formulas}"
                        FontSize="{OnPlatform Android=19, WinUI=22, Default=22}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="12">

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.MeetingFormula}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.ChasingFormula}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.AverageFormula}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.UnitConversion}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 5. Tính chất -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="{localization:Translate Formula.Common.Properties}"
                        FontSize="{OnPlatform Android=19, WinUI=22, Default=22}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Properties}"
                        FontSize="17"
                        LineHeight="1.35"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />
                    <Border
                        Padding="13,10"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>
                        <Label
                            Text="{localization:Translate Formula.Motion.UnitWarning}"
                            FontSize="16"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 6. Cách giải -->
            <Border
                Padding="{OnPlatform Android=14, WinUI=18, Default=18}"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.HowToSolve}"
                        FontSize="{OnPlatform Android=19, WinUI=22, Default=22}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Steps}"
                        FontSize="17"
                        LineHeight="1.35"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{localization:Translate Formula.Motion.MeetingExampleTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Motion.MeetingExample}"
                                    FontSize="16"
                                    LineHeight="1.3"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{localization:Translate Formula.Motion.ChasingExampleTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Motion.ChasingExample}"
                                    FontSize="16"
                                    LineHeight="1.3"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
