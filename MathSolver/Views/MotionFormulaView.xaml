<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="MathSolver.Views.MotionFormulaView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Padding="20,16,20,28"
            Spacing="14"
            HorizontalOptions="Fill">

            <VerticalStackLayout
                Margin="0,4,0,6"
                Spacing="2">

                <Label
                    Text="➜  ⏱  📍"
                    FontSize="36"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource PrimaryColor}" />

                <Label
                    Text="{localization:Translate Formula.Motion.Title}"
                    FontSize="27"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextPrimaryColor}" />

                <Label
                    Text="{localization:Translate Formula.Motion.Subtitle}"
                    FontSize="17"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource TextSecondaryColor}" />

            </VerticalStackLayout>

            <!-- 1. Mối quan hệ -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.Relationship}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Relationship}"
                        FontSize="17"
                        LineHeight="1.3"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Border
                        Padding="15,12"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="10">
                            <Label
                                Grid.Column="0"
                                Text="s = v × t"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                Grid.Column="1"
                                Text="v = s ÷ t"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                            <Label
                                Grid.Column="2"
                                Text="t = s ÷ v"
                                FontSize="21"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource PrimaryColor}" />
                        </Grid>
                    </Border>

                    <Label
                        Text="{localization:Translate Formula.Motion.Symbols}"
                        FontSize="15"
                        FontAttributes="Italic"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Công thức -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="11">
                    <Label
                        Text="{localization:Translate Formula.Common.Formulas}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="12">

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.MeetingFormula}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.ChasingFormula}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.AverageFormula}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label
                                Text="{localization:Translate Formula.Motion.UnitConversion}"
                                FontSize="17"
                                FontAttributes="Bold"
                                LineHeight="1.3"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Tính chất -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="{localization:Translate Formula.Common.Properties}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Properties}"
                        FontSize="17"
                        LineHeight="1.35"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />
                    <Border
                        Padding="13,10"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimaryBorderBrush}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9" />
                        </Border.StrokeShape>
                        <Label
                            Text="{localization:Translate Formula.Motion.UnitWarning}"
                            FontSize="16"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap"
                            TextColor="{DynamicResource PrimaryColor}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Cách giải -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{localization:Translate Formula.Common.HowToSolve}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource PrimaryColor}" />
                    <Label
                        Text="{localization:Translate Formula.Motion.Steps}"
                        FontSize="17"
                        LineHeight="1.35"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{DynamicResource PrimarySoftColor}"
                            Stroke="{DynamicResource PrimaryBorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{localization:Translate Formula.Motion.MeetingExampleTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Motion.MeetingExample}"
                                    FontSize="16"
                                    LineHeight="1.3"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{localization:Translate Formula.Motion.ChasingExampleTitle}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                                <Label
                                    Text="{localization:Translate Formula.Motion.ChasingExample}"
                                    FontSize="16"
                                    LineHeight="1.3"
                                    LineBreakMode="WordWrap"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
