<?xml version="1.0" encoding="utf-8" ?>
<base:LocalizedSolverView
    x:Class="MathSolver.Views.NumberTheoryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    BackgroundColor="Transparent" HorizontalOptions="Fill">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Style="{StaticResource SolverFixedHeaderStyle}" controls:SolverHeader.CompactTitle="{localization:Translate Solver.Compact.NumberTheory}">
            <VerticalStackLayout Style="{StaticResource SolverHeroStyle}">
                <Label Text="a ∣ b" Style="{StaticResource SolverHeroSymbolStyle}" />
                <Label Text="{localization:Translate NumberTheory.Title}" Style="{StaticResource SolverHeroTitleStyle}" />
                <Label Text="{localization:Translate NumberTheory.Subtitle}" Style="{StaticResource SolverHeroSubtitleStyle}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1" controls:SolverWorkspace.IsEnabled="True">
            <VerticalStackLayout Style="{StaticResource SolverScrollableContentStyle}">
                <Border Style="{StaticResource SolverCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{localization:Translate NumberTheory.ChooseMode}" Style="{StaticResource SolverSectionTitleStyle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="GcdButton" Text="{localization:Translate NumberTheory.GcdButton}"
                                    Style="{StaticResource SolverNumberTypeButtonStyle}" Clicked="OnGcdClicked" />
                            <Button x:Name="LcmButton" Grid.Column="1" Text="{localization:Translate NumberTheory.LcmButton}"
                                    Style="{StaticResource SolverNumberTypeButtonStyle}" Clicked="OnLcmClicked" />
                        </Grid>
                        <Label Text="{localization:Translate NumberTheory.InputTitle}" Style="{StaticResource SolverSectionTitleStyle}" />
                        <Label Text="{localization:Translate NumberTheory.InputHelp}" FontSize="15"
                               TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                        <Grid x:Name="InputsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="12" RowSpacing="12" SizeChanged="OnInputsSizeChanged">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{localization:Translate NumberTheory.FirstNumber}" TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                <Border Padding="12,6" BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeShape="RoundRectangle 12">
                                    <Entry x:Name="FirstEntry" Text="48" Keyboard="Numeric" FontSize="20" MinimumHeightRequest="{DynamicResource Density.ControlHeight}"
                                           MaxLength="129" BackgroundColor="Transparent" TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Next"
                                           Completed="OnFirstCompleted" TextChanged="OnInputChanged" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="SecondInput" Grid.Column="1" Spacing="6">
                                <Label Text="{localization:Translate NumberTheory.SecondNumber}" TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                                <Border Padding="12,6" BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}" StrokeShape="RoundRectangle 12">
                                    <Entry x:Name="SecondEntry" Text="18" Keyboard="Numeric" FontSize="20" MinimumHeightRequest="{DynamicResource Density.ControlHeight}"
                                           MaxLength="129" BackgroundColor="Transparent" TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Done"
                                           Completed="OnCalculateClicked" TextChanged="OnInputChanged" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Border x:Name="ErrorBorder" IsVisible="False" Padding="12" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource WallpaperDangerSoftColor}" Stroke="{DynamicResource DangerBorderBrush}">
                            <Label x:Name="ErrorLabel" TextColor="{DynamicResource ContentDangerTextColor}" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="ResultBorder" controls:SolverWorkspace.StartsResult="True" IsVisible="False" Style="{StaticResource SolverCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label x:Name="ResultTitle" Style="{StaticResource SolverSectionTitleStyle}" />
                        <Label x:Name="ResultLabel" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               LineBreakMode="CharacterWrap" TextColor="{DynamicResource ContentAccentTextColor}" />

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource WallpaperDividerColor}" />
                        <Label Text="{localization:Translate NumberTheory.SolutionTitle}" Style="{StaticResource SolverSectionTitleStyle}" />
                        <Grid x:Name="MethodsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="14" RowSpacing="14" SizeChanged="OnMethodsSizeChanged">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{localization:Translate NumberTheory.PrimeMethod}" FontSize="19" FontAttributes="Bold"
                                       TextColor="{DynamicResource ContentAccentTextColor}" />
                                <VerticalStackLayout x:Name="PrimeStepsLayout" Spacing="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="EuclidMethodPanel" Grid.Column="1" Spacing="12">
                                <Label Text="{localization:Translate NumberTheory.EuclidMethod}" FontSize="19" FontAttributes="Bold"
                                       TextColor="{DynamicResource ContentAccentTextColor}" />
                                <VerticalStackLayout x:Name="StepsLayout" Spacing="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Style="{StaticResource SolverActionBarStyle}">
            <Grid Style="{StaticResource SolverFooterActionButtonsStyle}" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{localization:Translate Actions.Calculate}" Style="{StaticResource SolverPrimaryActionStyle}" Clicked="OnCalculateClicked" />
                <Button Grid.Column="1" Text="{localization:Translate Actions.Clear}" Style="{StaticResource SolverSecondaryActionStyle}" BackgroundColor="{DynamicResource WallpaperDividerColor}" Clicked="OnClearClicked" />

                <Grid x:Name="CopyButtonFooter" AutomationId="SolverFooterCopy" IsVisible="{Binding Source={x:Reference ResultBorder}, Path=IsVisible, x:DataType='Border'}" MinimumHeightRequest="{DynamicResource Density.ControlHeight}">
                            <controls:ResultCopyButton x:Name="CopyButton" Clicked="OnCopyClicked" CornerRadius="12"
                                                       BackgroundColor="{DynamicResource WallpaperDividerColor}" />
                            <Grid InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Center" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,8">
                                <controls:ThemedCopyIcon WidthRequest="20" HeightRequest="20" />
                                <Label Grid.Column="1" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Text="{Binding DisplayText, Source={x:Reference CopyButton}, x:DataType='controls:ResultCopyButton'}"
                                       VerticalTextAlignment="Center" TextColor="{DynamicResource WallpaperTextPrimaryColor}" />
                            </Grid>
                        </Grid>
            </Grid>
        </Border>
    </Grid>
</base:LocalizedSolverView>
