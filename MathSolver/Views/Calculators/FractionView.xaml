<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.FractionView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:models="clr-namespace:MathSolver.Models"
    xmlns:views="clr-namespace:MathSolver.Views"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <!-- FractionView tự quản lý vùng cuộn.
         Không bọc thêm ScrollView tại CalculationPage. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Style="{StaticResource SolverFixedHeaderStyle}" controls:SolverHeader.CompactTitle="{localization:Translate Solver.Compact.Fraction}">
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    Text="½  + − × ÷"
                    Style="{StaticResource SolverHeroSymbolStyle}" />

                <Label
                    x:Name="FractionPageTitle"
                    Text="PHÉP TÍNH PHÂN SỐ"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    x:Name="FractionPageSubtitle"
                    Text="Cộng • Trừ • Nhân • Chia • Quy đồng"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1"
            controls:SolverWorkspace.IsEnabled="True"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <VerticalStackLayout
                x:Name="FractionContent"
                Style="{StaticResource SolverScrollableContentStyle}">

                <!-- Tiêu đề đồng bộ với tab Cơ bản -->

                <!-- 1. Chọn phép tính -->
                <Border
                    Style="{StaticResource SolverCardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="1. Chọn phép tính"
                            Style="{StaticResource SolverSectionTitleStyle}" />

                        <Grid
                            x:Name="OperationButtonsGrid"
                            SizeChanged="OnFractionInputsSizeChanged"
                            ColumnDefinitions="{OnPlatform Android='*,*,*,*', WinUI='*,*,*,*,1.35*', Default='*,*,*,*,1.35*'}"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="8">

                            <Button
                                x:Name="AddButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="+"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                Clicked="OnAddClicked" />

                            <Button
                                x:Name="SubtractButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="−"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                Clicked="OnSubtractClicked" />

                            <Button
                                x:Name="MultiplyButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Text="×"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                Clicked="OnMultiplyClicked" />

                            <Button
                                x:Name="DivideButton"
                                Grid.Row="0"
                                Grid.Column="3"
                                Text="÷"
                                Style="{StaticResource SolverOperationButtonStyle}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                Clicked="OnDivideClicked" />

                            <Button
                                x:Name="CommonDenominatorButton"
                                Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                Grid.Column="{OnPlatform Android=0, WinUI=4, Default=4}"
                                Grid.ColumnSpan="{OnPlatform Android=2, WinUI=1, Default=1}"
                                Text="Quy đồng"
                                FontSize="16"
                                FontAttributes="Bold"
                                MinimumHeightRequest="{DynamicResource Density.ControlHeight}"
                                Padding="10,0"
                                CornerRadius="12"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                Clicked="OnCommonDenominatorClicked" />

                            <Button x:Name="FractionExpressionButton" Grid.Row="1"
                                    Grid.Column="{OnPlatform Android=2, Default=0}"
                                    Grid.ColumnSpan="{OnPlatform Android=2, Default=5}"
                                    Text="{localization:Translate Calculation.Expression.Option}"
                                    Style="{StaticResource SolverOperationButtonStyle}"
                                    FontSize="16" Clicked="OnFractionExpressionClicked" />

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- 2. Nhập hai phân số -->
                <Border Style="{StaticResource SolverCardStyle}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            x:Name="FractionInputTitleLabel" Text="2. Nhập các phân số"
                            Style="{StaticResource SolverSectionTitleStyle}" />

                        <Label x:Name="FractionExpressionInputTitleLabel" IsVisible="False"
                               Text="{localization:Translate Fraction.Expression.InputTitle}"
                               Style="{StaticResource SolverSectionTitleStyle}" />

                        <Grid
                            x:Name="FractionInputGrid"
                            ColumnDefinitions="{OnPlatform Android='*', WinUI='*,64,*', Default='*,64,*'}"
                            RowDefinitions="{OnPlatform Android='Auto,Auto,Auto', WinUI='Auto', Default='Auto'}"
                            ColumnSpacing="12"
                            RowSpacing="8">

                            <!-- Phân số thứ nhất -->
                            <Border
                                x:Name="FirstFractionCard"
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="{OnPlatform Android=10, WinUI=12, Default=12}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                StrokeThickness="1"
                                VerticalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="Phân số thứ nhất"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Border
                                        HeightRequest="{DynamicResource Density.InputFrameHeight}"
                                        Padding="10,0"
                                        BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <Entry
                                            x:Name="FirstNumeratorEntry"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                            Placeholder="Tử số"
                                            Keyboard="Numeric"
                                            FontSize="19"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            TextChanged="OnNumberEntryTextChanged" />
                                    </Border>

                                    <BoxView
                                        HeightRequest="2"
                                        Margin="8,1"
                                        BackgroundColor="{DynamicResource PrimaryColor}" />

                                    <Border
                                        HeightRequest="{DynamicResource Density.InputFrameHeight}"
                                        Padding="10,0"
                                        BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <Entry
                                            x:Name="FirstDenominatorEntry"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                            Placeholder="Mẫu số"
                                            Keyboard="Numeric"
                                            FontSize="19"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            TextChanged="OnNumberEntryTextChanged" />
                                    </Border>

                                </VerticalStackLayout>
                            </Border>

                            <!-- Dấu phép tính -->
                            <Label
                                x:Name="OperatorLabel"
                                Grid.Row="{OnPlatform Android=1, WinUI=0, Default=0}"
                                Grid.Column="{OnPlatform Android=0, WinUI=1, Default=1}"
                                HeightRequest="{OnPlatform Android=36, WinUI=-1, Default=-1}"
                                Text="+"
                                FontSize="32"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                TextColor="{DynamicResource ContentAccentTextColor}" />

                            <!-- Phân số thứ hai -->
                            <Border
                                x:Name="SecondFractionCard"
                                Grid.Row="{OnPlatform Android=2, WinUI=0, Default=0}"
                                Grid.Column="{OnPlatform Android=0, WinUI=2, Default=2}"
                                Padding="{OnPlatform Android=10, WinUI=12, Default=12}"
                                BackgroundColor="{DynamicResource WallpaperSurfaceAltColor}"
                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                StrokeThickness="1"
                                VerticalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="Phân số thứ hai"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                                    <Border
                                        HeightRequest="{DynamicResource Density.InputFrameHeight}"
                                        Padding="10,0"
                                        BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <Entry
                                            x:Name="SecondNumeratorEntry"
                                            Placeholder="Tử số"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                            Keyboard="Numeric"
                                            FontSize="19"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            TextChanged="OnNumberEntryTextChanged" />
                                    </Border>

                                    <BoxView
                                        HeightRequest="2"
                                        Margin="8,1"
                                        BackgroundColor="{DynamicResource PrimaryColor}" />

                                    <Border
                                        HeightRequest="{DynamicResource Density.InputFrameHeight}"
                                        Padding="10,0"
                                        BackgroundColor="{DynamicResource WallpaperInputBackgroundColor}"
                                        Stroke="{DynamicResource WallpaperBorderBrush}"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>

                                        <Entry
                                            x:Name="SecondDenominatorEntry"
                                            PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                            Placeholder="Mẫu số"
                                            Keyboard="Numeric"
                                            FontSize="19"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            BackgroundColor="Transparent"
                                            TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                            TextChanged="OnNumberEntryTextChanged" />
                                    </Border>

                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <VerticalStackLayout x:Name="FractionExpressionInputPanel" IsVisible="False" Spacing="10">
                            <Label Text="{localization:Translate Fraction.Expression.InputHelp}"
                                   LineBreakMode="WordWrap" TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                            <Border Style="{StaticResource SolverInputBorderStyle}" Padding="12,8">
                                <Editor x:Name="FractionExpressionEditor" AutoSize="TextChanges"
                                        MinimumHeightRequest="132" MaxLength="4096" FontSize="19"
                                        IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                        Placeholder="{localization:Translate Fraction.Expression.Placeholder}"
                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                        PlaceholderColor="{DynamicResource WallpaperTextSecondaryColor}"
                                        BackgroundColor="Transparent" TextChanged="OnFractionExpressionTextChanged" />
                            </Border>
                            <Label Text="{localization:Translate Fraction.Expression.PriorityHint}"
                                   LineBreakMode="WordWrap" TextColor="{DynamicResource WallpaperTextSecondaryColor}" />
                            <controls:FractionExpressionView x:Name="FractionExpressionPreview" IsVisible="False"
                                ParseArithmeticExpressions="True" WrapContent="True" MathFontSize="22"
                                MathColor="{DynamicResource WallpaperTextPrimaryColor}" />
                        </VerticalStackLayout>


                    </VerticalStackLayout>
                </Border>

                <!-- Thông báo lỗi, tách riêng giống CalculationPage -->
                <Border
                    x:Name="ErrorBorder"
                    IsVisible="False"
                    Padding="14"
                    BackgroundColor="{DynamicResource WallpaperDangerSoftColor}"
                    Stroke="{DynamicResource DangerBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                        <Label
                        Grid.Column="0"
                        Text="❌"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource ContentDangerTextColor}" />

                        <Label
                        Grid.Column="1"
                        x:Name="ErrorLabel"
                        FontSize="17"
                        TextColor="{DynamicResource ContentDangerTextColor}"
                        LineBreakMode="WordWrap" />

                    </Grid>
                </Border>

                <!-- 3. Kết quả -->
                <Border
                    x:Name="ResultBorder"
                    controls:SolverWorkspace.StartsResult="True"
                    IsVisible="False"
                    Padding="14"
                    BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                    Stroke="{DynamicResource WallpaperPrimaryBorderBrush}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="3. Kết quả"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WallpaperTextPrimaryColor}" />

                        <controls:FractionExpressionView
                            x:Name="FullExpressionMathView"
                            WrapContent="True"
                            MathFontSize="23"
                            MathColor="{DynamicResource ContentAccentTextColor}"
                            HorizontalOptions="Center" />

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource WallpaperDividerColor}" />

                        <Label
                            Text="Đáp số"
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            TextColor="{DynamicResource WallpaperTextSecondaryColor}" />

                        <controls:FractionExpressionView
                            x:Name="AnswerMathView"
                            WrapContent="True"
                            MathFontSize="32"
                            MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                            HorizontalOptions="Center" />



                        <!-- Lời giải chi tiết -->
                        <Border
                            Padding="14"
                            BackgroundColor="{DynamicResource WallpaperPrimarySoftColor}"
                            Stroke="{DynamicResource PrimarySoftBrush}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="12">

                                <Label
                                    Text="Lời giải"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource PrimaryDarkColor}" />

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding Source={x:Reference Root}, Path=SolutionSteps, x:DataType={x:Type views:FractionView}}"
                                    Spacing="10">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:FractionSolutionStep">

                                            <Border
                                                Padding="12"
                                                BackgroundColor="{DynamicResource WallpaperSurfaceColor}"
                                                Stroke="{DynamicResource WallpaperBorderBrush}"
                                                StrokeThickness="1">

                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>

                                                <VerticalStackLayout Spacing="8">

                                                    <Label
                                                        Text="{Binding Title}"
                                                        FontSize="17"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource ContentAccentTextColor}" />

                                                    <Label
                                                        Text="{Binding Description}"
                                                        FontSize="16"
                                                        LineHeight="1.25"
                                                        LineBreakMode="WordWrap"
                                                        TextColor="{DynamicResource WallpaperTextPrimaryColor}">

                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                TargetType="Label"
                                                                Binding="{Binding Description}"
                                                                Value="">
                                                                <Setter
                                                                    Property="IsVisible"
                                                                    Value="False" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>

                                                    <VerticalStackLayout
                                                        BindableLayout.ItemsSource="{Binding MathLines}"
                                                        Spacing="8">

                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <controls:FractionExpressionView
                                                                    Expression="{Binding .}"
                                                                    ParseArithmeticExpressions="{Binding Source={x:Reference Root}, Path=IsExpressionMode, x:DataType='views:FractionView'}"
                                                                    WrapContent="True"
                                                                    MathFontSize="19"
                                                                    MathColor="{DynamicResource WallpaperTextPrimaryColor}"
                                                                    HorizontalOptions="Start" />
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                </VerticalStackLayout>
                                            </Border>

                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>
    </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Style="{StaticResource SolverActionBarStyle}">
            <Grid Style="{StaticResource SolverFooterActionButtonsStyle}"
                x:Name="ActionButtonsGrid"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto"
                ColumnSpacing="10"
                RowSpacing="8">

                <Button
                    x:Name="CalculateButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{localization:Translate Actions.Calculate}"
                    Style="{StaticResource SolverPrimaryActionStyle}"
                    Clicked="OnCalculateClicked" />

                <Button
                    x:Name="ClearButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{localization:Translate Actions.Clear}"
                    Style="{StaticResource SolverSecondaryActionStyle}"
                    BackgroundColor="{DynamicResource WallpaperDividerColor}"
                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                    Clicked="OnClearClicked" />


                <Grid x:Name="FractionCopyResultButtonFooter" AutomationId="SolverFooterCopy" IsVisible="{Binding Source={x:Reference ResultBorder}, Path=IsVisible, x:DataType='Border'}" MinimumHeightRequest="{DynamicResource Density.ControlHeight}">

                            <controls:ResultCopyButton
                                x:Name="FractionCopyResultButton"
                                NormalTextKey="PowerRoot.CopyResult"
                                Text=""
                                MinimumHeightRequest="{DynamicResource Density.ControlHeight}"
                                CornerRadius="12"
                                FontSize="15"
                                FontAttributes="Bold"
                                BackgroundColor="{DynamicResource WallpaperDividerColor}"
                                Clicked="OnFractionCopyResultClicked" />

                            <Grid
                                InputTransparent="True"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,8">

                                <controls:ThemedCopyIcon
                                    WidthRequest="20"
                                    HeightRequest="20" />

                                <Label Grid.Column="1" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                    Text="{Binding DisplayText, Source={x:Reference FractionCopyResultButton}, x:DataType='controls:ResultCopyButton'}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource WallpaperTextPrimaryColor}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                        </Grid>
            </Grid>
        </Border>
    </Grid>
</base:LocalizedSolverView>
