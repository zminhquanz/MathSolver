<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathSolver.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="{DynamicResource ShellBackgroundColor}">

    <Grid BackgroundColor="#2563EB">
        <Image
            x:Name="SplashBrandLogo"
            AutomationId="SplashBrandLogo"
            Source="mathsolver_logo_light.png"
            WidthRequest="256"
            HeightRequest="256"
            Aspect="AspectFit"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>

</ContentPage>