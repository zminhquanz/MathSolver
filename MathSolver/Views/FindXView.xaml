<?xml version="1.0" encoding="utf-8" ?>

<base:LocalizedSolverView
    x:Class="MathSolver.Views.FindXView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:MathSolver.MarkupExtensions"
    xmlns:base="clr-namespace:MathSolver.Views.Base"
    xmlns:controls="clr-namespace:MathSolver.Controls"
    BackgroundColor="Transparent"
    HorizontalOptions="Fill">

    <ScrollView
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <VerticalStackLayout
            x:Name="FindXContent"
            Style="{StaticResource SolverContentStyle}">
            <!-- Tiêu đề -->
            <VerticalStackLayout
                Style="{StaticResource SolverHeroStyle}">

                <Label
                    x:Name="FindXHeroLabel"
                    Text="𝑥 = ?"
                    Style="{StaticResource SolverHeroSymbolStyle}" />

                <Label
                    x:Name="FindXPageTitle"
                    Text="TÌM THÀNH PHẦN CHƯA BIẾT"
                    Style="{StaticResource SolverHeroTitleStyle}" />

                <Label
                    x:Name="FindXPageSubtitle"
                    Text="Số hạng • Số bị trừ • Số trừ • Thừa số • Số bị chia • Số chia"
                    Style="{StaticResource SolverHeroSubtitleStyle}" />

            </VerticalStackLayout>

            <!-- 1. Chọn phép tính và vị trí của x -->
            <Border
                Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="1. Chọn phép tính"
                        Style="{StaticResource SolverSectionTitleStyle}" />

                    <Grid
                        Style="{StaticResource SolverCardStyle}"
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="8">

                        <Button
                            x:Name="FindXAddButton"
                            Grid.Column="0"
                            Text="+"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnFindXAddClicked" />

                        <Button
                            x:Name="FindXSubtractButton"
                            Grid.Column="1"
                            Text="−"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnFindXSubtractClicked" />

                        <Button
                            x:Name="FindXMultiplyButton"
                            Grid.Column="2"
                            Text="×"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnFindXMultiplyClicked" />

                        <Button
                            x:Name="FindXDivideButton"
                            Grid.Column="3"
                            Text="÷"
                            Style="{StaticResource SolverOperationButtonStyle}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnFindXDivideClicked" />

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Margin="0,2"
                        BackgroundColor="{DynamicResource DividerColor}" />

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Vị trí của x"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimaryColor}" />

                        <Label
                            x:Name="FindXPositionDescriptionLabel"
                            FontSize="15"
                            LineHeight="1.2"
                            TextColor="{DynamicResource TextSecondaryColor}" />

                    </VerticalStackLayout>

                    <Grid
                        Style="{StaticResource SolverCardStyle}"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="FindXUnknownLeftButton"
                            Grid.Column="0"
                            Text="x + a = b"
                            HeightRequest="48"
                            Padding="8,0"
                            FontSize="19"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            Clicked="OnFindXUnknownLeftClicked" />

                        <Button
                            x:Name="FindXUnknownRightButton"
                            Grid.Column="1"
                            Text="a + x = b"
                            HeightRequest="48"
                            Padding="8,0"
                            FontSize="19"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            Clicked="OnFindXUnknownRightClicked" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Loại số và dữ liệu -->
            <Border Style="{StaticResource SolverCardStyle}">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="2. Nhập các giá trị đã biết"
                        Style="{StaticResource SolverSectionTitleStyle}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            x:Name="FindXIntegerTypeButton"
                            Grid.Column="0"
                            Text="{localization:Translate Numbers.Integer}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnFindXIntegerTypeClicked" />

                        <Button
                            x:Name="FindXDecimalTypeButton"
                            Grid.Column="1"
                            Text="{localization:Translate Numbers.Decimal}"
                            BackgroundColor="{DynamicResource SurfaceAltColor}"
                            Style="{StaticResource SolverChoiceButtonStyle}"
                            TextColor="{DynamicResource TextPrimaryColor}"
                            Clicked="OnFindXDecimalTypeClicked" />

                    </Grid>


                    <Grid
                        x:Name="FindXValueInputGrid"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto"
                        ColumnSpacing="12"
                        RowSpacing="10">

                        <VerticalStackLayout
                            x:Name="FindXKnownInputPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="6">

                            <Label
                                x:Name="FindXKnownValueLabel"
                                Text="Số hạng đã biết"
                                FontSize="16"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Border
                                HeightRequest="48"
                                Padding="10,0"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    x:Name="FindXKnownValueEntry"
                                    Placeholder="Ví dụ: 8"
                                    PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                    Keyboard="Numeric"
                                    FontSize="19"
                                    VerticalTextAlignment="Center"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    ClearButtonVisibility="WhileEditing"
                                    TextChanged="OnFindXNumberEntryTextChanged" />

                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="FindXResultInputPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="6">

                            <Label
                                x:Name="FindXResultValueLabel"
                                Text="Tổng"
                                FontSize="16"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Border
                                HeightRequest="48"
                                Padding="10,0"
                                BackgroundColor="{DynamicResource SurfaceAltColor}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    x:Name="FindXResultValueEntry"
                                    Placeholder="Ví dụ: 20"

                                    PlaceholderColor="{DynamicResource TextPrimaryColor}"
                                    Keyboard="Numeric"
                                    FontSize="19"
                                    VerticalTextAlignment="Center"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    ClearButtonVisibility="WhileEditing"
                                    TextChanged="OnFindXNumberEntryTextChanged" />

                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Xem trước phương trình -->
                    <Border
                        Padding="14"
                        MinimumHeightRequest="82"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource DividerBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Phương trình đang nhập"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                            <Label
                                x:Name="FindXEquationPreviewLabel"
                                Text="x + a = b"
                                FontSize="23"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource PrimaryColor}" />

                        </VerticalStackLayout>
                    </Border>

                    <Grid
                        Margin="0,4,0,0"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Text="{localization:Translate FindX.Action}"
                            Style="{StaticResource SolverPrimaryActionStyle}"
                            Clicked="OnFindXCalculateClicked" />

                        <Button
                            Grid.Column="1"
                            Text="{localization:Translate Actions.Clear}"
                            Style="{StaticResource SolverSecondaryActionStyle}"
                            BackgroundColor="{DynamicResource DividerColor}"
                            Clicked="OnFindXClearClicked" />

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Thông báo lỗi riêng của tab tìm x -->
            <Border
                x:Name="FindXErrorBorder"
                IsVisible="False"
                Padding="14"
                BackgroundColor="{DynamicResource DangerSoftColor}"
                Stroke="{DynamicResource DangerBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="❌"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource DangerColor}" />

                    <Label
                        x:Name="FindXErrorLabel"
                        Grid.Column="1"
                        FontSize="17"
                        LineHeight="1.2"
                        TextColor="{DynamicResource DangerColor}" />

                </Grid>
            </Border>

            <!-- Kết quả và lời giải -->
            <Border
                x:Name="FindXResultBorder"
                IsVisible="False"
                Padding="16"
                BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource PrimaryBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="3. Kết quả"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimaryColor}" />

                    <Label
                        x:Name="FindXResultEquationLabel"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="{DynamicResource PrimaryColor}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                x:Name="FindXStatusLabel"
                                Text="Nghiệm duy nhất"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource SuccessColor}" />

                            <Label
                                x:Name="FindXAnswerLabel"
                                Text="x = 0"
                                FontSize="34"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="FindXApproximationLabel"
                                IsVisible="False"
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                TextColor="{DynamicResource TextSecondaryColor}" />

                        </VerticalStackLayout>
                    </Border>

                    <Grid HeightRequest="48">

                        <Button
                            x:Name="FindXCopyResultButton"
                            Text="{localization:Translate PowerRoot.CopyResult}"
                            HeightRequest="48"
                            CornerRadius="12"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="{DynamicResource DividerColor}"
                            TextColor="Transparent"
                            Clicked="OnFindXCopyResultClicked" />

                        <HorizontalStackLayout
                            InputTransparent="True"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">

                            <controls:ThemedCopyIcon
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="{Binding Text, Source={x:Reference FindXCopyResultButton}}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>

                    </Grid>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource PrimarySoftColor}"
                        Stroke="{DynamicResource PrimarySoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="Quy tắc áp dụng"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource PrimaryDarkColor}" />

                            <Label
                                x:Name="FindXRuleLabel"
                                FontSize="17"
                                LineHeight="1.25"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Padding="14"
                        BackgroundColor="{DynamicResource SurfaceAltColor}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="Lời giải chi tiết"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                            <Label
                                x:Name="FindXSolutionStepsLabel"
                                FontSize="17"
                                LineHeight="1.3"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>
                    </Border>

                    <Border
                        x:Name="FindXVerificationBorder"
                        Padding="14"
                        BackgroundColor="{DynamicResource SuccessSoftColor}"
                        Stroke="{DynamicResource SuccessSoftBrush}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="Kiểm tra lại"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}" />

                            <Label
                                x:Name="FindXVerificationLabel"
                                FontSize="17"
                                LineHeight="1.25"
                                TextColor="{DynamicResource TextPrimaryColor}" />

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Hướng dẫn -->
            <Border
                Padding="14"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10">

                    <Label
                        Grid.Column="0"
                        Text="💡"
                        FontSize="24"
                        VerticalOptions="Start" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4">

                        <Label
                            Text="Ghi nhớ"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Sau khi tìm được x, ứng dụng luôn thay x trở lại phép tính ban đầu để kiểm tra. Nếu phép chia có x ở mẫu số thì x phải khác 0."
                            FontSize="16"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Lưu ý khi sử dụng -->
            <Border
                Padding="16"
                BackgroundColor="{DynamicResource WarningSoftColor}"
                Stroke="{DynamicResource WarningBorderBrush}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="⚠"
                        FontSize="26"
                        VerticalOptions="Start"
                        TextColor="{DynamicResource WarningColor}" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Lưu ý khi sử dụng"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Phần mềm được tạo ra nhằm hỗ trợ học tập, kiểm tra kết quả và giúp người học hiểu cách thực hiện phép tính, lời giải. Không nên lạm dụng phần mềm để làm thay toàn bộ bài tập hoặc sao chép kết quả mà không tự suy nghĩ."
                            FontSize="16"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                        <Label
                            Text="Hãy tự làm bài trước, sau đó sử dụng phần mềm để kiểm tra và tìm hiểu những bước mình chưa hiểu."
                            FontSize="16"
                            FontAttributes="Italic"
                            LineHeight="1.25"
                            TextColor="{DynamicResource WarningColor}" />

                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</base:LocalizedSolverView>
