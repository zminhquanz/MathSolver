<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultMauiItems>false</EnableDefaultMauiItems>
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <MauiXaml Remove="App.xaml" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <Compile Include="../../MathSolver/Controls/Interaction/InteractiveColorFeedback.cs" Link="InteractiveColorFeedback.cs" />
    <Compile Include="../../MathSolver/Services/Appearance/InteractionColorPalette.cs" Link="InteractionColorPalette.cs" />
    <None Include="../../MathSolver/Resources/Styles/SolverStyles.xaml" Link="SolverStyles.source.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Graphics" />
  </ItemGroup>
</Project>
