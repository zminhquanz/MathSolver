<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../MathSolver/Resources/Raw/QuizContent/*.json" LogicalName="QuizContent.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../MathSolver/Resources/Raw/Localization/vi-VN.json" LogicalName="QuizLocalization.vi-VN.json" />
    <EmbeddedResource Include="../../MathSolver/Resources/Raw/Localization/en-US.json" LogicalName="QuizLocalization.en-US.json" />
    <EmbeddedResource Include="../../MathSolver/Views/Quizzes/MathPuzzlePage.xaml" LogicalName="QuizLocalization.MathPuzzlePage.xaml" />
    <EmbeddedResource Include="../../MathSolver/Views/Quizzes/MathPuzzlePage.xaml.cs" LogicalName="QuizLocalization.MathPuzzlePage.xaml.cs" />
    <EmbeddedResource Include="../../MathSolver/Views/Quizzes/MathPuzzlePage.Diagrams.cs" LogicalName="QuizLocalization.MathPuzzlePage.Diagrams.cs" />
    <EmbeddedResource Include="../../MathSolver/Views/Quizzes/MathPuzzlePage.Layout.cs" LogicalName="QuizLocalization.MathPuzzlePage.Layout.cs" />
    <Compile Include="../../MathSolver/Services/Memory/ResultFileStore.cs" Link="Services/Memory/ResultFileStore.cs" />
    <Compile Include="../../MathSolver/Views/Calculators/PowerRootView.Memory.cs" Link="Views/PowerRootView.Memory.cs" />
    <Compile Include="../../MathSolver/Services/Memory/RecoverableMemoryRegistry.cs" Link="Services/Memory/RecoverableMemoryRegistry.cs" />
    <Compile Include="../../MathSolver/Models/Arithmetic/*.cs" Link="Models/Arithmetic/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Models/Fractions/*.cs" Link="Models/Fractions/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Models/Formulas/GeometryCalculation.cs" Link="Models/Formulas/GeometryCalculation.cs" />
    <Compile Include="../../MathSolver/Models/Quizzes/*.cs" Link="Models/Quizzes/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/*.cs" Link="Numerics/BigIntegers/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Numerics/Powers/*.cs" Link="Numerics/Powers/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Numerics/FloatingPoint/*.cs" Link="Numerics/FloatingPoint/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Numerics/Serialization/*.cs" Link="Numerics/Serialization/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Services/Calculations/*.cs" Link="Services/Calculations/%(Filename)%(Extension)" />
    <Compile Include="../../MathSolver/Services/Localization/QuizLocalizationOverrides.cs" Link="Services/Localization/QuizLocalizationOverrides.cs" />
    <Compile Include="../../MathSolver/Services/Formatting/RationalDecimalFormatter.cs" Link="Services/Formatting/RationalDecimalFormatter.cs" />
    <Compile Include="../../MathSolver/Services/Formatting/TextbookFractionParser.cs" Link="Services/Formatting/TextbookFractionParser.cs" />
    <Compile Include="../../MathSolver/Services/Formatting/AccessibleMathText.cs" Link="Services/Formatting/AccessibleMathText.cs" />
    <Compile Include="../../MathSolver/Services/Quizzes/*.cs" Link="Services/Quizzes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
