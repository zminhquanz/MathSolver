<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AuditSource Condition="'$(AuditSource)' == ''">../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned.cs</AuditSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AuditSource)" Link="ParallelBigUnsigned.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/*.cs" Exclude="../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned.cs" />
    <Compile Include="../../MathSolver/Numerics/Powers/*.cs" />
    <Compile Include="../../MathSolver/Numerics/Serialization/*.cs" />
    <Compile Include="../../MathSolver/Services/Performance/CalculationAccelerationManager.cs" />
    <Compile Include="../../MathSolver/Services/Performance/PhysicalMemoryInfo.cs" />
    <Compile Include="../../MathSolver/Services/Performance/NttPowerMemoryGuard.cs" />
  </ItemGroup>
</Project>
