<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
      <ApplicationId>com.mathsolver.neonvalidation</ApplicationId>
    <ApplicationTitle>NTT NEON Validation</ApplicationTitle>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <UseInterpreter>false</UseInterpreter><AndroidUseInterpreter>false</AndroidUseInterpreter>
    <UseMonoRuntime>true</UseMonoRuntime><Optimize>true</Optimize>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <DebugSymbols>true</DebugSymbols><DebugType>portable</DebugType>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);MATHSOLVER_ANDROID_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SseNttValidation/Stubs.cs" Link="Stubs.cs" />
    <Compile Include="../../MathSolver/Platforms/Android/AndroidCpuInfo.cs" Link="AndroidCpuInfo.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned_Neon.cs" Link="ParallelBigUnsigned_Neon.cs" />
    <Compile Include="../../MathSolver/Services/Performance/PhysicalMemoryInfo.cs" Link="PhysicalMemoryInfo.cs" />
    <Compile Include="../../MathSolver/Services/Performance/NttPowerMemoryGuard.cs" Link="NttPowerMemoryGuard.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/BinaryRadix16.cs" Link="BinaryRadix16.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned.cs" Link="ParallelBigUnsigned.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned_BinaryPower.cs" Link="ParallelBigUnsigned_BinaryPower.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/LargeBinaryUnsigned.cs" Link="LargeBinaryUnsigned.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/LimbKaratsuba.cs" Link="LimbKaratsuba.cs" />
    <Compile Include="../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned_BinaryImport.cs" Link="ParallelBigUnsigned_BinaryImport.cs" />
    <Compile Include="../../MathSolver/Numerics/Powers/PowerOfTenArithmetic.cs" Link="PowerOfTenArithmetic.cs" />
    <Compile Include="../../MathSolver/Numerics/Serialization/BigIntegerDecimalWriter.cs" Link="BigIntegerDecimalWriter.cs" />
<Compile Include="../../MathSolver/Numerics/Powers/SingleThreadBigIntegerPower.cs" Link="SingleThreadBigIntegerPower.cs" />
    <Compile Include="../../MathSolver/Numerics/FloatingPoint/DoubleDouble.cs" Link="DoubleDouble.cs" />
    <Compile Include="../../MathSolver/Services/Calculations/PowerRootEngine.cs" Link="PowerRootEngine.cs" />
      <Compile Include="../../MathSolver/Numerics/BigIntegers/ParallelBigUnsigned_Sse.cs" Link="ParallelBigUnsigned_Sse.cs" />
    <Compile Include="../../MathSolver/Services/Performance/CalculationAccelerationManager.cs" />
  </ItemGroup>
</Project>
